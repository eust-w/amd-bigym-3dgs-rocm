@@ -0,0 +1,80 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from d.replay_generation.prepare_infinigen_visual_shell_profile import (
+    prepare_profile,
+)
+
+
+def _source(tmp_path: Path) -> tuple[Path, Path]:
+    ply = tmp_path / "source" / "scene.ply"
+    ply.parent.mkdir()
+    ply.write_bytes(b"ply\nend_header\nscene")
+    digest = hashlib.sha256(ply.read_bytes()).hexdigest()
+    profile = {
+        "schema_version": 2,
+        "asset": {
+            "path": ply.name,
+            "bytes": ply.stat().st_size,
+            "sha256": digest,
+            "single_ply": True,
+            "format": "Graphdeco SH3",
+        },
+        "alignment": {
+            "source_to_mujoco": [
+                [1, 0, 0, -1],
+                [0, 1, 0, -2],
+                [0, 0, 1, -0.1],
+                [0, 0, 0, 1],
+            ]
+        },
+        "free_view_contract": {
+            "safe_space_obb": {"min": [0, 1, 0.4], "max": [2, 3, 2.3]}
+        },
+        "central_cleanup": {
+            "clear_obb": {"min": [0, 1, 0.1], "max": [2, 3, 2.5]}
+        },
+        "quality": {"training": {"psnr": 34.0}},
+        "provenance": {"generator": "Infinigen"},
+    }
+    source_profile = ply.parent / "source-profile.json"
+    source_profile.write_text(json.dumps(profile), encoding="utf-8")
+    return source_profile, ply
+
+
+def test_prepare_infinigen_profile_uses_identity_and_transforms_contract(tmp_path) -> None:
+    source_profile, ply = _source(tmp_path)
+    output = tmp_path / "output"
+    profile_path = prepare_profile(source_profile, ply, output)
+    profile = json.loads(profile_path.read_text())
+    alignment = json.loads((output / "alignment.json").read_text())
+    assert np.array_equal(alignment["mujoco_to_gaussian"], np.eye(4))
+    assert alignment["double_transform_forbidden"] is True
+    assert profile["layer_files"] == {"combined": "scene.ply"}
+    assert profile["ground_visual"]["mode"] == "gaussian_combined"
+    assert profile["integration_contract"]["foreground_policy"] == "dynamic_only"
+    assert np.allclose(
+        profile["free_view_contract"]["safe_space_obb_mujoco"]["min"],
+        [-1.0, -1.0, 0.3],
+    )
+    assert np.allclose(
+        profile["free_view_contract"]["safe_space_obb_mujoco"]["max"],
+        [1.0, 1.0, 2.2],
+    )
+    assert (output / "scene.ply").is_symlink()
+    assert len(json.loads((output / "manifest.json").read_text())["files"]) == 3
+
+
+def test_prepare_infinigen_profile_rejects_asset_hash_mismatch(tmp_path) -> None:
+    source_profile, ply = _source(tmp_path)
+    payload = json.loads(source_profile.read_text())
+    payload["asset"]["sha256"] = "0" * 64
+    source_profile.write_text(json.dumps(payload))
+    with pytest.raises(ValueError, match="SHA-256"):
+        prepare_profile(source_profile, ply, tmp_path / "output")
