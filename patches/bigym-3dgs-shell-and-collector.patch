+from __future__ import annotations
+
+from d.replay_generation.write_blocked_four_camera_receipt import (
+    technical_status,
+)
+
+
+def test_receipt_reports_each_world_lock_and_physics_combination() -> None:
+    assert (
+        technical_status(
+            world_lock_passed=True,
+            physics_parity_passed=True,
+        )
+        == "world_lock_and_physics_passed"
+    )
+    assert (
+        technical_status(
+            world_lock_passed=False,
+            physics_parity_passed=True,
+        )
+        == "world_lock_failed_physics_passed"
+    )
+    assert (
+        technical_status(
+            world_lock_passed=True,
+            physics_parity_passed=False,
+        )
+        == "world_lock_passed_physics_failed"
+    )
+    assert (
+        technical_status(
+            world_lock_passed=False,
+            physics_parity_passed=False,
+        )
+        == "world_lock_and_physics_failed"
+    )
