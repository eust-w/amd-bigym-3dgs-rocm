@@ -0,0 +1,193 @@
+#!/usr/bin/env python3
+"""Prepare one verified Infinigen combined PLY for BiGym rendering."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+IDENTITY = np.eye(4, dtype=np.float64)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _transform_obb(obb: dict[str, Any], transform: np.ndarray) -> dict[str, list[float]]:
+    minimum = np.asarray(obb["min"], dtype=np.float64)
+    maximum = np.asarray(obb["max"], dtype=np.float64)
+    if minimum.shape != (3,) or maximum.shape != (3,) or np.any(maximum <= minimum):
+        raise ValueError("invalid source OBB")
+    corners = np.asarray(
+        [
+            [x, y, z, 1.0]
+            for x in (minimum[0], maximum[0])
+            for y in (minimum[1], maximum[1])
+            for z in (minimum[2], maximum[2])
+        ],
+        dtype=np.float64,
+    )
+    target = corners @ transform.T
+    if not np.isfinite(target).all() or not np.allclose(target[:, 3], 1.0):
+        raise ValueError("source-to-MuJoCo OBB transform is invalid")
+    return {
+        "min": target[:, :3].min(axis=0).tolist(),
+        "max": target[:, :3].max(axis=0).tolist(),
+    }
+
+
+def prepare_profile(source_profile: Path, ply: Path, output_dir: Path) -> Path:
+    source_profile = source_profile.expanduser().resolve()
+    ply = ply.expanduser().resolve()
+    output_dir = output_dir.expanduser().resolve()
+    source = json.loads(source_profile.read_text(encoding="utf-8"))
+    asset = source.get("asset", {})
+    if asset.get("single_ply") is not True:
+        raise ValueError("source profile is not a single-Ply Infinigen asset")
+    actual_bytes = ply.stat().st_size
+    actual_sha256 = _sha256(ply)
+    if actual_bytes != int(asset.get("bytes", -1)):
+        raise ValueError("Infinigen PLY byte count does not match source profile")
+    if actual_sha256 != str(asset.get("sha256", "")).lower():
+        raise ValueError("Infinigen PLY SHA-256 does not match source profile")
+
+    source_alignment = source.get("alignment", {})
+    source_to_mujoco = np.asarray(
+        source_alignment.get("source_to_mujoco"), dtype=np.float64
+    )
+    if source_to_mujoco.shape != (4, 4):
+        raise ValueError("source profile lacks a 4x4 source_to_mujoco")
+    safe_source = source.get("free_view_contract", {}).get("safe_space_obb")
+    clear_source = source.get("central_cleanup", {}).get("clear_obb")
+    if not isinstance(safe_source, dict) or not isinstance(clear_source, dict):
+        raise ValueError("source profile lacks safe/clear OBB contracts")
+    safe_mujoco = _transform_obb(safe_source, source_to_mujoco)
+    clear_mujoco = _transform_obb(clear_source, source_to_mujoco)
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    target_ply = output_dir / ply.name
+    if target_ply.exists() or target_ply.is_symlink():
+        if target_ply.resolve() != ply:
+            raise FileExistsError(f"refusing to replace existing asset: {target_ply}")
+    else:
+        target_ply.symlink_to(ply)
+
+    alignment_payload = {
+        "schema_version": 1,
+        "status": "prealigned_mujoco_metric_identity_render_transform",
+        "gaussian_to_mujoco": IDENTITY.tolist(),
+        "mujoco_to_gaussian": IDENTITY.tolist(),
+        "scale": 1.0,
+        "floor_z_m": 0.0,
+        "prealigned_ply": True,
+        "provenance_source_to_mujoco": source_to_mujoco.tolist(),
+        "provenance_source_profile": str(source_profile),
+        "double_transform_forbidden": True,
+    }
+    alignment_path = output_dir / "alignment.json"
+    alignment_path.write_text(
+        json.dumps(alignment_payload, indent=2) + "\n", encoding="utf-8"
+    )
+
+    profile_payload = {
+        "schema_version": 3,
+        "name": "infinigen-kitchen-freeview-bigym-threecam-v1",
+        "status": "diagnostic_freeview_poc",
+        "source_kind": "infinigen",
+        "asset": {
+            "path": target_ply.name,
+            "bytes": actual_bytes,
+            "sha256": actual_sha256,
+            "format": asset.get("format"),
+            "single_ply": True,
+            "prealigned_mujoco_metric": True,
+        },
+        "layer_files": {"combined": target_ply.name},
+        "ground_visual": {"mode": "gaussian_combined", "z_m": 0.0},
+        "alignment": {
+            "path": alignment_path.name,
+            "sha256": _sha256(alignment_path),
+        },
+        "free_view_contract": {
+            **source.get("free_view_contract", {}),
+            "safe_space_obb_source": safe_source,
+            "safe_space_obb_mujoco": safe_mujoco,
+            "clear_obb_source": clear_source,
+            "clear_obb_mujoco": clear_mujoco,
+        },
+        "integration_contract": {
+            "camera_set": "bigym-plus-3",
+            "camera_names": ["head", "left_wrist", "right_wrist"],
+            "foreground_policy": "dynamic_only",
+            "native_background_geom_names": ["floor"],
+            "depth_semantics": "accumulated",
+            "formal_collection_failure_policy": "abort",
+            "external_camera": {"formal": False, "diagnostic_only": True},
+            "background_physics": {
+                "body_count": 0,
+                "geom_count": 0,
+                "collision_count": 0,
+            },
+        },
+        "quality": {
+            **source.get("quality", {}),
+            "status": "awaiting_visual_approval",
+            "formal_collection_allowed": False,
+        },
+        "provenance": {
+            **source.get("provenance", {}),
+            "source_profile": str(source_profile),
+            "source_profile_sha256": _sha256(source_profile),
+            "distribution": "internal competition prototype pending legal review",
+        },
+    }
+    profile_path = output_dir / "profile.json"
+    profile_path.write_text(
+        json.dumps(profile_payload, indent=2) + "\n", encoding="utf-8"
+    )
+    manifest = {
+        "schema_version": 1,
+        "files": [
+            {
+                "path": path.name,
+                "bytes": path.stat().st_size,
+                "sha256": _sha256(path),
+            }
+            for path in (profile_path, alignment_path, target_ply)
+        ],
+    }
+    (output_dir / "manifest.json").write_text(
+        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
+    )
+    return profile_path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter
+    )
+    parser.add_argument("--source-profile", type=Path, required=True)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    profile = prepare_profile(args.source_profile, args.ply, args.output_dir)
+    print(
+        json.dumps(
+            {"status": "prepared", "profile": str(profile)}, indent=2
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
