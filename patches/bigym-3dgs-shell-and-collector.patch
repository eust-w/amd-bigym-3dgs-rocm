+#!/usr/bin/env python3
+"""Create visual-only shell sink variants with the native floor on top."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+import numpy as np
+
+
+def parse_sink_values(value: str) -> list[float]:
+    result = sorted({float(item.strip()) for item in value.split(",")})
+    if not result or result[0] < 0.0:
+        raise argparse.ArgumentTypeError(
+            "sink centimeters must be a non-empty list of non-negative values"
+        )
+    return result
+
+
+def symlink_layers(
+    source_profile_path: Path,
+    profile: dict,
+    output_dir: Path,
+) -> None:
+    for filename in set(profile["layer_files"].values()):
+        source = (source_profile_path.parent / filename).resolve()
+        target = output_dir / filename
+        if target.exists() or target.is_symlink():
+            target.unlink()
+        os.symlink(source, target)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--output-root", type=Path, required=True)
+    parser.add_argument(
+        "--sink-centimeters",
+        type=parse_sink_values,
+        default=parse_sink_values("0,4,8,12,16,20"),
+    )
+    args = parser.parse_args()
+
+    source_profile_path = args.profile.resolve()
+    source_profile = json.loads(
+        source_profile_path.read_text(encoding="utf-8")
+    )
+    source_alignment_path = (
+        source_profile_path.parent / source_profile["alignment"]["path"]
+    )
+    source_alignment = json.loads(
+        source_alignment_path.read_text(encoding="utf-8")
+    )
+    source_transform = np.asarray(
+        source_alignment["gaussian_to_mujoco"],
+        dtype=np.float64,
+    )
+    args.output_root.mkdir(parents=True, exist_ok=True)
+    manifest = {
+        "schema_version": 1,
+        "source_profile": str(source_profile_path),
+        "source_alignment": str(source_alignment_path.resolve()),
+        "physical_floor_changed": False,
+        "native_floor_overlay": True,
+        "variants": [],
+    }
+    for native_floor_overlay in (True, False):
+        for sink_centimeters in args.sink_centimeters:
+            if not native_floor_overlay and sink_centimeters == 0.0:
+                continue
+            sink_meters = sink_centimeters / 100.0
+            floor_slug = (
+                "native-floor"
+                if native_floor_overlay
+                else "gaussian-floor"
+            )
+            slug = (
+                f"sink-{int(round(sink_centimeters)):02d}cm-{floor_slug}"
+            )
+            output_dir = args.output_root / slug
+            output_dir.mkdir(parents=True, exist_ok=True)
+            post_transform = np.eye(4, dtype=np.float64)
+            post_transform[2, 3] = -sink_meters
+            transform = post_transform @ source_transform
+            alignment = {
+                **source_alignment,
+                "gaussian_to_mujoco": transform.tolist(),
+                "mujoco_to_gaussian": np.linalg.inv(transform).tolist(),
+                "floor_occlusion_experiment": {
+                    "task": "DishwasherUnloadCutleryLong",
+                    "shell_sink_m": sink_meters,
+                    "native_floor_overlay": native_floor_overlay,
+                    "physical_floor_changed": False,
+                    "post_transform": post_transform.tolist(),
+                    "purpose": (
+                        "Compare shell sinking with and without the original "
+                        "MuJoCo blue checker floor overlay."
+                    ),
+                },
+            }
+            alignment_path = output_dir / "alignment.json"
+            alignment_path.write_text(
+                json.dumps(alignment, indent=2) + "\n",
+                encoding="utf-8",
+            )
+            profile = json.loads(json.dumps(source_profile))
+            profile["name"] = f"{source_profile['name']}-{slug}"
+            profile["description"] = (
+                f"{source_profile.get('description', '')} Gaussian shell "
+                f"sunk {sink_centimeters:g} cm; native floor overlay "
+                f"{'enabled' if native_floor_overlay else 'disabled'}."
+            ).strip()
+            profile["alignment"] = {"path": alignment_path.name}
+            if native_floor_overlay:
+                profile["ground_visual"] = {
+                    "mode": "gaussian",
+                    "native_floor_overlay": True,
+                    "native_floor_style": "original_blue_checker",
+                    "physical_floor_changed": False,
+                    "shell_sink_m": sink_meters,
+                }
+                integration_contract = profile.setdefault(
+                    "integration_contract",
+                    {},
+                )
+                # With no native background geom exclusions, the MuJoCo floor
+                # becomes part of the segmentation foreground overwrite.
+                integration_contract["native_background_geom_names"] = []
+                integration_contract["foreground_compositing"] = (
+                    "MuJoCo segmentation overwrites the visual shell for "
+                    "robot, table, props, task geometry, and original floor"
+                )
+            quality = profile.setdefault("quality", {})
+            quality["status"] = "diagnostic_camera_extrapolation"
+            quality["formal_collection_recommended"] = False
+            quality["awaiting_visual_approval"] = True
+            quality["floor_occlusion_experiment"] = {
+                "shell_sink_m": sink_meters,
+                "native_floor_overlay": native_floor_overlay,
+                "physical_floor_changed": False,
+            }
+            profile_path = output_dir / "profile.json"
+            profile_path.write_text(
+                json.dumps(profile, indent=2) + "\n",
+                encoding="utf-8",
+            )
+            symlink_layers(source_profile_path, profile, output_dir)
+            manifest["variants"].append(
+                {
+                    "name": slug,
+                    "sink_m": sink_meters,
+                    "native_floor_overlay": native_floor_overlay,
+                    "profile": str(profile_path.resolve()),
+                    "alignment": str(alignment_path.resolve()),
+                }
+            )
+    manifest_path = args.output_root / "floor-variants-manifest.json"
+    manifest_path.write_text(
+        json.dumps(manifest, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == "__main__":
+    main()
