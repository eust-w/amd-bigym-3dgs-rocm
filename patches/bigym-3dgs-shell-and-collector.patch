+    profile_path = output_dir / "profile.json"
+    profile_path.write_text(
+        json.dumps(profile, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    for filename in set(profile["layer_files"].values()):
+        source = (source_profile_path.parent / filename).resolve()
+        target = output_dir / filename
+        if target.exists() or target.is_symlink():
+            target.unlink()
+        os.symlink(source, target)
+    return profile_path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--scale", type=float, required=True)
+    parser.add_argument("--yaw-degrees", type=float, default=0.0)
+    parser.add_argument(
+        "--translation-xy-m",
+        type=float,
+        nargs=2,
+        default=(0.0, 0.0),
+        metavar=("X", "Y"),
+    )
+    parser.add_argument("--translation-z-m", type=float, default=0.0)
+    parser.add_argument(
+        "--anchor-xy-m",
+        type=float,
+        nargs=2,
+        default=(0.0, 0.0),
+        metavar=("X", "Y"),
+        help=(
+            "world-space pivot for scale and yaw; use the task workspace "
+            "center so the visible kitchen does not drift out of view"
+        ),
+    )
+    parser.add_argument("--floor-anchor-z-m", type=float, default=-0.04)
+    parser.add_argument(
+        "--foreground-policy",
+        choices=("all_except_background", "dynamic_only"),
+        default="all_except_background",
+    )
+    parser.add_argument(
+        "--candidate-depth-conflict",
+        type=float,
+        nargs=2,
+        action="append",
+        default=[],
+        metavar=("SCALE", "MAXIMUM_CONFLICT_FRACTION"),
+        help="record one measured scale candidate in the selection receipt",
+    )
+    parser.add_argument(
+        "--selection-reason",
+        default=(
+            "smallest tested scale that passed the depth-order gate at all "
+            "four sampled frames"
+        ),
+    )
+    parser.add_argument("--selected-background-laplacian", type=float)
+    args = parser.parse_args()
+    if not np.isfinite(args.scale) or args.scale <= 0.0:
+        parser.error("--scale must be positive and finite")
+    if not np.isfinite(
+        [
+            args.yaw_degrees,
+            *args.translation_xy_m,
+            args.translation_z_m,
+            *args.anchor_xy_m,
+            args.floor_anchor_z_m,
+        ]
+    ).all():
+        parser.error("transform arguments must be finite")
+    for scale, conflict in args.candidate_depth_conflict:
+        if (
+            not np.isfinite(scale)
+            or scale <= 0.0
+            or not np.isfinite(conflict)
+            or not 0.0 <= conflict <= 1.0
+        ):
+            parser.error("invalid --candidate-depth-conflict entry")
+    if (
+        args.selected_background_laplacian is not None
+        and (
+            not np.isfinite(args.selected_background_laplacian)
+            or args.selected_background_laplacian < 0.0
+        )
+    ):
+        parser.error("--selected-background-laplacian must be non-negative")
+    print(_write_profile(args))
+
+
+if __name__ == "__main__":
+    main()
