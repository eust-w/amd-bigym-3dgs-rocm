+#!/usr/bin/env python3
+"""Verify a pose-optimized LeRobot probe and build review media."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import av
+import cv2
+import numpy as np
+import pyarrow.parquet as pq
+
+
+DEFAULT_VIDEO_KEYS = (
+    "observation.images.cam_high",
+    "observation.images.cam_left_wrist",
+    "observation.images.cam_right_wrist",
+)
+DEFAULT_EXPECTED_RESOLUTIONS = ((848, 480), (640, 480), (640, 480))
+
+
+def file_record(path: Path) -> dict[str, object]:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(4 * 1024 * 1024):
+            digest.update(chunk)
+    return {
+        "path": str(path.resolve()),
+        "bytes": path.stat().st_size,
+        "sha256": digest.hexdigest(),
+    }
+
+
+def video_path(dataset_root: Path, key: str) -> Path:
+    return (
+        dataset_root
+        / "videos"
+        / key
+        / "chunk-000"
+        / "file-000.mp4"
+    )
+
+
+def labeled_frame(image: np.ndarray, label: str) -> np.ndarray:
+    result = image.copy()
+    cv2.rectangle(result, (0, 0), (result.shape[1], 32), (0, 0, 0), -1)
+    cv2.putText(
+        result,
+        label,
+        (10, 23),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        0.65,
+        (255, 255, 255),
+        1,
+        cv2.LINE_AA,
+    )
+    return result
+
+
+def combine_videos(
+    sources: list[Path],
+    labels: list[str],
+    expected_resolutions: list[tuple[int, int]],
+    output_video: Path,
+    contact_sheet: Path,
+    expected_frames: int,
+) -> list[dict[str, object]]:
+    inputs = [av.open(str(path)) for path in sources]
+    streams = [container.streams.video[0] for container in inputs]
+    reports = []
+    for path, stream, expected_resolution in zip(
+        sources,
+        streams,
+        expected_resolutions,
+        strict=True,
+    ):
+        resolution = (stream.codec_context.width, stream.codec_context.height)
+        if resolution != expected_resolution:
+            raise RuntimeError(
+                f"{path}: expected {expected_resolution}, found {resolution}"
+            )
+        reports.append(
+            {
+                **file_record(path),
+                "codec": stream.codec_context.name,
+                "width": resolution[0],
+                "height": resolution[1],
+                "fps": float(stream.average_rate),
+            }
+        )
+    output_video.parent.mkdir(parents=True, exist_ok=True)
+    output = av.open(str(output_video), mode="w")
+    output_stream = output.add_stream("libx264", rate=20)
+    output_stream.width = sum(width for width, _height in expected_resolutions)
+    output_stream.height = 480
+    output_stream.pix_fmt = "yuv420p"
+    output_stream.options = {"crf": "24", "preset": "medium"}
+    decoders = [container.decode(stream) for container, stream in zip(inputs, streams)]
+    sample_indices = np.linspace(0, expected_frames - 1, 9).round().astype(int)
+    samples: list[np.ndarray] = []
+    frame_count = 0
+    while True:
+        frames = [next(decoder, None) for decoder in decoders]
+        if all(frame is None for frame in frames):
+            break
+        if any(frame is None for frame in frames):
+            raise RuntimeError("camera videos have different frame counts")
+        arrays = [
+            labeled_frame(
+                frame.to_ndarray(format="rgb24"),
+                label,
+            )
+            for frame, label in zip(frames, labels, strict=True)
+        ]
+        combined = np.concatenate(arrays, axis=1)
+        if frame_count in sample_indices:
+            samples.append(labeled_frame(combined, f"frame {frame_count}"))
+        video_frame = av.VideoFrame.from_ndarray(combined, format="rgb24")
+        for packet in output_stream.encode(video_frame):
+            output.mux(packet)
+        frame_count += 1
+    for packet in output_stream.encode():
+        output.mux(packet)
+    output.close()
+    for container in inputs:
+        container.close()
+    if frame_count != expected_frames:
+        raise RuntimeError(
+            f"expected {expected_frames} decoded frames, found {frame_count}"
+        )
+    if len(samples) != len(sample_indices):
+        raise RuntimeError("failed to retain all contact-sheet samples")
+    combined_width = sum(width for width, _height in expected_resolutions)
+    thumbnail_width = 1280
+    thumbnail_height = int(round(480 * thumbnail_width / combined_width))
+    thumbnails = [
+        cv2.resize(
+            sample,
+            (thumbnail_width, thumbnail_height),
+            interpolation=cv2.INTER_AREA,
+        )
+        for sample in samples
+    ]
+    rows = [
+        np.concatenate(thumbnails[index : index + 3], axis=1)
+        for index in range(0, 9, 3)
+    ]
+    sheet = np.concatenate(rows, axis=0)
+    cv2.imwrite(
+        str(contact_sheet),
+        cv2.cvtColor(sheet, cv2.COLOR_RGB2BGR),
+    )
+    return reports
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dataset-root", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    root = args.dataset_root.resolve()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    info = json.loads((root / "meta" / "info.json").read_text())
+    receipt = json.loads((root / "run-receipt.json").read_text())
+    table = pq.read_table(root / "data" / "chunk-000" / "file-000.parquet")
+    states = np.asarray(table["observation.state"].to_pylist(), dtype=np.float32)
+    actions = np.asarray(table["action"].to_pylist(), dtype=np.float32)
+    expected_actions = np.asarray(
+        np.load(args.trajectory)["actions"],
+        dtype=np.float32,
+    )
+    if states.ndim != 2 or states.shape[1] != 16:
+        raise RuntimeError(f"invalid state shape: {states.shape}")
+    if actions.ndim != 2 or actions.shape[1] != 16:
+        raise RuntimeError(f"invalid action shape: {actions.shape}")
+    if not np.isfinite(states).all() or not np.isfinite(actions).all():
+        raise RuntimeError("state or action contains non-finite values")
+    if actions.shape != expected_actions.shape:
+        raise RuntimeError(
+            f"trajectory action shape mismatch: {actions.shape} "
+            f"!= {expected_actions.shape}"
+        )
+    maximum_action_error = float(np.max(np.abs(actions - expected_actions)))
+    if maximum_action_error != 0.0:
+        raise RuntimeError(
+            f"dataset actions differ from optimized trajectory: "
+            f"{maximum_action_error}"
+        )
+    total_frames = int(info["total_frames"])
+    if total_frames != len(actions):
+        raise RuntimeError("metadata and parquet frame counts differ")
+    camera_records = receipt.get("cameras", [])
+    if camera_records:
+        video_keys = [
+            str(camera["feature_key"])
+            for camera in camera_records
+        ]
+        camera_labels = [str(camera["name"]) for camera in camera_records]
+        expected_resolutions = [
+            (
+                int(camera["resolution_hw"][1]),
+                int(camera["resolution_hw"][0]),
+            )
+            for camera in camera_records
+        ]
+    else:
+        video_keys = list(DEFAULT_VIDEO_KEYS)
+        camera_labels = ["head", "left_wrist", "right_wrist"]
+        expected_resolutions = list(DEFAULT_EXPECTED_RESOLUTIONS)
+    source_videos = [video_path(root, key) for key in video_keys]
+    camera_count = len(source_videos)
+    camera_count_label = {3: "three", 4: "four"}.get(
+        camera_count,
+        str(camera_count),
+    )
+    output_video = (
+        args.output_dir
+        / f"pose-optimized-{camera_count_label}-camera.mp4"
+    )
+    contact_sheet = args.output_dir / "pose-optimized-contact-sheet.png"
+    video_reports = combine_videos(
+        source_videos,
+        camera_labels,
+        expected_resolutions,
+        output_video,
+        contact_sheet,
+        total_frames,
+    )
+    environment = receipt["environments"][0]["visual_shell"]
+    episode = receipt["episodes"][0]
+    report = {
+        "schema_version": 1,
+        "status": "passed",
+        "visual_status": receipt["visual_status"],
+        "task": "DishwasherUnloadCutleryLong",
+        "dataset_root": str(root),
+        "episode": episode,
+        "fps": int(info["fps"]),
+        "frames": total_frames,
+        "camera_set": receipt.get("camera_set"),
+        "camera_order": camera_labels,
+        "state": {
+            "shape": list(states.shape),
+            "finite": True,
+        },
+        "action": {
+            "shape": list(actions.shape),
+            "finite": True,
+            "matches_optimized_trajectory_exactly": True,
+            "maximum_absolute_error": maximum_action_error,
+        },
+        "visual_shell": {
+            "strict": environment["strict"],
+            "rendered_frames": environment["rendered_frames"],
+            "last_error": environment["last_error"],
+            "background_physics": environment["background_physics"],
+        },
+        "videos": video_reports,
+        "artifacts": [
+            file_record(output_video),
+            file_record(contact_sheet),
+            file_record(root / "run-receipt.json"),
+            file_record(root / "data" / "chunk-000" / "file-000.parquet"),
+        ],
+    }
+    report_path = args.output_dir / "pose-optimized-probe-verification.json"
+    report_path.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/d/replay_generation/verify_scene_placement_equivariance.py b/d/replay_generation/verify_scene_placement_equivariance.py
new file mode 100644
index 0000000..6130a90
--- /dev/null
+++ b/d/replay_generation/verify_scene_placement_equivariance.py
@@ -0,0 +1,228 @@
+#!/usr/bin/env python3
+"""Verify that placed-world is a rigid SE(2) copy of canonical physics."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import build_env  # noqa: E402
+from tasks import TASKS  # noqa: E402
+from verify_visual_shell_physics_parity import contact_signature, scalar_state  # noqa: E402
+
+
+def _inverse_points(points: np.ndarray, placement) -> np.ndarray:
+    result = np.asarray(points, dtype=np.float64).copy()
+    result[:, :2] = (
+        result[:, :2] - np.asarray(placement.translation_xy_m)
+    ) @ placement.rotation_xy
+    result[:, 2] -= placement.z_offset_m
+    return result
+
+
+def _inverse_floating_state(values: np.ndarray, env, placement) -> np.ndarray:
+    result = np.asarray(values, dtype=np.float64).copy()
+    base = env.robot.floating_base
+    x_actuator = base.position_actuators[0]
+    y_actuator = base.position_actuators[1]
+    if x_actuator is None or y_actuator is None:
+        raise RuntimeError("placed-world task requires floating pelvis XY")
+    x_joint_id = int(env.mojo.physics.bind(x_actuator.joint).element_id)
+    y_joint_id = int(env.mojo.physics.bind(y_actuator.joint).element_id)
+    x_address = int(env.mojo.model.jnt_qposadr[x_joint_id])
+    y_address = int(env.mojo.model.jnt_qposadr[y_joint_id])
+    canonical_xy = placement.rotation_xy.T @ (
+        np.asarray([result[x_address], result[y_address]])
+        - np.asarray(placement.translation_xy_m)
+    )
+    result[x_address], result[y_address] = canonical_xy
+    rz_actuator = base.rotation_actuators[2]
+    if rz_actuator is not None:
+        rz_joint_id = int(env.mojo.physics.bind(rz_actuator.joint).element_id)
+        rz_address = int(env.mojo.model.jnt_qposadr[rz_joint_id])
+        result[rz_address] -= placement.yaw_radians
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--scene-placement-profile", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--maximum-error", type=float, default=1e-6)
+    args = parser.parse_args()
+
+    task = "DishwasherUnloadCutleryLong"
+    trajectory = np.load(args.trajectory.resolve())
+    canonical_actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    canonical = build_env(task, with_cameras=False)
+    placed = build_env(
+        task,
+        with_cameras=False,
+        scene_placement_profile=str(args.scene_placement_profile.resolve()),
+    )
+    placement = placed.scene_placement
+    placed_actions = np.asarray(
+        [
+            placement.transform_action(
+                action,
+                TASKS[task]["floating_dofs"],
+            )
+            for action in canonical_actions
+        ],
+        dtype=np.float32,
+    )
+    maximums = {
+        "qpos_inverse_se2": 0.0,
+        "qvel": 0.0,
+        "body_position_inverse_se2": 0.0,
+        "contact_distance": 0.0,
+        "time": 0.0,
+    }
+    checkpoints = {}
+    scalar_mismatches: list[dict[str, object]] = []
+    contact_topology_mismatches: list[dict[str, object]] = []
+    try:
+        canonical.reset(seed=seed)
+        placed.reset(seed=seed)
+        for frame_index, (canonical_action, placed_action) in enumerate(
+            zip(canonical_actions, placed_actions, strict=True), start=1
+        ):
+            canonical.step(canonical_action, fast=True)
+            placed.step(placed_action, fast=True)
+            inverse_qpos = _inverse_floating_state(
+                placed.mojo.data.qpos,
+                placed,
+                placement,
+            )
+            maximums["qpos_inverse_se2"] = max(
+                maximums["qpos_inverse_se2"],
+                float(np.max(np.abs(canonical.mojo.data.qpos - inverse_qpos))),
+            )
+            canonical_qvel = np.asarray(canonical.mojo.data.qvel, dtype=np.float64)
+            placed_qvel = np.asarray(placed.mojo.data.qvel, dtype=np.float64).copy()
+            base = placed.robot.floating_base
+            x_dof = int(
+                placed.mojo.model.jnt_dofadr[
+                    placed.mojo.physics.bind(
+                        base.position_actuators[0].joint
+                    ).element_id
+                ]
+            )
+            y_dof = int(
+                placed.mojo.model.jnt_dofadr[
+                    placed.mojo.physics.bind(
+                        base.position_actuators[1].joint
+                    ).element_id
+                ]
+            )
+            placed_qvel[[x_dof, y_dof]] = placement.rotation_xy.T @ placed_qvel[
+                [x_dof, y_dof]
+            ]
+            maximums["qvel"] = max(
+                maximums["qvel"],
+                float(np.max(np.abs(canonical_qvel - placed_qvel))),
+            )
+            # The task-specific model's first three bodies are inert roots:
+            # world, floor, and the H1 attachment root. Actual H1 links and all
+            # task props follow, and are the bodies covered by the placement.
+            inverse_positions = _inverse_points(
+                placed.mojo.data.xpos[3:], placement
+            )
+            maximums["body_position_inverse_se2"] = max(
+                maximums["body_position_inverse_se2"],
+                float(
+                    np.max(
+                        np.abs(canonical.mojo.data.xpos[3:] - inverse_positions)
+                    )
+                ),
+            )
+            canonical_scalars = scalar_state(canonical)
+            placed_scalars = scalar_state(placed)
+            maximums["time"] = max(
+                maximums["time"],
+                abs(canonical_scalars["time"] - placed_scalars["time"]),
+            )
+            for key in ("reward", "terminate", "truncate"):
+                if canonical_scalars[key] != placed_scalars[key]:
+                    scalar_mismatches.append(
+                        {
+                            "frame": frame_index,
+                            "field": key,
+                            "canonical": canonical_scalars[key],
+                            "placed_world": placed_scalars[key],
+                        }
+                    )
+            canonical_contacts = contact_signature(canonical)
+            placed_contacts = contact_signature(placed)
+            if canonical_contacts.shape != placed_contacts.shape or not np.array_equal(
+                canonical_contacts[:, :3], placed_contacts[:, :3]
+            ):
+                contact_topology_mismatches.append(
+                    {
+                        "frame": frame_index,
+                        "canonical_count": int(len(canonical_contacts)),
+                        "placed_world_count": int(len(placed_contacts)),
+                        "canonical_topology": canonical_contacts[:, :3].tolist(),
+                        "placed_world_topology": placed_contacts[:, :3].tolist(),
+                    }
+                )
+            elif len(canonical_contacts):
+                maximums["contact_distance"] = max(
+                    maximums["contact_distance"],
+                    float(
+                        np.max(
+                            np.abs(
+                                canonical_contacts[:, 3] - placed_contacts[:, 3]
+                            )
+                        )
+                    ),
+                )
+            if frame_index in {100, 300, len(canonical_actions)}:
+                checkpoints[str(frame_index)] = {
+                    "canonical": canonical_scalars,
+                    "placed_world": placed_scalars,
+                }
+    finally:
+        canonical.close()
+        placed.close()
+
+    passed = bool(
+        max(maximums.values()) <= args.maximum_error
+        and not scalar_mismatches
+        and not contact_topology_mismatches
+    )
+    report = {
+        "schema_version": 1,
+        "status": "passed" if passed else "failed",
+        "task": task,
+        "seed": seed,
+        "frames": len(canonical_actions),
+        "coordinate_frame": placement.coordinate_frame,
+        "scene_placement": placement.snapshot(),
+        "action_transform": "rotate floating-base XY deltas; keep Z/RZ/arms/grippers",
+        "thresholds": {"maximum_absolute_error": args.maximum_error},
+        "maximum_absolute_error": maximums,
+        "reward_termination_truncation_equal": not scalar_mismatches,
+        "contact_topology_equal": not contact_topology_mismatches,
+        "scalar_mismatches": scalar_mismatches[:20],
+        "contact_topology_mismatch_count": len(contact_topology_mismatches),
+        "contact_topology_mismatches": contact_topology_mismatches[:20],
+        "checkpoints": checkpoints,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(report, indent=2))
+    if not passed:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
