+++ b/d/replay_generation/env_utils.py
@@ -0,0 +1,268 @@
+"""bigym_plus env 构建 + state 提取 (D405/D455 相机, fovy=58, 20Hz).
+
+采集传感器规格:
+  手部相机 D405 (left_wrist / right_wrist): H=480 W=640 fovy=58
+  头部相机 D455 (head):                     H=480 W=848 fovy=58
+控制频率 20Hz. fovy 经 CameraConfig.fovy (bigym_plus 对 bigym 的扩展) 在
+BiGymEnv._initialize_cameras 里写入 model.cam_fovy, 不改 h1.xml 物理默认 (60).
+异分辨率 (480×640 与 480×848) 由 bigym 原生支持: obs_renderers 按 resolution
+tuple 建 dict, 每个唯一分辨率一个独立 mujoco.Renderer (见 bigym_env._initialize_renderers).
+
+state = floating base(动态 DOF) + arm(10) + gripper(2), 与 action 同构同序.
+"""
+import importlib
+import json
+import os
+from pathlib import Path
+import sys
+from typing import NamedTuple
+
+import numpy as np
+
+from bigym.utils.scene_placement import (
+    ScenePlacement,
+    load_scene_placement_profile,
+)
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from tasks import TASKS, FREQ, resolve_task  # noqa: E402
+
+class CameraSpec(NamedTuple):
+    """One ordered BiGym/LeRobot camera stream."""
+
+    name: str
+    lr_key: str
+    resolution: tuple[int, int]
+    fovy: float
+    pos: tuple[float, float, float] | None = None
+    quat: tuple[float, float, float, float] | None = None
+
+
+DEFAULT_CAMERA_SET = "bigym-plus-3"
+FOUR_CAMERA_SET = "bigym-plus-4"
+
+# head=D455 (480×848), wrists=D405 (480×640). The external pose is a
+# deliberately fixed north-east view selected on all 649 frames of
+# DishwasherUnloadCutleryLong.  It keeps H1's helmet-to-feet extent inside a
+# 2.5% projection margin while staying within 1.2 m of the DL3DV camera path.
+THREE_CAMERAS = (
+    CameraSpec("head", "cam_high", (480, 848), 58.0),
+    CameraSpec("left_wrist", "cam_left_wrist", (480, 640), 58.0),
+    CameraSpec("right_wrist", "cam_right_wrist", (480, 640), 58.0),
+)
+EXTERNAL_CAMERA = CameraSpec(
+    "external",
+    "cam_external",
+    (480, 848),
+    58.0,
+    (0.7656362579862039, 1.0914467174146352, 1.65),
+    (
+        0.14493656990500942,
+        0.09564036967314665,
+        0.5424034897488333,
+        0.8219761339000308,
+    ),
+)
+CAMERA_SETS = {
+    DEFAULT_CAMERA_SET: THREE_CAMERAS,
+    FOUR_CAMERA_SET: (*THREE_CAMERAS, EXTERNAL_CAMERA),
+}
+# Backwards-compatible import used by existing scripts.
+CAMERAS = THREE_CAMERAS
+
+# 默认 D405/D455 原生分辨率; 评测若需降采样 (如 128×128) 传 cameras 覆盖.
+DEFAULT_CAMERA_CONFIGS = None  # lazy build (需要 bigym import)
+
+
+def resolve_camera_set(camera_set: str = DEFAULT_CAMERA_SET) -> tuple[CameraSpec, ...]:
+    try:
+        return CAMERA_SETS[camera_set]
+    except KeyError as exc:
+        raise ValueError(
+            f"unknown camera set {camera_set!r}; expected one of "
+            f"{sorted(CAMERA_SETS)}"
+        ) from exc
+
+
+def _default_cameras(
+    camera_set: str = DEFAULT_CAMERA_SET,
+    scene_placement: ScenePlacement | None = None,
+    visual_shell_profile=None,
+):
+    from bigym.utils.observation_config import CameraConfig
+
+    cameras = []
+    profile_external = _profile_external_camera(visual_shell_profile)
+    for spec in resolve_camera_set(camera_set):
+        position = spec.pos
+        quaternion = spec.quat
+        if spec.name == "external" and profile_external is not None:
+            position = profile_external["position_m"]
+            quaternion = profile_external["quaternion_wxyz"]
+        if (
+            scene_placement is not None
+            and spec.name == "external"
+            and position is not None
+            and quaternion is not None
+        ):
+            transformed_position, transformed_quaternion = (
+                scene_placement.camera_pose(position, quaternion)
+            )
+            position = tuple(float(value) for value in transformed_position)
+            quaternion = tuple(float(value) for value in transformed_quaternion)
+        cameras.append(CameraConfig(
+            name=spec.name,
+            rgb=True,
+            resolution=spec.resolution,
+            fovy=spec.fovy,
+            pos=position,
+            quat=quaternion,
+        ))
+    return cameras
+
+
+def _profile_external_camera(visual_shell_profile):
+    """Read a receiptable fixed external pose from a path-backed profile."""
+
+    if visual_shell_profile is None:
+        return None
+    path = Path(str(visual_shell_profile)).expanduser()
+    if not path.is_file():
+        # Registered names are resolved by the visual-shell asset loader.  The
+        # placed-world POC deliberately uses absolute paths.
+        return None
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    external = payload.get("integration_contract", {}).get("external_camera")
+    if external is None:
+        return None
+    if (
+        isinstance(external, dict)
+        and external.get("diagnostic_only") is True
+        and "position_m" not in external
+        and "quaternion_wxyz" not in external
+    ):
+        # A profile may state that external is diagnostic-only without
+        # defining a fixed pose.  This must not block the formal three-camera
+        # environment or invent an external camera transform.
+        return None
+    position = np.asarray(external.get("position_m"), dtype=np.float64)
+    quaternion = np.asarray(external.get("quaternion_wxyz"), dtype=np.float64)
+    if position.shape != (3,) or not np.isfinite(position).all():
+        raise ValueError("visual profile external position must contain 3 values")
+    if quaternion.shape != (4,) or not np.isfinite(quaternion).all():
+        raise ValueError("visual profile external quaternion must contain 4 values")
+    norm = float(np.linalg.norm(quaternion))
+    if norm <= 1e-12:
+        raise ValueError("visual profile external quaternion must be non-zero")
+    return {
+        "position_m": tuple(float(value) for value in position),
+        "quaternion_wxyz": tuple(float(value) for value in quaternion / norm),
+    }
+
+
+def build_env(
+    task_key,
+    control_frequency=FREQ,
+    action_absolute=True,
+    with_cameras=True,
+    render_mode=None,
+    cameras=None,
+    camera_set=DEFAULT_CAMERA_SET,
+    visual_shell_profile=None,
+    visual_shell_strict=True,
+    scene_placement_profile=None,
+):
+    """构建指定任务的 BiGym env.
+
+    :param task_key: PascalCase env_class 或 snake_case (经 resolve_task 归一).
+    :param control_frequency: 控制频率, 默认 20Hz.
+    :param action_absolute: 源 demo 的关节动作表示。正式数据的 action 标签仍由
+        generate_dataset.py 统一转换为 absolute，避免混合训练语义。
+    :param with_cameras: 是否挂观测相机 (D405/D455).
+    :param render_mode: None / "rgb_array" (评测回灌视频用 rgb_array).
+    :param cameras: 自定义 CameraConfig 列表; 传入时优先于 camera_set.
+    :param camera_set: ``bigym-plus-3`` 或含固定 external 的
+        ``bigym-plus-4``.
+    :param visual_shell_profile: 可选本地 JSON 配置路径或已注册壳名称。使用
+        ``dl3dv-kitchen-bigym-h1`` 可自动下载、校验、缓存并载入成品壳。
+    :param visual_shell_strict: 正式采集默认 True，背景渲染失败立即中止。
+    :param scene_placement_profile: 显式 placed-world SE(2) profile。当前只
+        支持 DishwasherUnloadCutleryLong，其他任务 fail closed。
+    """
+    from bigym.action_modes import JointPositionActionMode
+    from bigym.utils.observation_config import ObservationConfig
+
+    info = TASKS[resolve_task(task_key)]
+    scene_placement = (
+        load_scene_placement_profile(
+            scene_placement_profile,
+            expected_task=info["env_class"],
+        )
+        if scene_placement_profile is not None
+        else None
+    )
+    m = importlib.import_module(info["env_module"])
+    env_cls = getattr(m, info["env_class"])
+    cams = (
+        cameras
+        if cameras is not None
+        else (
+            _default_cameras(
+                camera_set,
+                scene_placement,
+                visual_shell_profile,
+            )
+            if with_cameras
+            else []
+        )
+    )
+    return env_cls(
+        action_mode=JointPositionActionMode(
+            floating_base=True,
+            absolute=action_absolute,
+            floating_dofs=info["floating_dofs"],
+        ),
+        control_frequency=control_frequency,
+        observation_config=ObservationConfig(cameras=cams),
+        render_mode=render_mode,
+        visual_shell_profile=visual_shell_profile,
+        visual_shell_strict=visual_shell_strict,
+        scene_placement=scene_placement,
+    )
+
+
+def get_state(robot, obs, mojo):
+    """state = floating base(动态 DOF) + arm(10) + gripper(2). 维度随任务 (15 或 16).
+
+    与 bigym_to_opendm.bigym_def.get_state 同实现, 保证训练/推理 state 对齐.
+    """
+    base = np.asarray(obs["proprioception_floating_base"], dtype=np.float32).reshape(-1)
+    arm = np.asarray(
+        [
+            float(np.asarray(mojo.physics.bind(act.joint).qpos).flatten()[0])
+            for act in robot.limb_actuators
+        ],
+        dtype=np.float32,
+    )
+    grip = np.asarray(robot.qpos_grippers, dtype=np.float32).reshape(-1)
+    return np.concatenate([base, arm, grip])
+
+
+if __name__ == "__main__":
+    # smoke: 构建 ReachTargetDual, 打印相机分辨率 + fovy + state 维度
+    env = build_env("ReachTargetDual")
+    mojo = env.action_mode._mojo
+    obs, _ = env.reset(seed=0)
+    print("action_space:", env.action_space.shape)
+    for spec in CAMERAS:
+        img = obs[f"rgb_{spec.name}"]
+        cam_id = env._cameras_map[spec.name][0]
+        actual_fovy = float(mojo.model.cam_fovy[cam_id])
+        print(
+            f"  {spec.name} ({spec.lr_key}): obs={img.shape} "
+            f"expect=({3},{spec.resolution[0]},{spec.resolution[1]}) "
+            f"fovy={actual_fovy} expect={spec.fovy}"
+        )
+    state = get_state(env.robot, obs, mojo)
+    print("state:", state.shape, state[:5])
+    env.close()
