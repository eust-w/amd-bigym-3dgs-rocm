+#!/usr/bin/env python3
+"""Verify that every selected MuJoCo foreground pixel remains fully opaque."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Any
+
+import mujoco
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import FOUR_CAMERA_SET, build_env, resolve_camera_set  # noqa: E402
+
+
+def _opacity_metrics(
+    composite: np.ndarray,
+    native: np.ndarray,
+    segmentation: np.ndarray,
+    foreground: np.ndarray,
+    floor: np.ndarray,
+    dynamic_geom_ids: set[int],
+) -> dict[str, int]:
+    object_ids = np.asarray(segmentation)[..., 0]
+    object_types = np.asarray(segmentation)[..., 1]
+    geom_pixels = object_types == int(mujoco.mjtObj.mjOBJ_GEOM)
+    dynamic = geom_pixels & np.isin(
+        object_ids,
+        np.fromiter(dynamic_geom_ids, dtype=np.int64),
+    )
+    static_task = foreground & ~dynamic
+    different = np.any(composite != native, axis=2)
+    return {
+        "foreground_pixels": int(np.count_nonzero(foreground)),
+        "static_task_pixels": int(np.count_nonzero(static_task)),
+        "foreground_mismatch_pixels": int(
+            np.count_nonzero(foreground & different)
+        ),
+        "static_task_mismatch_pixels": int(
+            np.count_nonzero(static_task & different)
+        ),
+        "foreground_floor_overlap_pixels": int(
+            np.count_nonzero(foreground & floor)
+        ),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--sample-frames", default="0,324,648")
+    args = parser.parse_args()
+
+    trajectory = np.load(args.trajectory.resolve())
+    actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    sample_frames = sorted(
+        {int(value) for value in args.sample_frames.split(",")}
+    )
+    if not sample_frames or sample_frames[-1] >= len(actions):
+        raise ValueError("sample frames exceed the recorded trajectory")
+
+    camera_specs = resolve_camera_set(FOUR_CAMERA_SET)
+    env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=FOUR_CAMERA_SET,
+        visual_shell_profile=str(args.profile.resolve()),
+        visual_shell_strict=True,
+    )
+    samples: list[dict[str, Any]] = []
+    try:
+        env.reset(seed=seed)
+        shell = env._visual_shell
+        for frame_index in range(sample_frames[-1] + 1):
+            if frame_index in sample_frames:
+                for camera in camera_specs:
+                    camera_id = env._cameras_map[camera.name][0]
+                    renderer = env.obs_renderers[camera.resolution]
+                    renderer.update_scene(env.mojo.data, camera_id)
+                    native = renderer.render()
+                    renderer.enable_segmentation_rendering()
+                    segmentation = renderer.render()
+                    renderer.disable_segmentation_rendering()
+                    foreground = shell.native_foreground_mask(segmentation)
+                    floor = shell.native_floor_mask(segmentation)
+                    composite = shell.render_rgb(
+                        env.mojo.model,
+                        env.mojo.data,
+                        camera_id,
+                        native,
+                        native_foreground_mask=foreground,
+                        native_floor_mask=floor,
+                    )
+                    samples.append(
+                        {
+                            "frame": frame_index,
+                            "camera": camera.name,
+                            **_opacity_metrics(
+                                composite,
+                                native,
+                                segmentation,
+                                foreground,
+                                floor,
+                                shell.dynamic_foreground_geom_ids,
+                            ),
+                        }
+                    )
+            if frame_index < sample_frames[-1]:
+                env.step(actions[frame_index], fast=True)
+        shell_status = shell.status()
+    finally:
+        env.close()
+
+    passed = bool(
+        samples
+        and all(item["foreground_pixels"] > 0 for item in samples)
+        and all(item["static_task_pixels"] > 0 for item in samples)
+        and all(item["foreground_mismatch_pixels"] == 0 for item in samples)
+        and all(item["static_task_mismatch_pixels"] == 0 for item in samples)
+        and all(
+            item["foreground_floor_overlap_pixels"] == 0 for item in samples
+        )
+    )
+    report = {
+        "schema_version": 1,
+        "status": "passed" if passed else "failed",
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": seed,
+        "coordinate_frame": "canonical",
+        "profile": str(args.profile.resolve()),
+        "sample_frames": sample_frames,
+        "camera_order": [camera.name for camera in camera_specs],
+        "foreground_contract": (
+            "all non-floor MuJoCo geom pixels exactly equal native RGB"
+        ),
+        "samples": samples,
+        "visual_shell": shell_status,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(report, indent=2))
+    if not passed:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
