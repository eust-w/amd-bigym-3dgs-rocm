+    )
+    placement_profile = (
+        evidence_report_snapshot(args.scene_placement_profile)
+        if args.scene_placement_profile is not None
+        else None
+    )
+    diagnostic = evidence_report_snapshot(args.diagnostic_report)
+    final_external = (
+        diagnostic["report"].get("scene_placement", {}).get("external_camera")
+        or {}
+    )
+    world_lock_passed = world_lock["report"].get("status") == "passed"
+    physics_parity_passed = physics_parity["report"].get("status") == "passed"
+    receipt_technical_status = technical_status(
+        world_lock_passed=world_lock_passed,
+        physics_parity_passed=physics_parity_passed,
+    )
+    cameras = resolve_camera_set(FOUR_CAMERA_SET)
+    receipt = {
+        "schema_version": 1,
+        "status": "blocked_preflight",
+        "technical_status": receipt_technical_status,
+        "visual_status": "awaiting_visual_approval",
+        "formal_collection_allowed": False,
+        "created_at": datetime.now(timezone.utc).isoformat(),
+        "mode": "four_camera_diagnostic",
+        "dataset_variant": "placed-world-v1",
+        "coordinate_frame": "placed-world-v1",
+        "code_commit": args.code_commit,
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": 2388573616,
+        "camera_set": FOUR_CAMERA_SET,
+        "camera_order": [camera.name for camera in cameras],
+        "cameras": [
+            {
+                "name": camera.name,
+                "feature_key": (f"observation.images.{camera.lr_key}"),
+                "resolution_hw": list(camera.resolution),
+                "fovy_degrees": camera.fovy,
+                "configured_position_m": (
+                    final_external.get("position_m")
+                    if camera.name == "external" and final_external
+                    else (list(camera.pos) if camera.pos is not None else None)
+                ),
+                "configured_quaternion_wxyz": (
+                    final_external.get("quaternion_wxyz")
+                    if camera.name == "external" and final_external
+                    else (list(camera.quat) if camera.quat is not None else None)
+                ),
+            }
+            for camera in cameras
+        ],
+        "runtime": runtime_snapshot(),
+        "visual_shell": {
+            "strict": True,
+            "fallback_allowed": False,
+            "asset": profile_snapshot(args.profile),
+            "world_lock": world_lock,
+            "visual_acceptance": acceptance,
+            "physics_parity": physics_parity,
+            "depth_calibration": depth_calibration,
+            "appearance_search": appearance_search,
+            "external_camera_search": external_search,
+        },
+        "scene_placement": {
+            "profile": placement_profile,
+            "canonical_equivariance": placement_equivariance,
+        },
+        "diagnostic": diagnostic,
+        "lerobot_output": None,
+        "reason": (
+            acceptance["report"]["decision"]
+            if acceptance is not None
+            else (
+                "depth_and_scene_placement_gates_failed"
+                if placement_equivariance is not None
+                else (
+                    "world_lock_failed"
+                    if not world_lock_passed
+                    else "physics_parity_failed"
+                )
+            )
+        ),
+        "next_required_action": (
+            "Recapture or reconstruct a shell covering the actual H1 head, "
+            "wrist, and external trajectories before formal generation."
+        ),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(receipt, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(receipt, indent=2))
+
+
+if __name__ == "__main__":
+    main()
