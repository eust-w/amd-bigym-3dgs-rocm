+import numpy as np
+
+from d.replay_generation.optimize_visual_shell_pose import (
+    CAMERA_KEYS,
+    MUJOCO_TO_CV_CAMERA,
+    TrajectoryPoseObjective,
+    candidate_transform,
+    yaw_rotation,
+)
+
+
+def test_trajectory_objective_recovers_exact_upright_pose():
+    source_cameras = np.repeat(np.eye(4)[None], 3, axis=0)
+    source_cameras[:, 0, 3] = [0.0, 1.0, 2.0]
+    yaw_degrees = 90.0
+    translation = np.array([1.0, 2.0, 0.0])
+    rotation = yaw_rotation(yaw_degrees)
+    target_positions = (
+        source_cameras[:, :3, 3] @ rotation.T + translation
+    )
+    target_rotations_mujoco = np.repeat(
+        (rotation @ MUJOCO_TO_CV_CAMERA)[None],
+        3,
+        axis=0,
+    )
+    trajectory = {}
+    for position_key, rotation_key in CAMERA_KEYS.values():
+        trajectory[position_key] = target_positions
+        trajectory[rotation_key] = target_rotations_mujoco
+
+    objective = TrajectoryPoseObjective(
+        source_cameras,
+        np.eye(4),
+        trajectory,
+        stride=1,
+    )
+
+    baseline_score, _ = objective.evaluate([0.0, 0.0, 0.0])
+    selected_score, selected = objective.evaluate(
+        [yaw_degrees, translation[0], translation[1]]
+    )
+
+    assert baseline_score > 0.0
+    assert selected_score < 1e-12
+    for camera in CAMERA_KEYS:
+        assert (
+            selected["per_camera"][camera][
+                "capture_path_translation_m"
+            ]["maximum"]
+            < 1e-12
+        )
+        assert (
+            selected["per_camera"][camera][
+                "capture_path_rotation_degrees"
+            ]["maximum"]
+            == 0.0
+        )
+
+
+def test_candidate_transform_keeps_scale_floor_height_pitch_and_roll():
+    current = np.eye(4)
+    current[:3, :3] *= 2.5
+    current[:3, 3] = [0.4, -0.7, 1.2]
+    result = {
+        "yaw_offset_degrees": -37.0,
+        "translation_xy_m": [0.5, 0.25],
+    }
+
+    transformed, post_transform = candidate_transform(current, result)
+
+    np.testing.assert_allclose(
+        np.linalg.norm(transformed[:3, :3], axis=0),
+        [2.5, 2.5, 2.5],
+    )
+    np.testing.assert_allclose(transformed[2], current[2])
+    np.testing.assert_allclose(post_transform[2], [0.0, 0.0, 1.0, 0.0])
