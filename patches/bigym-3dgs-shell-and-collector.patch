+from __future__ import annotations
+
+import json
+from enum import Enum
+
+import numpy as np
+import pytest
+
+from bigym.utils.scene_placement import (
+    PLACED_WORLD_FRAME,
+    SUPPORTED_PLACED_TASK,
+    load_scene_placement_profile,
+)
+
+
+class _Dof(Enum):
+    X = "pelvis_x"
+    Y = "pelvis_y"
+    Z = "pelvis_z"
+    RZ = "pelvis_rz"
+
+
+def _profile(tmp_path, **overrides):
+    payload = {
+        "schema_version": 1,
+        "name": "test-placement",
+        "task": SUPPORTED_PLACED_TASK,
+        "translation_xy_m": [2.0, -1.0],
+        "yaw_degrees": 90.0,
+        "z_offset_m": 0.0,
+        "coordinate_frame": PLACED_WORLD_FRAME,
+        "demo_seed": 2388573616,
+        "transform_source": "unit-test",
+    }
+    payload.update(overrides)
+    path = tmp_path / "placement.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    return path
+
+
+def test_scene_placement_transforms_points_poses_and_base_xy(tmp_path) -> None:
+    placement = load_scene_placement_profile(_profile(tmp_path))
+    assert np.allclose(placement.transform_point([1.0, 0.0, 0.5]), [2, 0, 0.5])
+    assert np.allclose(
+        placement.transform_euler_xyz([0.0, 0.0, -np.pi / 2]),
+        [0.0, 0.0, 0.0],
+    )
+    action = np.arange(16, dtype=np.float32)
+    action[0:2] = [0.01, 0.0]
+    transformed = placement.transform_action(
+        action,
+        [_Dof.X, _Dof.Y, _Dof.Z, _Dof.RZ],
+    )
+    assert np.allclose(transformed[:2], [0.0, 0.01], atol=1e-7)
+    assert np.array_equal(transformed[2:], action[2:])
+
+
+def test_scene_placement_rejects_nonzero_physics_height(tmp_path) -> None:
+    with pytest.raises(ValueError, match="z_offset_m at zero"):
+        load_scene_placement_profile(_profile(tmp_path, z_offset_m=-0.04))
+
+
+def test_scene_placement_rejects_other_tasks(tmp_path) -> None:
+    with pytest.raises(ValueError, match="only supports"):
+        load_scene_placement_profile(_profile(tmp_path, task="ReachTargetDual"))
+
+
+def test_explicit_external_camera_is_not_transformed_twice(tmp_path) -> None:
+    placement = load_scene_placement_profile(
+        _profile(
+            tmp_path,
+            external_camera={
+                "position_m": [4.0, 5.0, 1.5],
+                "quaternion_wxyz": [1.0, 0.0, 0.0, 0.0],
+            },
+        )
+    )
+    position, quaternion = placement.camera_pose(
+        [1.0, 2.0, 3.0],
+        [0.0, 0.0, 0.0, 1.0],
+    )
+    assert np.array_equal(position, [4.0, 5.0, 1.5])
+    assert np.array_equal(quaternion, [1.0, 0.0, 0.0, 0.0])
