+#!/usr/bin/env python3
+"""Render a strict four-camera diagnostic replay without creating a dataset."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import av
+import cv2
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import FOUR_CAMERA_SET, build_env, resolve_camera_set  # noqa: E402
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+class _H264Writer:
+    def __init__(
+        self,
+        path: Path,
+        width: int,
+        height: int,
+        fps: float,
+    ) -> None:
+        self.container = av.open(str(path), mode="w")
+        self.stream = self.container.add_stream("libx264", rate=round(fps))
+        self.stream.width = width
+        self.stream.height = height
+        self.stream.pix_fmt = "yuv420p"
+        self.stream.options = {"crf": "20", "preset": "medium"}
+
+    def write(self, rgb: np.ndarray) -> None:
+        frame = av.VideoFrame.from_ndarray(rgb, format="rgb24")
+        for packet in self.stream.encode(frame):
+            self.container.mux(packet)
+
+    def close(self) -> None:
+        for packet in self.stream.encode():
+            self.container.mux(packet)
+        self.container.close()
+
+
+def _label(image: np.ndarray, label: str) -> np.ndarray:
+    result = image.copy()
+    cv2.rectangle(result, (0, 0), (result.shape[1], 30), (0, 0, 0), -1)
+    cv2.putText(
+        result,
+        label,
+        (8, 21),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        0.55,
+        (255, 255, 255),
+        1,
+        cv2.LINE_AA,
+    )
+    return result
+
+
+def _mosaic(frames: dict[str, np.ndarray]) -> np.ndarray:
+    tiles = []
+    for name in ("head", "left_wrist", "right_wrist", "external"):
+        tile = cv2.resize(
+            frames[name],
+            (640, 360),
+            interpolation=cv2.INTER_AREA,
+        )
+        tiles.append(_label(tile, name))
+    return np.concatenate(
+        [
+            np.concatenate(tiles[:2], axis=1),
+            np.concatenate(tiles[2:], axis=1),
+        ],
+        axis=0,
+    )
+
+
+def _frame_quality(image: np.ndarray) -> dict[str, float]:
+    gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)
+    laplacian = cv2.Laplacian(gray, cv2.CV_64F)
+    return {
+        "luma_mean": float(np.mean(gray)),
+        "luma_std": float(np.std(gray)),
+        "laplacian_variance": float(np.var(laplacian)),
+        "dark_fraction": float(np.mean(gray < 18)),
+        "bright_fraction": float(np.mean(gray > 245)),
+    }
+
+
+def _quality_plot(metrics: dict[str, list[dict[str, float]]]) -> np.ndarray:
+    canvas = np.full((720, 1280, 3), 245, dtype=np.uint8)
+    colors = {
+        "head": (24, 83, 219),
+        "left_wrist": (28, 160, 70),
+        "right_wrist": (205, 90, 28),
+        "external": (140, 55, 190),
+    }
+    panels = (
+        ("laplacian_variance", "clarity / Laplacian variance"),
+        ("bright_fraction", "overexposed fraction"),
+    )
+    for panel_index, (key, title) in enumerate(panels):
+        top = 40 + panel_index * 340
+        bottom = top + 280
+        left, right = 80, 1230
+        cv2.rectangle(canvas, (left, top), (right, bottom), (80, 80, 80), 1)
+        cv2.putText(
+            canvas,
+            title,
+            (left, top - 12),
+            cv2.FONT_HERSHEY_SIMPLEX,
+            0.65,
+            (20, 20, 20),
+            1,
+            cv2.LINE_AA,
+        )
+        maximum = max(
+            max(float(item[key]) for item in rows)
+            for rows in metrics.values()
+        )
+        maximum = max(maximum, 1e-12)
+        for camera_index, (name, rows) in enumerate(metrics.items()):
+            values = np.asarray([item[key] for item in rows], dtype=np.float64)
+            x = np.linspace(left, right, len(values))
+            y = bottom - np.clip(values / maximum, 0.0, 1.0) * (bottom - top)
+            points = np.column_stack([x, y]).astype(np.int32)
+            cv2.polylines(canvas, [points], False, colors[name], 2, cv2.LINE_AA)
+            cv2.putText(
+                canvas,
+                name,
+                (left + 220 * camera_index, bottom + 25),
+                cv2.FONT_HERSHEY_SIMPLEX,
+                0.48,
+                colors[name],
+                1,
+                cv2.LINE_AA,
+            )
+    return canvas
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--scene-placement-profile", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--fps", type=float, default=20.0)
+    parser.add_argument(
+        "--reason",
+        default=(
+            "Appearance-optimized strict four-camera replay for visual "
+            "review; formal collection remains awaiting visual approval."
+        ),
+    )
+    args = parser.parse_args()
+
+    output_dir = args.output_dir.resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+    trajectory = np.load(args.trajectory.resolve())
+    canonical_actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    camera_specs = resolve_camera_set(FOUR_CAMERA_SET)
+    output_paths = {
+        camera.name: output_dir / f"{camera.name}.mp4"
+        for camera in camera_specs
+    }
+    writers = {
+        camera.name: _H264Writer(
+            output_paths[camera.name],
+            camera.resolution[1],
+            camera.resolution[0],
+            args.fps,
+        )
+        for camera in camera_specs
+    }
+    mosaic_path = output_dir / "four-camera-diagnostic.mp4"
+    mosaic_writer = _H264Writer(mosaic_path, 1280, 720, args.fps)
+    review_frames: dict[int, dict[str, np.ndarray]] = {}
+    quality_metrics: dict[str, list[dict[str, float]]] = {
+        camera.name: [] for camera in camera_specs
+    }
+    worst_frames: dict[str, tuple[int, float, np.ndarray]] = {}
+    env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=FOUR_CAMERA_SET,
+        visual_shell_profile=str(args.profile.resolve()),
+        visual_shell_strict=True,
+        scene_placement_profile=(
+            str(args.scene_placement_profile.resolve())
+            if args.scene_placement_profile is not None
+            else None
+        ),
+    )
+    actions = (
+        np.asarray(
+            [
+                env.scene_placement.transform_action(
+                    action,
+                    env.action_mode.floating_dofs,
+                )
+                for action in canonical_actions
+            ],
+            dtype=np.float32,
+        )
+        if env.scene_placement is not None
+        else canonical_actions
+    )
+    review_indices = {
+        int(value) for value in np.linspace(0, len(actions) - 1, 9).round()
+    }
+    started = time.perf_counter()
+    final_reward = 0.0
+    try:
+        obs, _info = env.reset(seed=seed)
+        for frame_index, action in enumerate(actions):
+            rgb_frames = {
+                camera.name: np.asarray(
+                    obs[f"rgb_{camera.name}"],
+                    dtype=np.uint8,
+                ).transpose(1, 2, 0)
+                for camera in camera_specs
+            }
+            for name, image in rgb_frames.items():
+                writers[name].write(image)
+                metrics = _frame_quality(image)
+                metrics["frame"] = frame_index
+                quality_metrics[name].append(metrics)
+                clarity = metrics["laplacian_variance"]
+                if name not in worst_frames or clarity < worst_frames[name][1]:
+                    worst_frames[name] = (frame_index, clarity, image.copy())
+            mosaic_writer.write(_mosaic(rgb_frames))
+            if frame_index in review_indices:
+                review_frames[frame_index] = {
+                    name: image.copy() for name, image in rgb_frames.items()
+                }
+            obs, final_reward, _term, _trunc, _info = env.step(
+                action,
+            )
+        shell_status = env._visual_shell.status()
+    finally:
+        elapsed = time.perf_counter() - started
+        env.close()
+        for writer in writers.values():
+            writer.close()
+        mosaic_writer.close()
+
+    rows = []
+    for frame_index in sorted(review_frames):
+        row = []
+        for name in ("head", "left_wrist", "right_wrist", "external"):
+            image = cv2.resize(
+                review_frames[frame_index][name],
+                (424, 240),
+                interpolation=cv2.INTER_AREA,
+            )
+            row.append(_label(image, f"f{frame_index} | {name}"))
+        rows.append(np.concatenate(row, axis=1))
+    contact_sheet = np.concatenate(rows, axis=0)
+    contact_sheet_path = output_dir / "four-camera-contact-sheet.png"
+    cv2.imwrite(
+        str(contact_sheet_path),
+        cv2.cvtColor(contact_sheet, cv2.COLOR_RGB2BGR),
+    )
+    worst_strip = np.concatenate(
+        [
+            _label(
+                cv2.resize(
+                    worst_frames[name][2],
+                    (424, 240),
+                    interpolation=cv2.INTER_AREA,
+                ),
+                f"{name} | worst f{worst_frames[name][0]}",
+            )
+            for name in ("head", "left_wrist", "right_wrist", "external")
+        ],
+        axis=1,
+    )
+    worst_strip_path = output_dir / "four-camera-worst-frame-strip.png"
+    cv2.imwrite(
+        str(worst_strip_path),
+        cv2.cvtColor(worst_strip, cv2.COLOR_RGB2BGR),
+    )
+    quality_metrics_path = output_dir / "four-camera-frame-quality.json"
+    quality_metrics_path.write_text(
+        json.dumps(quality_metrics, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    quality_plot_path = output_dir / "four-camera-quality-curves.png"
+    cv2.imwrite(str(quality_plot_path), _quality_plot(quality_metrics))
+
+    videos = {}
+    for name, path in {**output_paths, "mosaic": mosaic_path}.items():
+        videos[name] = {
+            "path": str(path),
+            "bytes": path.stat().st_size,
+            "sha256": _sha256(path),
+        }
+    peak_allocated = None
+    peak_reserved = None
+    try:
+        import torch
+
+        peak_allocated = int(torch.cuda.max_memory_allocated())
+        peak_reserved = int(torch.cuda.max_memory_reserved())
+    except Exception:
+        pass
+    report = {
+        "schema_version": 1,
+        "status": "diagnostic_only",
+        "formal_collection_allowed": False,
+        "visual_status": "awaiting_visual_approval",
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": seed,
+        "camera_set": FOUR_CAMERA_SET,
+        "camera_order": [camera.name for camera in camera_specs],
+        "formal_camera_order": ["head", "left_wrist", "right_wrist"],
+        "external_camera": {
+            "diagnostic_only": True,
+            "formal_schema_included": False,
+        },
+        "frames": len(actions),
+        "fps": args.fps,
+        "final_reward": float(final_reward),
+        "profile": str(args.profile.resolve()),
+        "code_revision": subprocess.run(
+            ["git", "rev-parse", "HEAD"],
+            check=True,
+            capture_output=True,
+            text=True,
+        ).stdout.strip(),
+        "scene_placement": (
+            env.scene_placement.snapshot()
+            if env.scene_placement is not None
+            else None
+        ),
+        "elapsed_seconds": elapsed,
+        "seconds_per_camera_frame": elapsed / (len(actions) * 4),
+        "visual_shell": shell_status,
+        "peak_allocated_bytes": peak_allocated,
+        "peak_reserved_bytes": peak_reserved,
+        "videos": videos,
+        "contact_sheet": {
+            "path": str(contact_sheet_path),
+            "bytes": contact_sheet_path.stat().st_size,
+            "sha256": _sha256(contact_sheet_path),
+        },
+        "worst_frame_strip": {
+            "path": str(worst_strip_path),
+            "bytes": worst_strip_path.stat().st_size,
+            "sha256": _sha256(worst_strip_path),
+        },
+        "quality_curves": {
+            "path": str(quality_plot_path),
+            "bytes": quality_plot_path.stat().st_size,
+            "sha256": _sha256(quality_plot_path),
+        },
+        "frame_quality": {
+            "path": str(quality_metrics_path),
+            "bytes": quality_metrics_path.stat().st_size,
+            "sha256": _sha256(quality_metrics_path),
+            "summary": {
+                name: {
+                    "laplacian_variance_min": float(
+                        min(row["laplacian_variance"] for row in rows)
+                    ),
+                    "laplacian_variance_p10": float(
+                        np.percentile(
+                            [row["laplacian_variance"] for row in rows],
+                            10,
+                        )
+                    ),
+                    "laplacian_variance_mean": float(
+                        np.mean([row["laplacian_variance"] for row in rows])
+                    ),
+                    "bright_fraction_mean": float(
+                        np.mean([row["bright_fraction"] for row in rows])
+                    ),
+                }
+                for name, rows in quality_metrics.items()
+            },
+        },
+        "reason": args.reason,
+    }
+    report_path = output_dir / "four-camera-diagnostic-report.json"
+    report_path.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
