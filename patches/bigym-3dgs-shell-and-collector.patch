+from __future__ import annotations
+
+import csv
+import json
+
+from d.replay_generation.summarize_visual_shell_search import summarize
+
+
+def _summary(value: float) -> dict:
+    return {"p10": value, "mean": value, "maximum": value}
+
+
+def test_search_summary_writes_heatmaps_curves_worst_frames_and_ranking(
+    tmp_path,
+) -> None:
+    appearance = []
+    per_camera = {}
+    for camera in ("head", "left_wrist", "right_wrist"):
+        per_camera[camera] = {
+            "baseline": {"clear_score": _summary(0.4)},
+        }
+        for frame in range(5):
+            appearance.append(
+                {
+                    "camera": camera,
+                    "frame": frame,
+                    "task_context_gaussian_coverage": 1.0 - frame * 0.01,
+                    "task_context_severe_fog_fraction": frame * 0.01,
+                    "task_context_clear_score": 0.5 - frame * 0.02,
+                    "depth_conflict_fraction": frame * 0.005,
+                }
+            )
+    candidate = {
+        "parameters": {"scale": 1.0, "yaw": 10.0, "x": 0.1, "y": 0.2, "z": 0.0},
+        "appearance": appearance,
+        "gate": {
+            "passed": False,
+            "clear_camera_count": 0,
+            "three_camera_mean_clear": 0.46,
+            "rejection_reasons": ["head:clear_p10"],
+            "per_camera": per_camera,
+        },
+    }
+    report = tmp_path / "report.json"
+    report.write_text(
+        json.dumps(
+            {
+                "status": "infinigen_no_three_camera_visual_candidate",
+                "selected": None,
+                "final_candidates": [candidate],
+            }
+        )
+    )
+    output = tmp_path / "evidence"
+    result = summarize(report, output)
+    assert result["candidate_passed"] is False
+    for name in (
+        "worst-frames.json",
+        "coverage-fog-depth-heatmaps.png",
+        "clarity-curves.png",
+        "candidate-ranking.csv",
+        "evidence-summary.json",
+    ):
+        assert (output / name).stat().st_size > 0
+    worst = json.loads((output / "worst-frames.json").read_text())
+    assert worst["head"]["lowest_clear_score"]["frame"] == 4
+    with (output / "candidate-ranking.csv").open() as stream:
+        rows = list(csv.DictReader(stream))
+    assert rows[0]["passed"] == "False"
