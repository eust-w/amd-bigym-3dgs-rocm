diff --git a/bigym/utils/scene_placement.py b/bigym/utils/scene_placement.py
new file mode 100644
index 0000000..d9cee66
--- /dev/null
+++ b/bigym/utils/scene_placement.py
@@ -0,0 +1,227 @@
+"""Validated SE(2) placement for the placed-world BiGym POC.
+
+The placement moves the complete task setup as one rigid world-frame transform.
+It never scales physics, changes gravity, or introduces geometry.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+from pathlib import Path
+from typing import Any, Iterable
+
+import numpy as np
+
+
+PLACED_WORLD_FRAME = "placed-world-v1"
+SUPPORTED_PLACED_TASK = "DishwasherUnloadCutleryLong"
+
+
+def _normalise_quaternion_wxyz(value: Iterable[float]) -> np.ndarray:
+    quaternion = np.asarray(tuple(value), dtype=np.float64)
+    if quaternion.shape != (4,) or not np.isfinite(quaternion).all():
+        raise ValueError("quaternion must contain four finite wxyz values")
+    norm = float(np.linalg.norm(quaternion))
+    if norm <= 1e-12:
+        raise ValueError("quaternion must be non-zero")
+    return quaternion / norm
+
+
+def _multiply_quaternions_wxyz(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    lw, lx, ly, lz = left
+    rw, rx, ry, rz = right
+    return _normalise_quaternion_wxyz(
+        (
+            lw * rw - lx * rx - ly * ry - lz * rz,
+            lw * rx + lx * rw + ly * rz - lz * ry,
+            lw * ry - lx * rz + ly * rw + lz * rx,
+            lw * rz + lx * ry - ly * rx + lz * rw,
+        )
+    )
+
+
+@dataclass(frozen=True)
+class ScenePlacement:
+    """One rigid placed-world transform loaded from a receiptable profile."""
+
+    profile_path: Path
+    name: str
+    task: str
+    translation_xy_m: tuple[float, float]
+    yaw_degrees: float
+    z_offset_m: float
+    coordinate_frame: str
+    demo_seed: int
+    transform_source: str
+    external_camera: dict[str, tuple[float, ...]] | None = None
+
+    @property
+    def yaw_radians(self) -> float:
+        return float(np.deg2rad(self.yaw_degrees))
+
+    @property
+    def rotation_xy(self) -> np.ndarray:
+        cosine = float(np.cos(self.yaw_radians))
+        sine = float(np.sin(self.yaw_radians))
+        return np.asarray([[cosine, -sine], [sine, cosine]], dtype=np.float64)
+
+    @property
+    def rotation_quaternion_wxyz(self) -> np.ndarray:
+        half = self.yaw_radians / 2.0
+        return np.asarray(
+            [np.cos(half), 0.0, 0.0, np.sin(half)], dtype=np.float64
+        )
+
+    def transform_point(self, point_m: Iterable[float]) -> np.ndarray:
+        point = np.asarray(tuple(point_m), dtype=np.float64)
+        if point.shape != (3,) or not np.isfinite(point).all():
+            raise ValueError("point must contain three finite values")
+        result = point.copy()
+        result[:2] = self.rotation_xy @ point[:2] + np.asarray(
+            self.translation_xy_m, dtype=np.float64
+        )
+        result[2] += self.z_offset_m
+        return result
+
+    def transform_euler_xyz(self, euler_radians: Iterable[float]) -> np.ndarray:
+        euler = np.asarray(tuple(euler_radians), dtype=np.float64)
+        if euler.shape != (3,) or not np.isfinite(euler).all():
+            raise ValueError("euler must contain three finite xyz values")
+        if not np.allclose(euler[:2], 0.0, atol=1e-10):
+            raise ValueError(
+                "placed-world POC only supports upright root preset props"
+            )
+        result = euler.copy()
+        result[2] += self.yaw_radians
+        return result
+
+    def transform_quaternion_wxyz(
+        self, quaternion_wxyz: Iterable[float]
+    ) -> np.ndarray:
+        return _multiply_quaternions_wxyz(
+            self.rotation_quaternion_wxyz,
+            _normalise_quaternion_wxyz(quaternion_wxyz),
+        )
+
+    def transform_action(
+        self,
+        action: Iterable[float],
+        floating_dofs: Iterable[Any],
+    ) -> np.ndarray:
+        """Rotate world-frame base XY deltas; leave all other controls intact."""
+
+        result = np.asarray(tuple(action), dtype=np.float32).copy()
+        names = [getattr(dof, "value", str(dof)) for dof in floating_dofs]
+        try:
+            x_index = names.index("pelvis_x")
+            y_index = names.index("pelvis_y")
+        except ValueError as exc:
+            raise ValueError("placed-world action requires pelvis_x and pelvis_y") from exc
+        if result.ndim != 1 or result.size < len(names):
+            raise ValueError("action is shorter than its floating-base prefix")
+        rotated = self.rotation_xy @ np.asarray(
+            [result[x_index], result[y_index]], dtype=np.float64
+        )
+        result[x_index] = rotated[0]
+        result[y_index] = rotated[1]
+        return result
+
+    def camera_pose(
+        self,
+        position_m: Iterable[float],
+        quaternion_wxyz: Iterable[float],
+    ) -> tuple[np.ndarray, np.ndarray]:
+        if self.external_camera is not None:
+            return (
+                np.asarray(self.external_camera["position_m"], dtype=np.float64),
+                np.asarray(
+                    self.external_camera["quaternion_wxyz"], dtype=np.float64
+                ),
+            )
+        return (
+            self.transform_point(position_m),
+            self.transform_quaternion_wxyz(quaternion_wxyz),
+        )
+
+    def snapshot(self) -> dict[str, Any]:
+        return {
+            "profile": str(self.profile_path),
+            "name": self.name,
+            "task": self.task,
+            "translation_xy_m": list(self.translation_xy_m),
+            "yaw_degrees": self.yaw_degrees,
+            "z_offset_m": self.z_offset_m,
+            "coordinate_frame": self.coordinate_frame,
+            "demo_seed": self.demo_seed,
+            "transform_source": self.transform_source,
+            "external_camera": (
+                {
+                    "position_m": list(self.external_camera["position_m"]),
+                    "quaternion_wxyz": list(
+                        self.external_camera["quaternion_wxyz"]
+                    ),
+                }
+                if self.external_camera is not None
+                else None
+            ),
+        }
+
+
+def load_scene_placement_profile(
+    profile_path: str | Path,
+    *,
+    expected_task: str | None = None,
+) -> ScenePlacement:
+    path = Path(profile_path).expanduser().resolve()
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    if int(payload.get("schema_version", 0)) != 1:
+        raise ValueError("scene placement profile schema_version must be 1")
+    task = str(payload.get("task", ""))
+    if task != SUPPORTED_PLACED_TASK:
+        raise ValueError(
+            "placed-world POC only supports " f"{SUPPORTED_PLACED_TASK}, got {task!r}"
+        )
+    if expected_task is not None and task != expected_task:
+        raise ValueError(
+            f"scene placement profile targets {task}, not {expected_task}"
+        )
+    frame = str(payload.get("coordinate_frame", ""))
+    if frame != PLACED_WORLD_FRAME:
+        raise ValueError(
+            f"coordinate_frame must be {PLACED_WORLD_FRAME!r}, got {frame!r}"
+        )
+    translation = np.asarray(payload.get("translation_xy_m"), dtype=np.float64)
+    if translation.shape != (2,) or not np.isfinite(translation).all():
+        raise ValueError("translation_xy_m must contain two finite values")
+    yaw = float(payload.get("yaw_degrees"))
+    z_offset = float(payload.get("z_offset_m"))
+    if not np.isfinite(yaw) or not np.isfinite(z_offset):
+        raise ValueError("yaw_degrees and z_offset_m must be finite")
+    if abs(z_offset) > 1e-12:
+        raise ValueError("placed-world POC keeps physical z_offset_m at zero")
+    external = payload.get("external_camera")
+    external_camera = None
+    if external is not None:
+        position = np.asarray(external.get("position_m"), dtype=np.float64)
+        if position.shape != (3,) or not np.isfinite(position).all():
+            raise ValueError("external_camera.position_m must contain three values")
+        quaternion = _normalise_quaternion_wxyz(
+            external.get("quaternion_wxyz", ())
+        )
+        external_camera = {
+            "position_m": tuple(float(value) for value in position),
+            "quaternion_wxyz": tuple(float(value) for value in quaternion),
+        }
+    return ScenePlacement(
+        profile_path=path,
+        name=str(payload.get("name", path.stem)),
+        task=task,
+        translation_xy_m=(float(translation[0]), float(translation[1])),
+        yaw_degrees=yaw,
+        z_offset_m=z_offset,
+        coordinate_frame=frame,
+        demo_seed=int(payload.get("demo_seed")),
+        transform_source=str(payload.get("transform_source", "")),
+        external_camera=external_camera,
+    )
