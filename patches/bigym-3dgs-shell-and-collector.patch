+#!/usr/bin/env python3
+"""Render matched task frames for several strict visual-shell profiles."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import build_env  # noqa: E402
+
+
+CAMERAS = ("head", "left_wrist", "right_wrist")
+
+
+def parse_candidate(value: str) -> tuple[str, Path]:
+    name, separator, path = value.partition("=")
+    if not separator or not name or not path:
+        raise argparse.ArgumentTypeError(
+            "candidate must use NAME=/absolute/profile.json"
+        )
+    return name, Path(path)
+
+
+def background_detail_metrics(
+    image: np.ndarray,
+    foreground: np.ndarray,
+) -> dict[str, float]:
+    gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)
+    background = ~foreground
+    background = cv2.erode(
+        background.astype(np.uint8),
+        np.ones((5, 5), dtype=np.uint8),
+    ).astype(bool)
+    if not background.any():
+        return {
+            "background_fraction": 0.0,
+            "background_pixels": 0.0,
+            "laplacian_variance": 0.0,
+            "gradient_mean": 0.0,
+            "gradient_p50": 0.0,
+            "gradient_p90": 0.0,
+            "low_gradient_fraction_below_4": 1.0,
+        }
+    laplacian = cv2.Laplacian(gray, cv2.CV_64F)
+    gradient_x = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
+    gradient_y = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)
+    gradient = np.hypot(gradient_x, gradient_y)
+    background_laplacian = laplacian[background]
+    background_gradient = gradient[background]
+    return {
+        "background_fraction": float(np.mean(background)),
+        "background_pixels": float(np.count_nonzero(background)),
+        "laplacian_variance": float(np.var(background_laplacian)),
+        "gradient_mean": float(np.mean(background_gradient)),
+        "gradient_p50": float(np.percentile(background_gradient, 50)),
+        "gradient_p90": float(np.percentile(background_gradient, 90)),
+        "low_gradient_fraction_below_4": float(
+            np.mean(background_gradient < 4.0)
+        ),
+    }
+
+
+def capture_cameras(env) -> tuple[dict[str, np.ndarray], dict[str, dict]]:
+    images: dict[str, np.ndarray] = {}
+    metrics: dict[str, dict] = {}
+    for camera_config in env.observation_config.cameras:
+        renderer = env.obs_renderers[camera_config.resolution]
+        camera_id = env._cameras_map[camera_config.name][0]
+        renderer.update_scene(env.mojo.data, camera_id)
+        native_rgb = renderer.render()
+        renderer.enable_segmentation_rendering()
+        segmentation = renderer.render()
+        renderer.disable_segmentation_rendering()
+        foreground = env._visual_shell.native_foreground_mask(segmentation)
+        native_floor = env._visual_shell.native_floor_mask(segmentation)
+        started = time.perf_counter()
+        composite = env._visual_shell.render_rgb(
+            env.mojo.model,
+            env.mojo.data,
+            camera_id,
+            native_rgb,
+            native_foreground_mask=foreground,
+            native_floor_mask=native_floor,
+        )
+        elapsed_ms = 1000.0 * (time.perf_counter() - started)
+        images[camera_config.name] = composite
+        metrics[camera_config.name] = {
+            **background_detail_metrics(composite, foreground),
+            "render_ms": elapsed_ms,
+            "foreground_fraction": float(np.mean(foreground)),
+        }
+    return images, metrics
+
+
+def labeled_thumbnail(
+    image: np.ndarray,
+    label: str,
+    *,
+    width: int = 280,
+    height: int = 180,
+) -> np.ndarray:
+    canvas = cv2.resize(image, (width, height), interpolation=cv2.INTER_AREA)
+    canvas = cv2.cvtColor(canvas, cv2.COLOR_RGB2BGR)
+    cv2.rectangle(canvas, (0, 0), (width, 27), (0, 0, 0), thickness=-1)
+    cv2.putText(
+        canvas,
+        label,
+        (7, 19),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        0.48,
+        (255, 255, 255),
+        1,
+        cv2.LINE_AA,
+    )
+    return cv2.cvtColor(canvas, cv2.COLOR_BGR2RGB)
+
+
+def write_contact_sheets(
+    output_dir: Path,
+    candidates: list[tuple[str, Path]],
+    sample_frames: list[int],
+) -> None:
+    for camera in CAMERAS:
+        rows = []
+        for frame_index in sample_frames:
+            row = []
+            for name, _profile in candidates:
+                image = cv2.cvtColor(
+                    cv2.imread(
+                        str(
+                            output_dir
+                            / name
+                            / f"frame-{frame_index:04d}-{camera}.png"
+                        )
+                    ),
+                    cv2.COLOR_BGR2RGB,
+                )
+                row.append(
+                    labeled_thumbnail(
+                        image,
+                        f"{name} | frame {frame_index}",
+                    )
+                )
+            rows.append(np.concatenate(row, axis=1))
+        sheet = np.concatenate(rows, axis=0)
+        cv2.imwrite(
+            str(output_dir / f"comparison-{camera}.png"),
+            cv2.cvtColor(sheet, cv2.COLOR_RGB2BGR),
+        )
+
+    key_frames = [
+        sample_frames[0],
+        sample_frames[len(sample_frames) // 2],
+        sample_frames[-1],
+    ]
+    rows = []
+    for name, _profile in candidates:
+        row = []
+        for frame_index in key_frames:
+            for camera in CAMERAS:
+                image = cv2.cvtColor(
+                    cv2.imread(
+                        str(
+                            output_dir
+                            / name
+                            / f"frame-{frame_index:04d}-{camera}.png"
+                        )
+                    ),
+                    cv2.COLOR_BGR2RGB,
+                )
+                row.append(
+                    labeled_thumbnail(
+                        image,
+                        f"{name} | {camera} | f{frame_index}",
+                        width=240,
+                        height=150,
+                    )
+                )
+        rows.append(np.concatenate(row, axis=1))
+    sheet = np.concatenate(rows, axis=0)
+    cv2.imwrite(
+        str(output_dir / "comparison-all-cameras-keyframes.png"),
+        cv2.cvtColor(sheet, cv2.COLOR_RGB2BGR),
+    )
+
+
+def aggregate_metrics(
+    frame_metrics: dict[str, dict[str, dict]],
+) -> dict[str, dict[str, float]]:
+    result: dict[str, dict[str, float]] = {}
+    for camera in CAMERAS:
+        samples = [frame[camera] for frame in frame_metrics.values()]
+        keys = samples[0]
+        result[camera] = {
+            key: float(np.mean([sample[key] for sample in samples]))
+            for key in keys
+        }
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--candidate",
+        action="append",
+        type=parse_candidate,
+        required=True,
+    )
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument(
+        "--sample-frames",
+        default="0,108,216,324,432,540,648",
+    )
+    args = parser.parse_args()
+
+    sample_frames = sorted(
+        {int(value) for value in args.sample_frames.split(",")}
+    )
+    trajectory = np.load(args.trajectory)
+    actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    if sample_frames[0] < 0 or sample_frames[-1] >= len(actions):
+        parser.error(
+            f"sample frames must fall in [0, {len(actions) - 1}]"
+        )
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    report: dict[str, object] = {
+        "schema_version": 1,
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": seed,
+        "trajectory_frames": len(actions),
+        "sample_frames": sample_frames,
+        "strict": True,
+        "candidates": {},
+    }
+    for name, profile in args.candidate:
+        candidate_dir = args.output_dir / name
+        candidate_dir.mkdir(parents=True, exist_ok=True)
+        env = build_env(
+            "DishwasherUnloadCutleryLong",
+            visual_shell_profile=str(profile.resolve()),
+            visual_shell_strict=True,
+        )
+        started = time.perf_counter()
+        try:
+            env.reset(seed=seed)
+            frame_metrics: dict[str, dict[str, dict]] = {}
+            images, metrics = capture_cameras(env)
+            frame_metrics["0"] = metrics
+            for camera, image in images.items():
+                cv2.imwrite(
+                    str(candidate_dir / f"frame-0000-{camera}.png"),
+                    cv2.cvtColor(image, cv2.COLOR_RGB2BGR),
+                )
+            for action_index in range(sample_frames[-1]):
+                env.step(actions[action_index], fast=True)
+                frame_index = action_index + 1
+                if frame_index not in sample_frames:
+                    continue
+                images, metrics = capture_cameras(env)
+                frame_metrics[str(frame_index)] = metrics
+                for camera, image in images.items():
+                    cv2.imwrite(
+                        str(
+                            candidate_dir
+                            / f"frame-{frame_index:04d}-{camera}.png"
+                        ),
+                        cv2.cvtColor(image, cv2.COLOR_RGB2BGR),
+                    )
+            candidate_report = {
+                "profile": str(profile.resolve()),
+                "elapsed_seconds": float(time.perf_counter() - started),
+                "rendered_frames": int(env._visual_shell.rendered_frames),
+                "last_error": env._visual_shell.last_error,
+                "frame_metrics": frame_metrics,
+                "mean_metrics": aggregate_metrics(frame_metrics),
+            }
+            report["candidates"][name] = candidate_report
+        finally:
+            env.close()
+            del env
+            import torch
+
+            torch.cuda.empty_cache()
+    write_contact_sheets(
+        args.output_dir,
+        args.candidate,
+        sample_frames,
+    )
+    report_path = args.output_dir / "render-comparison-report.json"
+    report_path.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
