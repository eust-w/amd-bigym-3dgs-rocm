+#!/usr/bin/env python3
+"""Write a receipt when the four-camera preflight blocks formal collection."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import FOUR_CAMERA_SET, resolve_camera_set
+from run_receipt import (
+    evidence_report_snapshot,
+    profile_snapshot,
