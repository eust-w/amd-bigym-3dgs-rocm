+from __future__ import annotations
+
+import numpy as np
+import mujoco
+
+from d.replay_generation.search_visual_shell_appearance import (
+    _capture_path_gate,
+    _rank_key,
+    _candidate_set,
+    _gate_candidate,
+    _geom_local_corners,
+    _metric_room_candidate_set,
+    _metric_room_coverage,
+    _metric_room_refined_candidate_set,
+    _task_context_mask,
+    _task_context_metrics,
+)
+
+
+def test_task_context_mask_covers_full_task_region_but_excludes_seam() -> None:
+    foreground = np.zeros((81, 81), dtype=bool)
+    foreground[38:43, 38:43] = True
+
+    context = _task_context_mask(
+        foreground,
+        inner_radius_px=3,
+        outer_radius_px=12,
+    )
+
+    assert context[40, 40]
+    assert not context[40, 44]
+    assert context[40, 49]
+    assert not context[0, 0]
+
+
+def test_task_context_metric_prefers_sharp_structure_over_flat_fog() -> None:
+    height = width = 160
+    foreground = np.zeros((height, width), dtype=bool)
+    foreground[65:95, 65:95] = True
+    alpha = np.ones((height, width), dtype=np.float32)
+    yy, xx = np.indices((height, width))
+    checker = ((xx // 8 + yy // 8) % 2 * 180 + 35).astype(np.uint8)
+    sharp = np.repeat(checker[..., None], 3, axis=-1)
+    fog = np.full_like(sharp, 128)
+
+    sharp_metrics = _task_context_metrics(
+        sharp,
+        alpha,
+        foreground,
+        inner_radius_px=4,
+        outer_radius_px=35,
+    )
+    fog_metrics = _task_context_metrics(
+        fog,
+        alpha,
+        foreground,
+        inner_radius_px=4,
+        outer_radius_px=35,
+    )
+
+    assert sharp_metrics["task_context_gaussian_coverage"] > 0.9
+    assert sharp_metrics["task_context_luma_std"] > 50.0
+    assert sharp_metrics["task_context_edge_density"] > 0.05
+    assert sharp_metrics["task_context_largest_problem_component_fraction"] == 0.0
+    assert (
+        sharp_metrics["task_context_clear_score"]
+        > fog_metrics["task_context_clear_score"] + 0.4
+    )
+
+
+def test_candidate_set_is_deterministic_and_respects_search_bounds() -> None:
+    kwargs = {
+        "scale_range": (0.8, 1.1),
+        "yaw_limit_degrees": 22.0,
+        "translation_xy_limit_m": 0.3,
+        "translation_z_limit_m": 0.07,
+    }
+    first = _candidate_set(40, 17, **kwargs)
+    second = _candidate_set(40, 17, **kwargs)
+
+    assert first == second
+    assert len(first) == 40
+    assert all(0.8 <= item["scale"] <= 1.1 for item in first)
+    assert all(abs(item["yaw"]) <= 22.0 for item in first)
+    assert all(abs(item["x"]) <= 0.3 for item in first)
+    assert all(abs(item["y"]) <= 0.3 for item in first)
+    assert all(abs(item["z"]) <= 0.07 for item in first)
+
+
+def _summary(clear: float, coverage: float = 0.99, conflict: float = 0.0) -> dict:
+    return {
+        "frame_count": 7,
+        "coverage": {"p10": coverage, "mean": coverage, "maximum": coverage},
+        "holes": {"p10": 0.0, "mean": 0.0, "maximum": 0.0},
+        "semitransparent": {"p10": 0.0, "mean": 0.0, "maximum": 0.0},
+        "severe_fog": {"p10": 0.0, "mean": 0.0, "maximum": 0.0},
+        "largest_problem_component": {
+            "p10": 0.0,
+            "mean": 0.0,
+            "maximum": 0.0,
+        },
+        "clear_score": {"p10": clear, "mean": clear, "maximum": clear},
+        "edge_density": {"p10": 0.1, "mean": 0.1, "maximum": 0.1},
+        "dark_fraction": {"p10": 0.0, "mean": 0.0, "maximum": 0.0},
+        "bright_fraction": {"p10": 0.0, "mean": 0.0, "maximum": 0.0},
+        "depth_conflict": {"p10": conflict, "mean": conflict, "maximum": conflict},
+    }
+
+
+def test_gate_requires_all_three_formal_cameras_and_external_cannot_substitute() -> None:
+    cameras = ("head", "left_wrist", "right_wrist")
+    baseline = {name: _summary(0.4) for name in cameras}
+    metrics = []
+    for name in cameras:
+        score = 0.45 if name != "right_wrist" else 0.2
+        for frame in range(7):
+            metrics.append({
+                "camera": name, "frame": frame,
