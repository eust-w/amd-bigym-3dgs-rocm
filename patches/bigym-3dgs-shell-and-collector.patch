@@ -0,0 +1,948 @@
+"""bigym_plus demo -> LeRobot Dataset v3 (lerobot 0.6.0 / py3.12).
+
+两种生成模式:
+  --group <组名>  组合并模式: 每组一个 dataset (repo_id=bigym_plus/<组>), 组内多个
+                  原始任务用各自的 language prompt 组织 (lerobot 自动建 tasks.parquet,
+                  task_index -> prompt 区分). 4 组见 groups.py.
+  --task <任务名> 单任务模式: 每个任务一个独立 dataset (repo_id=bigym_plus/<任务>),
+                  40 个任务可单独生成.
+
+Probe 语义: 每个任务顺序尝试可用 demos, 直到保存首条 replay success 的 episode.
+失败候选写入 run-receipt.json, 但不计入目标 episode 数.
+
+维度全局统一 16 (base[X,Y,Z,RZ] + arm10 + gripper2). 3-DOF 任务 (ReachTarget /
+ReachTargetSingle / ReachTargetDual / MovePlate / MoveTwoPlates, 共 15 维) 用
+dim_utils.pad_to_16 在 base index 2 pad 一个 Z (值 0.0); 4-DOF (16 维) 原样.
+state 与 action 都 pad. 转换逻辑与评测同源 (dim_utils.py), 保证生成-评测一致.
+
+注意 env.step() 用原始维度 action (15 或 16, 匹配该任务 env); pad 只作用于写进
+dataset 的 state/action.
+
+断点续传: 目录已存在 (非 --force) 用 LeRobotDataset.resume() 追加, progress.json
+记录已加的 (task, demo_idx), 重跑跳过, episode_index 由 lerobot 续编. --force 删
+目录从头建.
+
+用法:
+  MUJOCO_GL=egl python generate_dataset.py --task ReachTargetDual --probe   # 单任务探针
+  MUJOCO_GL=egl python generate_dataset.py --task ReachTargetDual           # 单任务全量
+  MUJOCO_GL=egl python generate_dataset.py --group reach --probe            # 组探针
+  MUJOCO_GL=egl python generate_dataset.py --group all                      # 4 组全量
+  MUJOCO_GL=egl python generate_dataset.py --group all --amount 12          # 每任务限 12 条
+"""
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from tasks import TASKS, FREQ, resolve_task, action_dim, task_to_snake  # noqa: E402
+from env_utils import (  # noqa: E402
+    CAMERA_SETS,
+    DEFAULT_CAMERA_SET,
+    FOUR_CAMERA_SET,
+    build_env,
+    get_state,
+    resolve_camera_set,
+)
+from dim_utils import pad_to_16, UNIFORM_DIM  # noqa: E402
+from groups import GROUPS_DICT, repo_id, group_summary, all_group_keys  # noqa: E402
+from run_receipt import (  # noqa: E402
+    finish_receipt,
+    new_receipt,
+    record_environment,
+    write_receipt,
+)
+from replay_plan import load_replay_plan, plan_entries  # noqa: E402
+from bigym.utils.scene_placement import load_scene_placement_profile
+
+
+def build_features(camera_set=DEFAULT_CAMERA_SET):
+    """16 维统一 features: 可选 3/4 路视频 + state/action(16)."""
+    features = {}
+    for spec in resolve_camera_set(camera_set):
+        features[f"observation.images.{spec.lr_key}"] = {
+            "dtype": "video",
+            "shape": (3, spec.resolution[0], spec.resolution[1]),
+            "names": ["channels", "height", "width"],
+        }
+    features["observation.state"] = {"dtype": "float32", "shape": (UNIFORM_DIM,), "names": None}
+    features["action"] = {"dtype": "float32", "shape": (UNIFORM_DIM,), "names": None}
+    return features
+
+
+def _candidate_total(tasks, amount):
+    """Return the number of unique official demo candidates in this run."""
+    return sum(
+        TASKS[task]["n_demos"]
+        if amount is None
+        else min(amount, TASKS[task]["n_demos"])
+        for task in tasks
+    )
+
+
+def _target(tasks, amount, probe, target_successful_episodes=None):
+    """目标 episode 数 (probe 每任务 1 条, 否则 min(amount, n_demos))."""
+    if target_successful_episodes is not None:
+        return target_successful_episodes
+    total = 0
+    for t in tasks:
+        nd = TASKS[t]["n_demos"]
+        total += 1 if probe else (nd if amount is None else min(amount, nd))
+    return total
+
+
+def _requested_demo_amount(info, amount, probe):
+    """Probe scans candidates until one replay-success episode is saved."""
+
+    if probe:
+        return info["n_demos"]
+    return info["n_demos"] if amount is None else min(amount, info["n_demos"])
+
+
+def _saved_episode_count(dataset):
+    """Return persisted episodes without counting rejected demo candidates."""
+
+    count = getattr(dataset, "num_episodes", None)
+    if count is not None:
+        return int(count)
+    meta = getattr(dataset, "meta", None)
+    info = getattr(meta, "info", {}) if meta is not None else {}
+    return int(info.get("total_episodes", 0))
+
+
+def _save_progress(path, done_set):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(sorted([list(x) for x in done_set]), f)
+    os.replace(tmp, path)
+
+
+def _actions_sha256(actions) -> str:
+    values = np.ascontiguousarray(np.asarray(actions, dtype=np.float32))
+    return hashlib.sha256(values.tobytes()).hexdigest()
+
+
+def _checkpoint_saved_episode(dataset) -> None:
+    """Make one saved episode independently readable before progress advances.
+
+    LeRobot v3 normally keeps both data and episode-metadata Parquet writers
+    open, and buffers up to ten metadata rows.  A container restart can then
+    leave valid videos next to a Parquet file without a footer.  Formal A800
+    collection uses one closed data/meta/video file set per episode so the
+    progress checkpoint never points at an unreadable episode.
+    """
+
+    from lerobot.datasets.dataset_metadata import load_episodes
+
+    meta = dataset.meta
+    meta._metadata_buffer_size = 1
+    meta._flush_metadata_buffer()
+    dataset.writer.close_writer()
+    meta._close_writer()
+    meta.episodes = load_episodes(meta.root)
+    meta.latest_episode = None
+    dataset.writer._latest_episode = None
+
+
+def _absolute_dataset_action(env, source_action) -> np.ndarray:
+    """Convert a source action to the one canonical dataset representation.
+
+    Floating-base commands are always delta in BiGym and grippers are direct
+    commands in both modes.  Only limb controls need accumulating when the
+    source demonstration uses ``JointPositionActionMode(absolute=False)``.
+    This conversion is evaluated before ``env.step`` so the label describes
+    the target associated with the current observation.
+    """
+
+    action = np.asarray(source_action, dtype=np.float32).copy()
+    if bool(env.action_mode.absolute):
+        return action
+    base_count = int(env.robot.floating_base.dof_amount)
+    limb_count = len(env.robot.limb_actuators)
+    limb_controls = np.asarray(
+        [
+            float(np.asarray(env.action_mode._mojo.physics.bind(act).ctrl).reshape(-1)[0])
+            for act in env.robot.limb_actuators
+        ],
+        dtype=np.float32,
+    )
+    action[base_count : base_count + limb_count] = (
+        limb_controls + action[base_count : base_count + limb_count]
+    )
+    return action
+
+
+def _write_scene_placement_metadata(dataset_root, placement) -> None:
+    if placement is None:
+        return
+    path = Path(dataset_root) / "meta" / "scene-placement.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(
+        json.dumps(placement.snapshot(), indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+    os.replace(temporary, path)
+
+
+def _parquet_has_magic(path: Path) -> bool:
+    try:
+        with path.open("rb") as stream:
+            if stream.read(4) != b"PAR1":
+                return False
+            stream.seek(-4, os.SEEK_END)
+            return stream.read(4) == b"PAR1"
+    except (OSError, ValueError):
+        return False
+
+
+def _local_resume_state(dataset_root: str | Path) -> str:
+    """Classify a local LeRobot root without falling back to the Hub."""
+
+    root = Path(dataset_root)
+    info_path = root / "meta" / "info.json"
+    if not info_path.is_file():
+        return "create"
+    info = json.loads(info_path.read_text(encoding="utf-8"))
+    total_episodes = int(info.get("total_episodes", 0))
+    total_frames = int(info.get("total_frames", 0))
+    if total_episodes == 0 and total_frames == 0:
+        return "empty_interrupted"
+    episode_files = sorted(root.glob("meta/episodes/**/*.parquet"))
+    data_files = sorted(root.glob("data/**/*.parquet"))
+    if (
+        total_episodes < 1
+        or total_frames < 1
+        or not episode_files
+        or not data_files
+        or any(not _parquet_has_magic(path) for path in (*episode_files, *data_files))
+    ):
+        return "corrupt_interrupted"
+    return "resume"
+
+
+def _open_or_resume(
+    rid,
+    dataset_root,
+    force,
+    vcodec,
+    image_writer_threads,
+    camera_set,
+):
+    """返回 (dataset, done_set, progress_path).
+    force: 删目录重建 (create); 目录已存在: resume + 读 progress; 否则: create."""
+    from lerobot.datasets.lerobot_dataset import LeRobotDataset
+    from lerobot.configs import RGBEncoderConfig
+
+    progress_path = os.path.join(dataset_root, "progress.json")
+    rgb_encoder = RGBEncoderConfig(vcodec=vcodec) if vcodec else None
+
+    if force and os.path.exists(dataset_root):
+        print(f"    --force: 删除已存在 {dataset_root}")
+        shutil.rmtree(dataset_root)
+
+    done_set = set()
+    resume_state = _local_resume_state(dataset_root) if not force else "create"
+    if resume_state == "empty_interrupted":
+        root = Path(dataset_root)
+        quarantine = root.with_name(
+            f"{root.name}.empty-interrupted-{int(time.time())}"
+        )
+        root.replace(quarantine)
+        print(f"    RECOVER: 隔离 0-episode 中断目录 -> {quarantine}")
+        resume_state = "create"
+    if resume_state == "corrupt_interrupted":
+        raise RuntimeError(
+            "local dataset is incomplete or has an unclosed Parquet file; "
+            "refusing LeRobot Hub fallback"
+        )
+
+    if resume_state == "resume":
+        dataset = LeRobotDataset.resume(
+            repo_id=rid, root=dataset_root, rgb_encoder=rgb_encoder,
+            image_writer_threads=image_writer_threads,
+        )
+        if os.path.exists(progress_path):
+            try:
+                done_set = {tuple(x) for x in json.load(open(progress_path))}
+            except Exception:
+                done_set = set()
+        print(f"    RESUME: 跳过 {len(done_set)} 条已加 demo")
+    else:
+        dataset = LeRobotDataset.create(
+            repo_id=rid,
+            fps=FREQ,
+            features=build_features(camera_set),
+            root=dataset_root,
+            use_videos=True, image_writer_threads=image_writer_threads,
+            rgb_encoder=rgb_encoder,
+        )
+    # A formal collection must be resumable after every successful episode.
+    # The default LeRobot v3 metadata buffer (10) is not crash-safe.
+    dataset.meta._metadata_buffer_size = 1
+    print(f"    dataset 就绪 (vcodec={vcodec or 'libsvtav1(default)'})")
+    return dataset, done_set, progress_path
+
+
+def _check_skip(dataset_root, target_total, probe):
+    """resume 后若已达标且非 probe, 返回 True (SKIP)."""
+    if probe:
+        return False
+    info_path = os.path.join(dataset_root, "meta", "info.json")
+    if os.path.exists(info_path):
+        try:
+            done = json.load(open(info_path)).get("total_episodes", 0)
+            if done >= target_total:
+                print(f"    SKIP: 已有 {done} episodes (>= {target_total}), 用 --force 重跑")
+                return True
+        except Exception:
+            pass
+    return False
+
+
+def _collect_tasks(
+    dataset,
+    tasks,
+    amount,
+    probe,
+    done_set,
+    progress_path,
+    target_total,
+    keep_failures=False,
+    visual_shell_profile=None,
+    visual_shell_strict=True,
+    demo_seed=None,
+    camera_set=DEFAULT_CAMERA_SET,
+    scene_placement_profile=None,
+    run_receipt=None,
+    receipt_path=None,
+    replay_plan=None,
+):
+    """把 tasks 列表里每个任务的 demo replay 进 dataset. 返回新增 episode 数."""
+    from demonstrations.demo_store import DemoStore
+    from demonstrations.utils import Metadata
+
+    n_done = _saved_episode_count(dataset)
+    t_start = time.time()
+    for ti, task in enumerate(tasks):
+        if n_done >= target_total:
+            break
+        info = TASKS[task]
+        prompt = info["prompt"]
+        amt = _requested_demo_amount(info, amount, probe)
+        selected_entries = plan_entries(replay_plan, task) if replay_plan else None
+        source_groups = []
+        if selected_entries is None:
+            source_groups.append(("absolute", None))
+        else:
+            for representation in ("absolute", "delta"):
+                entries = [
+                    entry
+                    for entry in selected_entries
+                    if entry["source_action_representation"] == representation
+                ]
+                if entries:
+                    source_groups.append((representation, entries))
+
+        for source_representation, source_entries in source_groups:
+            if n_done >= target_total:
+                break
+            env_started = time.perf_counter()
+            env = build_env(
+                task,
+                action_absolute=source_representation == "absolute",
+                camera_set=camera_set,
+                visual_shell_profile=visual_shell_profile,
+                visual_shell_strict=visual_shell_strict,
+                scene_placement_profile=scene_placement_profile,
+            )
+            try:
+                mojo = env.action_mode._mojo
+                metadata = Metadata.from_env(env, is_lightweight=True)
+                demos = DemoStore().get_demos(
+                    metadata,
+                    amount=-1 if source_entries is not None else amt,
+                    frequency=FREQ,
+                )
+                all_indexed_demos = list(enumerate(demos))
+                entry_by_uuid = (
+                    {entry["demo_uuid"]: entry for entry in source_entries}
+                    if source_entries is not None
+                    else {}
+                )
+                if source_entries is None:
+                    indexed_demos = [
+                        (index, demo, None) for index, demo in all_indexed_demos
+                    ]
+                else:
+                    demo_by_uuid = {
+                        str(demo.uuid): (index, demo)
+                        for index, demo in all_indexed_demos
+                    }
+                    missing = sorted(set(entry_by_uuid) - set(demo_by_uuid))
+                    if missing:
+                        raise RuntimeError(
+                            f"{task}/{source_representation}: replay-plan demos "
+                            f"are missing: {missing}"
+                        )
+                    indexed_demos = [
+                        (*demo_by_uuid[entry["demo_uuid"]], entry)
+                        for entry in source_entries
+                    ]
+            except Exception:
+                env.close()
+                raise
+            if demo_seed is not None:
+                indexed_demos = [
+                    (index, demo, entry)
+                    for index, demo, entry in indexed_demos
+                    if int(getattr(demo, "seed", -1)) == demo_seed
+                ]
+                if not indexed_demos:
+                    raise RuntimeError(
+                        f"{task}: requested demo seed not found: {demo_seed}"
+                    )
+            probe_suffix = " candidates for 1 successful episode" if probe else " demos"
+            print(f"  [{ti + 1}/{len(tasks)}] {task}: "
+                  f"{len(indexed_demos)}{probe_suffix}, "
+                  f"source={source_representation}, "
+                  f"dim={action_dim(task)}, prompt={prompt!r}")
+            for di, demo, replay_entry in indexed_demos:
+                demo_uuid = str(demo.uuid)
+                progress_key = (
+                    (task, source_representation, demo_uuid)
+                    if replay_plan is not None
+                    else (task, di)
+                )
+                if progress_key in done_set:
+                    continue
+                t_ep = time.time()
+                try:
+                    canonical_actions = [
+                        np.asarray(ts.executed_action, dtype=np.float32)
+                        for ts in demo.timesteps
+                    ]
+                    actions = (
+                        [
+                            env.scene_placement.transform_action(
+                                action,
+                                info["floating_dofs"],
+                            )
+                            for action in canonical_actions
+                        ]
+                        if env.scene_placement is not None
+                        else canonical_actions
+                    )
+                except Exception as e:
+                    print(f"    demo {di}: actions fail {e}")
+                    continue
+                T = len(actions)
+                if T < 2:
+                    continue
+                try:
+                    episode_seed = getattr(demo, "seed", None)
+                    obs, _ = env.reset(seed=episode_seed)
+                except Exception as e:
+                    print(f"    demo {di}: reset fail {e}")
+                    continue
+                dataset_actions = []
+                for t in range(T - 1):  # 丢最后一帧 (无 next obs)
+                    state = get_state(env.robot, obs, mojo)
+                    raw_action = actions[t]
+                    dataset_action = _absolute_dataset_action(env, raw_action)
+                    dataset_actions.append(dataset_action)
+                    frame = {
+                        **{
+                            f"observation.images.{spec.lr_key}": obs[
+                                f"rgb_{spec.name}"
+                            ]
+                            for spec in resolve_camera_set(camera_set)
+                        },
+                        "observation.state": pad_to_16(state, task),
+                        "action": pad_to_16(dataset_action, task),
+                        "task": prompt,
+                    }
+                    dataset.add_frame(frame)
+                    obs, _r, _term, _trunc, _info = env.step(raw_action)
+                # replay success 过滤 (口径同 check_demo_success: env.reward>0)
+                if not keep_failures and env.reward <= 0:
+                    print(f"    demo {di}: replay 未达 success (reward={env.reward}), 丢弃")
+                    try:
+                        dataset.clear_episode_buffer()
+                    except Exception as e:
+                        print(f"    demo {di}: clear_episode_buffer fail {e}")
+                    done_set.add(progress_key)
+                    _save_progress(progress_path, done_set)
+                    if run_receipt is not None:
+                        run_receipt["episodes"].append(
+                            {
+                                "task": task,
+                                "demo_index": di,
+                                "demo_uuid": demo_uuid,
+                                "seed": episode_seed,
+                                "frames": T - 1,
+                                "reward": float(env.reward),
+                                "saved": False,
+                                "reason": "replay_not_successful",
+                                "source_action_representation": source_representation,
+                                "dataset_action_representation": "absolute",
+                                "verified_mode": (
+                                    replay_entry.get("verified_mode")
+                                    if replay_entry is not None
+                                    else None
+                                ),
+                                "canonical_actions_sha256": _actions_sha256(
+                                    canonical_actions
+                                ),
+                                "placed_actions_sha256": _actions_sha256(actions),
+                                "dataset_actions_sha256": _actions_sha256(
+                                    dataset_actions
+                                ),
+                            }
+                        )
+                    continue
+                try:
+                    dataset.save_episode()
+                    _checkpoint_saved_episode(dataset)
+                except Exception as e:
+                    print(f"    demo {di}: save_episode fail {e}")
+                    try:
+                        dataset.clear_episode_buffer()
+                    except Exception:
+                        pass
+                    continue
+                n_done += 1
+                done_set.add(progress_key)
+                _save_progress(progress_path, done_set)
+                dt = time.time() - t_ep
+                if run_receipt is not None:
+                    run_receipt["episodes"].append(
+                        {
+                            "task": task,
+                            "demo_index": di,
+                            "demo_uuid": demo_uuid,
+                            "seed": episode_seed,
+                            "frames": T - 1,
+                            "reward": float(env.reward),
+                            "saved": True,
+                            "elapsed_seconds": dt,
+                            "source_action_representation": source_representation,
+                            "dataset_action_representation": "absolute",
+                            "verified_mode": (
+                                replay_entry.get("verified_mode")
+                                if replay_entry is not None
+                                else None
+                            ),
+                            "canonical_actions_sha256": _actions_sha256(
+                                canonical_actions
+                            ),
+                            "placed_actions_sha256": _actions_sha256(actions),
+                            "dataset_actions_sha256": _actions_sha256(
+                                dataset_actions
+                            ),
+                        }
+                    )
+                eta = (
+                    (time.time() - t_start)
+                    / max(n_done, 1)
+                    * max(target_total - n_done, 0)
+                )
+                print(f"    demo {di}: {T - 1} frames {dt:.1f}s "
+                      f"(累计 {n_done}/{target_total}, eta {eta / 60:.1f}min)")
+                if probe or n_done >= target_total:
+                    break
+            if run_receipt is not None:
+                record_environment(
+                    run_receipt,
+                    env=env,
+                    task=task,
+                    elapsed_seconds=time.perf_counter() - env_started,
+                )
+                if receipt_path is not None:
+                    write_receipt(receipt_path, run_receipt)
+            env.close()
+    return n_done
+
+
+def _run(rid, dataset_root, tasks, label, n_demos_total, amount, probe, force,
+         vcodec, image_writer_threads, keep_failures=False,
+         visual_shell_profile=None, visual_shell_strict=True, demo_seed=None,
+         camera_set=DEFAULT_CAMERA_SET, world_lock_report=None,
+         visual_acceptance_report=None, scene_placement_profile=None,
+         target_successful_episodes=None, replay_plan_path=None):
+    """通用采集入口: 开 dataset -> (skip 检查) -> collect -> finalize."""
+    if camera_set == FOUR_CAMERA_SET and visual_shell_profile is not None:
+        if not world_lock_report or not visual_acceptance_report:
+            raise RuntimeError(
+                "four-camera visual-shell collection requires world-lock "
+                "and visual-acceptance reports"
+            )
+        world_lock = json.loads(
+            Path(world_lock_report).read_text(encoding="utf-8")
+        )
+        acceptance = json.loads(
+            Path(visual_acceptance_report).read_text(encoding="utf-8")
+        )
+        if world_lock.get("status") != "passed":
+            raise RuntimeError("world-lock report did not pass")
+        if (
+            acceptance.get("status") != "passed"
+            or acceptance.get("formal_collection_allowed") is not True
+        ):
+            raise RuntimeError(
+                "visual-acceptance report forbids formal collection"
+            )
+    replay_plan = (
+        load_replay_plan(replay_plan_path, expected_tasks=tasks)
+        if replay_plan_path is not None
+        else None
+    )
+    if replay_plan is not None:
+        planned_target = sum(
+            replay_plan["tasks"][task]["requested"] for task in tasks
+        )
+        if (
+            target_successful_episodes is not None
+            and target_successful_episodes != planned_target
+        ):
+            raise ValueError(
+                "--target-successful-episodes does not match replay plan: "
+                f"{target_successful_episodes} != {planned_target}"
+            )
+        target_total = planned_target
+        candidate_total = sum(
+            replay_plan["tasks"][task]["available"] for task in tasks
+        )
+    else:
+        candidate_total = _candidate_total(tasks, amount)
+        target_total = _target(
+            tasks,
+            amount,
+            probe,
+            target_successful_episodes=target_successful_episodes,
+        )
+    if target_total > candidate_total:
+        raise ValueError(
+            "target successful episodes exceeds unique demo candidates: "
+            f"{target_total} > {candidate_total}"
+        )
+    placement = (
+        load_scene_placement_profile(
+            scene_placement_profile,
+            expected_task=tasks[0],
+        )
+        if scene_placement_profile is not None
+        else None
+    )
+    if placement is not None and len(tasks) != 1:
+        raise RuntimeError("placed-world collection supports exactly one task")
+    print(f"\n=== {label}: {len(tasks)} 任务 / {n_demos_total} demos ===")
+    print(f"    repo_id={rid}  root={dataset_root}  target_episodes={target_total}")
+    dataset, done_set, progress_path = _open_or_resume(
+        rid,
+        dataset_root,
+        force,
+        vcodec,
+        image_writer_threads,
+        camera_set,
+    )
+    receipt_path = os.path.join(dataset_root, "run-receipt.json")
+    receipt = new_receipt(
+        mode="probe" if probe else "generation",
+        tasks=list(tasks),
+        output_root=dataset_root,
+        visual_shell_profile=visual_shell_profile,
+        visual_shell_strict=visual_shell_strict,
+        camera_set=camera_set,
+        cameras=resolve_camera_set(camera_set),
+        world_lock_report=world_lock_report,
+        visual_acceptance_report=visual_acceptance_report,
+        scene_placement=placement,
+    )
+    _write_scene_placement_metadata(dataset_root, placement)
+    receipt["requested_demo_seed"] = demo_seed
+    receipt["replay_plan"] = (
+        {
+            "path": str(Path(replay_plan_path).resolve()),
+            "sha256": hashlib.sha256(
+                Path(replay_plan_path).read_bytes()
+            ).hexdigest(),
+            "status": replay_plan["status"],
+            "dataset_action_representation": replay_plan[
+                "dataset_action_representation"
+            ],
+        }
+        if replay_plan is not None
+        else None
+    )
+    receipt["collection_target"] = {
+        "successful_episodes": target_total,
+        "unique_demo_candidates": candidate_total,
+        "stop_when_target_reached": target_successful_episodes is not None,
+        "failed_replays_are_saved": keep_failures,
+    }
+    receipt["formal_camera_policy"] = {
+        "required_cameras": [camera.name for camera in resolve_camera_set(camera_set)],
+        "external_is_formal": camera_set == FOUR_CAMERA_SET,
+        "canonical_three_camera_baseline": (
+            camera_set == DEFAULT_CAMERA_SET and scene_placement_profile is None
+        ),
+    }
+    write_receipt(receipt_path, receipt)
+    if _check_skip(dataset_root, target_total, probe):
+        dataset.finalize()
+        finish_receipt(
+            receipt,
+            status="skipped",
+            technical_status="not_run_already_complete",
+        )
+        write_receipt(receipt_path, receipt)
+        return
+    try:
+        n = _collect_tasks(
+            dataset,
+            tasks,
+            amount,
+            probe,
+            done_set,
+            progress_path,
+            target_total,
+            keep_failures=keep_failures,
+            visual_shell_profile=visual_shell_profile,
+            visual_shell_strict=visual_shell_strict,
+            demo_seed=demo_seed,
+            camera_set=camera_set,
+            scene_placement_profile=scene_placement_profile,
+            run_receipt=receipt,
+            receipt_path=receipt_path,
+            replay_plan=replay_plan,
+        )
+        dataset.finalize()
+    except Exception as exc:
+        finish_receipt(
+            receipt,
+            status="failed",
+            technical_status="failed",
+            error=f"{type(exc).__name__}: {exc}",
+        )
+        write_receipt(receipt_path, receipt)
+        raise
+    finish_receipt(
+        receipt,
+        status="complete" if n >= target_total else "partial",
+        technical_status="passed" if n >= target_total else "incomplete",
+    )
+    write_receipt(receipt_path, receipt)
+    print(f"    DONE {label}: {n} episodes -> {dataset_root}")
+
+
+def gen_group(group_key, root, amount=None, probe=False, force=False,
+              vcodec=None, image_writer_threads=4, keep_failures=False,
+              visual_shell_profile=None, visual_shell_strict=True,
+              demo_seed=None, camera_set=DEFAULT_CAMERA_SET,
+              world_lock_report=None, visual_acceptance_report=None,
+              scene_placement_profile=None, target_successful_episodes=None,
+              replay_plan_path=None):
+    name, tasks = GROUPS_DICT[group_key]
+    _, _n_tasks, n_demos_total, dim_dist = group_summary(group_key)
+    label = f"组 [{group_key}] {name} (维度分布 {dim_dist})"
+    _run(repo_id(group_key), os.path.join(root, group_key), tasks,
+         label, n_demos_total, amount, probe, force, vcodec, image_writer_threads,
+         keep_failures=keep_failures,
+         visual_shell_profile=visual_shell_profile,
+         visual_shell_strict=visual_shell_strict,
+         demo_seed=demo_seed,
+         camera_set=camera_set,
+         world_lock_report=world_lock_report,
+         visual_acceptance_report=visual_acceptance_report,
+         scene_placement_profile=scene_placement_profile,
+         target_successful_episodes=target_successful_episodes,
+         replay_plan_path=replay_plan_path)
+
+
+def gen_task(task_key, root, amount=None, probe=False, force=False,
+             vcodec=None, image_writer_threads=4, keep_failures=False,
+             visual_shell_profile=None, visual_shell_strict=True,
+             demo_seed=None, camera_set=DEFAULT_CAMERA_SET,
+             world_lock_report=None, visual_acceptance_report=None,
+             scene_placement_profile=None, target_successful_episodes=None,
+             replay_plan_path=None):
+    task = resolve_task(task_key)
+    snake = task_to_snake(task)
+    label = f"单任务 [{task}] (dim={action_dim(task)})"
+    namespace = "bigym_plus_placed_world" if scene_placement_profile else "bigym_plus"
+    _run(f"{namespace}/{snake}", os.path.join(root, snake), [task],
+         label, TASKS[task]["n_demos"], amount, probe, force, vcodec, image_writer_threads,
+         keep_failures=keep_failures,
+         visual_shell_profile=visual_shell_profile,
+         visual_shell_strict=visual_shell_strict,
+         demo_seed=demo_seed,
+         camera_set=camera_set,
+         world_lock_report=world_lock_report,
+         visual_acceptance_report=visual_acceptance_report,
+         scene_placement_profile=scene_placement_profile,
+         target_successful_episodes=target_successful_episodes,
+         replay_plan_path=replay_plan_path)
+
+
+def parse_args(argv=None):
+    ap = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)
+    ap.add_argument("--group", default=None, help=f"组名 {all_group_keys()} 或 all")
+    ap.add_argument("--task", default=None, help="单任务名 (PascalCase 或 snake_case)")
+    ap.add_argument("--amount", type=int, default=None, help="每个任务的 demo 上限 (默认全量)")
+    ap.add_argument(
+        "--target-successful-episodes",
+        type=int,
+        default=None,
+        help=(
+            "跨所选任务累计保存的成功 episode 目标；扫描唯一官方 demo，"
+            "失败不计数，达到目标立即停止"
+        ),
+    )
+    ap.add_argument(
+        "--replay-plan",
+        default=None,
+        help=(
+            "物理预检通过的 replay-plan.json；只渲染计划内 UUID，delta 源动作"
+            "会转换成统一 absolute 数据标签，数量不足时在创建数据集前阻断"
+        ),
+    )
+    ap.add_argument(
+        "--probe",
+        action="store_true",
+        help="每任务顺序尝试 demos, 保存首条 replay success episode (验证管线)",
+    )
+    ap.add_argument("--root", default="data", help="数据集根目录 (相对 cwd)")
+    ap.add_argument("--vcodec", default=None, help="视频编码 (默认 libsvtav1; 不可用改 h264)")
+    ap.add_argument("--force", action="store_true", help="删除已存在目录, 从头重建")
+    ap.add_argument("--image-writer-threads", type=int, default=4)
+    ap.add_argument("--keep-failures", action="store_true",
+                    help="不过滤 replay 失败的 demo (默认丢弃未达 success 的; 加此开关保留旧行为)")
+    ap.add_argument(
+        "--visual-shell-profile",
+        default=None,
+        help="3DGS 纯视觉壳 profile 路径或已注册名称",
+    )
+    ap.add_argument(
+        "--visual-shell-strict",
+        action=argparse.BooleanOptionalAction,
+        default=True,
+        help="视觉壳失败时立即中止；正式采集保持开启",
+    )
+    ap.add_argument(
+        "--demo-seed",
+        type=int,
+        default=None,
+        help="probe 时只采集指定 demonstration seed，保证前后对比同轨迹",
+    )
+    ap.add_argument(
+        "--camera-set",
+        choices=sorted(CAMERA_SETS),
+        default=DEFAULT_CAMERA_SET,
+        help="相机集合；四路模式新增固定 external 正式视频特征",
+    )
+    ap.add_argument(
+        "--scene-placement-profile",
+        default=None,
+        help="placed-world SE(2) profile；仅支持 DishwasherUnloadCutleryLong",
+    )
+    ap.add_argument(
+        "--world-lock-report",
+        help="四路 3DGS 正式采集前通过的 world-lock-report.json",
+    )
+    ap.add_argument(
+        "--visual-acceptance-report",
+        help="同时通过世界锁定与相机覆盖门禁的验收报告",
+    )
+    return ap, ap.parse_args(argv)
+
+
+def main(argv=None):
+    ap, args = parse_args(argv)
+
+    if args.task and args.group:
+        ap.error("--task 与 --group 互斥, 只选其一")
+    if not args.task and not args.group:
+        ap.error("必须指定 --task <任务名> 或 --group <组名|all>")
+    if args.demo_seed is not None and not args.probe:
+        ap.error("--demo-seed 仅用于 --probe")
+    if args.target_successful_episodes is not None:
+        if args.target_successful_episodes < 1:
+            ap.error("--target-successful-episodes 必须大于 0")
+        if args.probe:
+            ap.error("--target-successful-episodes 与 --probe 互斥")
+        if args.keep_failures:
+            ap.error("--target-successful-episodes 不允许配合 --keep-failures")
+    if args.demo_seed is not None and args.group:
+        ap.error("--demo-seed 仅支持单任务 --task")
+    if args.replay_plan is not None:
+        if args.probe or args.demo_seed is not None or args.keep_failures:
+            ap.error(
+                "--replay-plan 不允许配合 --probe/--demo-seed/--keep-failures"
+            )
+        if args.amount is not None:
+            ap.error("--replay-plan 的数量由计划固定，不允许再传 --amount")
+    if args.scene_placement_profile is not None and args.group:
+        ap.error("--scene-placement-profile 仅支持单任务 --task")
+    if args.scene_placement_profile is not None:
+        try:
+            load_scene_placement_profile(
+                args.scene_placement_profile,
+                expected_task=resolve_task(args.task),
+            )
+        except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
+            ap.error(f"无效 --scene-placement-profile: {exc}")
+    if (
+        args.camera_set == FOUR_CAMERA_SET
+        and args.visual_shell_profile is not None
+    ):
+        if not args.world_lock_report or not args.visual_acceptance_report:
+            ap.error(
+                "四路 3DGS 正式采集必须同时提供 "
+                "--world-lock-report 与 --visual-acceptance-report"
+            )
+        world_lock = json.loads(
+            Path(args.world_lock_report).read_text(encoding="utf-8")
+        )
+        acceptance = json.loads(
+            Path(args.visual_acceptance_report).read_text(encoding="utf-8")
+        )
+        if world_lock.get("status") != "passed":
+            ap.error("--world-lock-report 未通过")
+        if (
+            acceptance.get("status") != "passed"
+            or acceptance.get("formal_collection_allowed") is not True
+        ):
+            ap.error("--visual-acceptance-report 未授权正式采集")
+
+    kw = dict(root=args.root, amount=args.amount, probe=args.probe, force=args.force,
+              vcodec=args.vcodec, image_writer_threads=args.image_writer_threads,
+              keep_failures=args.keep_failures,
+              visual_shell_profile=args.visual_shell_profile,
+              visual_shell_strict=args.visual_shell_strict,
+              demo_seed=args.demo_seed,
+              camera_set=args.camera_set,
+              world_lock_report=args.world_lock_report,
+              visual_acceptance_report=args.visual_acceptance_report,
+              target_successful_episodes=args.target_successful_episodes,
+              replay_plan_path=args.replay_plan)
+    kw["scene_placement_profile"] = args.scene_placement_profile
+    if args.task:
+        gen_task(args.task, **kw)
+    else:
+        keys = all_group_keys() if args.group == "all" else [args.group]
+        for k in keys:
+            if k not in GROUPS_DICT:
+                print(f"未知组: {k}, 可选 {all_group_keys()}")
+                continue
+            gen_group(k, **kw)
+
+
+if __name__ == "__main__":
+    main()
