+#!/usr/bin/env python3
+"""Search a diagnostic external camera that shows H1, task, and 3DGS room.
+
+The external stream remains outside the formal LeRobot schema.  A candidate
+still has to keep landmarks from the top of H1's helmet to both feet inside a
+safe image margin for the complete recorded trajectory.  Source-camera
+coverage, task visibility, and Gaussian appearance are hard evidence gates.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Any
+
+import cv2
+import mujoco
+import numpy as np
+from scipy.spatial import cKDTree
+
+from bigym.utils.scene_placement import load_scene_placement_profile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import FOUR_CAMERA_SET, build_env
+from optimize_visual_shell_pose import (
+    MUJOCO_TO_CV_CAMERA,
+    load_source_cameras,
+    normalized_rotation,
+)
+from search_visual_shell_appearance import (
+    _pure_gaussian,
+    _task_context_metrics,
+    _task_region_from_segmentation,
+)
+
+MAX_SOURCE_TRANSLATION_M = 1.20
+MAX_SOURCE_ROTATION_DEGREES = 75.0
+
+
+def _label(image: np.ndarray, label: str) -> np.ndarray:
+    result = image.copy()
+    cv2.rectangle(result, (0, 0), (result.shape[1], 30), (0, 0, 0), -1)
+    cv2.putText(
+        result,
+        label,
+        (8, 21),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        0.48,
+        (255, 255, 255),
+        1,
+        cv2.LINE_AA,
+    )
+    return result
+
+
+def _look_at_quaternion(
+    position: np.ndarray,
+    target: np.ndarray,
+) -> np.ndarray:
+    """Return MuJoCo camera quaternion (-Z forward, +Y up)."""
+    backward = position - target
+    backward /= np.linalg.norm(backward)
+    world_up = np.asarray([0.0, 0.0, 1.0], dtype=np.float64)
+    right = np.cross(world_up, backward)
+    right /= np.linalg.norm(right)
+    up = np.cross(backward, right)
+    rotation = np.column_stack([right, up, backward])
+    quaternion = np.empty(4, dtype=np.float64)
+    mujoco.mju_mat2Quat(quaternion, rotation.reshape(-1))
+    return quaternion
+
+
+def _candidates(target_xy: np.ndarray | None = None) -> list[dict[str, Any]]:
+    # The task center deliberately sits between H1 (x ~= -0.3..0.0) and the
+    # dishwasher/cabinet line (x ~= 0.7..1.0).  The 58 degree vertical FOV
+    # requires a radius of roughly two metres to keep a 1.7 m standing H1 in
+    # frame.  North-facing candidates remain in better DL3DV source coverage;
+    # south-west candidates keep the cabinets behind the robot.
+    target_xy = np.asarray(
+        [0.15, -0.60] if target_xy is None else target_xy,
+        dtype=np.float64,
+    )
+    values = []
+    for azimuth_degrees in (70, 90, 110, 140, 170, 200, 215, 230, 245):
+        azimuth = np.radians(azimuth_degrees)
+        for distance_m in (1.8, 2.1, 2.4):
+            for height_m in (1.25, 1.45, 1.65):
+                for target_height_m in (0.78, 0.88):
+                    position_xy = target_xy + distance_m * np.asarray(
+                        [np.cos(azimuth), np.sin(azimuth)],
+                        dtype=np.float64,
+                    )
+                    name = (
+                        f"az{azimuth_degrees:03d}_d{distance_m:.1f}_"
+                        f"h{height_m:.2f}_tz{target_height_m:.2f}"
+                    )
+                    values.append(
+                        (
+                            name,
+                            (*position_xy.tolist(), height_m),
+                            (*target_xy.tolist(), target_height_m),
+                        )
+                    )
+    return [
+        {
+            "name": name,
+            "position_m": list(position),
+            "target_m": list(target),
+            "quaternion_wxyz": _look_at_quaternion(
+                np.asarray(position, dtype=np.float64),
+                np.asarray(target, dtype=np.float64),
+            ).tolist(),
+        }
+        for name, position, target in values
+    ]
+
+
+def _camera_coordinates(
+    points: np.ndarray,
+    candidate: dict[str, Any],
+) -> np.ndarray:
+    rotation = np.empty(9, dtype=np.float64)
+    mujoco.mju_quat2Mat(
+        rotation,
+        np.asarray(candidate["quaternion_wxyz"], dtype=np.float64),
+    )
+    rotation_cv = rotation.reshape(3, 3) @ np.diag([1.0, -1.0, -1.0])
+    return (
+        points - np.asarray(candidate["position_m"], dtype=np.float64)
+    ) @ rotation_cv
+
+
+def _project_landmarks(
+    landmarks: dict[str, np.ndarray],
+    candidate: dict[str, Any],
+    *,
+    height: int = 480,
+    width: int = 848,
+    fovy: float = 58.0,
+    safe_margin_fraction: float = 0.025,
+) -> dict[str, Any]:
+    """Project H1 landmarks and measure full-body framing for one frame."""
+    names = list(landmarks)
+    points = np.asarray([landmarks[name] for name in names], dtype=np.float64)
+    camera = _camera_coordinates(points, candidate)
+    focal = 0.5 * height / np.tan(np.radians(fovy) / 2.0)
+    pixels = np.column_stack(
+        [
+            focal * camera[:, 0] / camera[:, 2] + width / 2.0,
+            focal * camera[:, 1] / camera[:, 2] + height / 2.0,
+        ]
+    )
+    normalized_margins = np.column_stack(
+        [
+            pixels[:, 0] / width,
+            (width - 1.0 - pixels[:, 0]) / width,
+            pixels[:, 1] / height,
+            (height - 1.0 - pixels[:, 1]) / height,
+        ]
+    )
+    minimum_margin = float(np.min(normalized_margins))
+    in_front = bool(np.all(camera[:, 2] > 0.0))
+    left, top = np.min(pixels, axis=0)
+    right, bottom = np.max(pixels, axis=0)
+    head_index = names.index("head_top")
+    foot_indices = [names.index("left_foot"), names.index("right_foot")]
+    return {
+        "safe": bool(in_front and minimum_margin >= safe_margin_fraction),
+        "minimum_margin_fraction": minimum_margin,
+        "head_top_margin_fraction": float(pixels[head_index, 1] / height),
+        "feet_bottom_margin_fraction": float(
+            np.min((height - 1.0 - pixels[foot_indices, 1]) / height)
+        ),
+        "bbox_xyxy_normalized": [
+            float(left / width),
+            float(top / height),
+            float(right / width),
+            float(bottom / height),
+        ],
+        "horizontal_span_fraction": float((right - left) / width),
+        "vertical_span_fraction": float((bottom - top) / height),
+        "center_offset_fraction": float(
+            np.linalg.norm(
+                np.asarray(
+                    [
+                        (left + right) / (2.0 * width),
+                        (top + bottom) / (2.0 * height),
+                    ]
+                )
+                - 0.5
+            )
+        ),
+        "minimum_depth_m": float(np.min(camera[:, 2])),
+    }
+
+
+def _full_body_landmarks(model, data) -> dict[str, np.ndarray]:
+    def body(name: str) -> np.ndarray:
+        return np.asarray(data.xpos[model.body(name).id], dtype=np.float64)
+
+    helmet = np.asarray(
+        data.geom_xpos[model.geom("h1/helmet").id],
+        dtype=np.float64,
+    )
+    return {
+        "head_top": helmet + np.asarray([0.0, 0.0, 0.11]),
+        "left_shoulder": body("h1/left_shoulder_roll_link"),
+        "right_shoulder": body("h1/right_shoulder_roll_link"),
+        "left_elbow": body("h1/left_elbow_link"),
+        "right_elbow": body("h1/right_elbow_link"),
+        "left_wrist": body("h1/left_wrist_link"),
+        "right_wrist": body("h1/right_wrist_link"),
+        "pelvis": body("h1/pelvis"),
+        "left_knee": body("h1/h1_floating_base/left_knee_link"),
+        "right_knee": body("h1/h1_floating_base/right_knee_link"),
+        "left_foot": body("h1/h1_floating_base/left_ankle_link")
+        + np.asarray([0.0, 0.0, -0.08]),
+        "right_foot": body("h1/h1_floating_base/right_ankle_link")
+        + np.asarray([0.0, 0.0, -0.08]),
+    }
+
+
+def _full_body_summary(frames: list[dict[str, Any]]) -> dict[str, Any]:
+    margins = np.asarray(
+        [frame["minimum_margin_fraction"] for frame in frames],
+        dtype=np.float64,
+    )
+    vertical_spans = np.asarray(
+        [frame["vertical_span_fraction"] for frame in frames],
+        dtype=np.float64,
+    )
+    center_offsets = np.asarray(
+        [frame["center_offset_fraction"] for frame in frames],
+        dtype=np.float64,
+    )
+    safe = np.asarray([frame["safe"] for frame in frames], dtype=bool)
+    return {
+        "frame_count": len(frames),
+        "safe_frame_count": int(np.count_nonzero(safe)),
+        "safe_frame_fraction": float(np.mean(safe)),
+        "all_frames_safe": bool(np.all(safe)),
+        "minimum_margin_fraction": float(np.min(margins)),
+        "p05_margin_fraction": float(np.percentile(margins, 5)),
+        "minimum_head_top_margin_fraction": float(
+            min(frame["head_top_margin_fraction"] for frame in frames)
+        ),
+        "minimum_feet_bottom_margin_fraction": float(
+            min(frame["feet_bottom_margin_fraction"] for frame in frames)
+        ),
+        "median_vertical_span_fraction": float(np.median(vertical_spans)),
+        "maximum_vertical_span_fraction": float(np.max(vertical_spans)),
+        "median_center_offset_fraction": float(np.median(center_offsets)),
+    }
+
+
+def _robot_geom_groups(model) -> dict[str, np.ndarray]:
+    groups: dict[str, list[int]] = {
+        "all": [],
+        "head": [],
+        "torso": [],
+        "left_arm": [],
+        "right_arm": [],
+        "legs": [],
+        "left_leg": [],
+        "right_leg": [],
+    }
+    for geom_id in range(model.ngeom):
+        geom_name = model.geom(geom_id).name
+        if not geom_name.startswith("h1/"):
+            continue
+        body_name = model.body(int(model.geom_bodyid[geom_id])).name
+        groups["all"].append(geom_id)
+        if geom_name in {"h1/head", "h1/helmet"}:
+            groups["head"].append(geom_id)
+        if geom_name in {"h1/torso", "h1/hip"} or body_name in {
+            "h1/torso_link",
+            "h1/h1_floating_base/h1_floating_base",
+        }:
+            groups["torso"].append(geom_id)
+        if "/left_" in body_name and "h1_floating_base" not in body_name:
+            groups["left_arm"].append(geom_id)
+        if "/right_" in body_name and "h1_floating_base" not in body_name:
+            groups["right_arm"].append(geom_id)
+        if "h1/h1_floating_base/left_" in body_name:
+            groups["legs"].append(geom_id)
+            groups["left_leg"].append(geom_id)
+        if "h1/h1_floating_base/right_" in body_name:
+            groups["legs"].append(geom_id)
+            groups["right_leg"].append(geom_id)
+    return {name: np.asarray(ids, dtype=np.int32) for name, ids in groups.items()}
+
+
+def _task_geom_groups(model) -> dict[str, np.ndarray]:
+    """Resolve the two static work-area groups that external must show."""
+
+    groups: dict[str, list[int]] = {
+        "dishwasher": [],
+        "drawer": [],
+        "table_occluder": [],
+        "near_counter_occluder": [],
+    }
+    for geom_id in range(model.ngeom):
+        geom_name = model.geom(geom_id).name.lower()
+        body_name = model.body(int(model.geom_bodyid[geom_id])).name.lower()
+        if geom_name.startswith("dishwasher/") or body_name.startswith(
+            "dishwasher/"
+        ):
+            groups["dishwasher"].append(geom_id)
+        if geom_name.startswith("base_cabinet_600_2/") or body_name.startswith(
+            "base_cabinet_600_2/"
+        ):
+            groups["drawer"].append(geom_id)
+        if geom_name.startswith("table_dishwasher/") or body_name.startswith(
+            "table_dishwasher/"
+        ):
+            groups["table_occluder"].append(geom_id)
+        if geom_name.startswith("base_cabinet_600/") or body_name.startswith(
+            "base_cabinet_600/"
+        ):
+            groups["near_counter_occluder"].append(geom_id)
+    return {name: np.asarray(ids, dtype=np.int32) for name, ids in groups.items()}
+
+
+def _task_visibility_metrics(
+    segmentation: np.ndarray,
+    groups: dict[str, np.ndarray],
+) -> dict[str, Any]:
+    """Measure dishwasher/drawer visibility in one rendered keyframe."""
+
+    geom_pixels = segmentation[..., 0]
+    geom_type = segmentation[..., 1] == int(mujoco.mjtObj.mjOBJ_GEOM)
+    fractions = {
+        name: float(np.mean(geom_type & np.isin(geom_pixels, ids)))
+        for name, ids in groups.items()
+    }
+    thresholds = {"dishwasher": 0.001, "drawer": 0.0005}
+    visible = {
+        name: bool(fractions[name] >= threshold)
+        for name, threshold in thresholds.items()
+    }
+    occluder_fraction = (
+        fractions["table_occluder"] + fractions["near_counter_occluder"]
+    )
+    return {
+        "pixel_fraction": fractions,
+        "visible_groups": visible,
+        "combined_near_occluder_fraction": occluder_fraction,
+        "maximum_near_occluder_fraction": 0.05,
+        "passed": bool(
+            all(visible.values()) and occluder_fraction <= 0.05
+        ),
+    }
+
+
+def _robot_segmentation_metrics(
+    segmentation: np.ndarray,
+    groups: dict[str, np.ndarray],
+) -> dict[str, Any]:
+    geom_pixels = segmentation[..., 0]
+    geom_type = segmentation[..., 1] == int(mujoco.mjtObj.mjOBJ_GEOM)
+    mask = geom_type & np.isin(geom_pixels, groups["all"])
+    height, width = mask.shape
+    if not np.any(mask):
+        return {
+            "visible": False,
+            "pixel_fraction": 0.0,
+            "minimum_bbox_margin_fraction": -1.0,
+            "bbox_xyxy_normalized": None,
+            "visible_groups": {name: False for name in groups if name != "all"},
+        }
+    rows, columns = np.nonzero(mask)
+    left = int(np.min(columns))
+    right = int(np.max(columns))
+    top = int(np.min(rows))
+    bottom = int(np.max(rows))
+    margins = np.asarray(
+        [
+            left / width,
+            (width - 1 - right) / width,
+            top / height,
+            (height - 1 - bottom) / height,
+        ],
+        dtype=np.float64,
+    )
+    return {
+        "visible": True,
+        "pixel_fraction": float(np.mean(mask)),
+        "minimum_bbox_margin_fraction": float(np.min(margins)),
+        "bbox_xyxy_normalized": [
+            left / width,
+            top / height,
+            right / width,
+            bottom / height,
+        ],
+        "visible_groups": {
+            name: bool(np.any(geom_type & np.isin(geom_pixels, ids)))
+            for name, ids in groups.items()
+            if name != "all"
+        },
+    }
+
+
+def _add_projected_extent_check(
+    metrics: dict[str, Any],
+    projected: dict[str, Any],
+) -> dict[str, Any]:
+    """Check that rendered H1 pixels span the projected head-to-feet extent.
+
+    Named decorative geoms are not guaranteed to win the segmentation z-buffer
+    (the monolithic H1 visual mesh often wins instead), so the hard gate uses
+    the complete robot mask extent.  Per-part IDs remain useful evidence but
+    are not treated as proof of crop or occlusion.
+    """
+    result = dict(metrics)
+    result["projected_bbox_xyxy_normalized"] = projected["bbox_xyxy_normalized"]
+    if metrics["bbox_xyxy_normalized"] is None:
+        result.update(
+            {
+                "vertical_extent_ratio": 0.0,
+                "top_extent_gap_fraction": 1.0,
+                "bottom_extent_gap_fraction": 1.0,
+                "full_body_extent_passed": False,
+            }
+        )
+        return result
+    _pl, projected_top, _pr, projected_bottom = projected["bbox_xyxy_normalized"]
+    _sl, segmentation_top, _sr, segmentation_bottom = metrics["bbox_xyxy_normalized"]
+    projected_height = max(projected_bottom - projected_top, 1e-6)
+    segmentation_height = segmentation_bottom - segmentation_top
+    top_gap = max(0.0, segmentation_top - projected_top)
+    bottom_gap = max(0.0, projected_bottom - segmentation_bottom)
+    extent_ratio = segmentation_height / projected_height
+    result.update(
+        {
+            "vertical_extent_ratio": float(extent_ratio),
+            "top_extent_gap_fraction": float(top_gap),
+            "bottom_extent_gap_fraction": float(bottom_gap),
+            "full_body_extent_passed": bool(
+                metrics["visible"]
+                and metrics["minimum_bbox_margin_fraction"] >= 0.0
+                and extent_ratio >= 0.75
+                and top_gap <= 0.07
+                and bottom_gap <= 0.07
+            ),
+        }
+    )
+    return result
+
+
+def _coverage(
+    source_cameras: np.ndarray,
+    gaussian_to_mujoco: np.ndarray,
+    candidate: dict[str, Any],
+) -> dict[str, float | int]:
+    source_positions = (
+        source_cameras[:, :3, 3] @ gaussian_to_mujoco[:3, :3].T
+        + gaussian_to_mujoco[:3, 3]
+    )
+    source_rotations = np.einsum(
+        "ij,njk->nik",
+        normalized_rotation(gaussian_to_mujoco[:3, :3]),
+        source_cameras[:, :3, :3],
+    )
+    position = np.asarray(candidate["position_m"], dtype=np.float64)
+    distance, index = cKDTree(source_positions).query(position)
+    rotation_mujoco = np.empty(9, dtype=np.float64)
+    mujoco.mju_quat2Mat(
+        rotation_mujoco,
+        np.asarray(candidate["quaternion_wxyz"], dtype=np.float64),
+    )
+    rotation_cv = rotation_mujoco.reshape(3, 3) @ MUJOCO_TO_CV_CAMERA
+    relative = rotation_cv.T @ source_rotations[index]
+    angle = np.degrees(np.arccos(np.clip((np.trace(relative) - 1.0) * 0.5, -1.0, 1.0)))
+    return {
+        "nearest_source_index": int(index),
+        "translation_m": float(distance),
+        "rotation_degrees": float(angle),
+    }
+
+
+def _geometry_rank(
+    full_body: dict[str, Any],
+    coverage: dict[str, float | int],
+) -> float:
+    # A failed full-body gate is retained in the report but cannot enter the
+    # expensive Gaussian-render shortlist.
+    if (
+        not full_body["all_frames_safe"]
+        or full_body["median_center_offset_fraction"] > 0.15
+    ):
+        return float(-100.0 + 10.0 * full_body["safe_frame_fraction"])
+    if (
+        float(coverage["translation_m"]) > MAX_SOURCE_TRANSLATION_M
+        or float(coverage["rotation_degrees"]) > MAX_SOURCE_ROTATION_DEGREES
+    ):
+        return -200.0
+    subject_scale = max(
+        0.0,
+        1.0 - abs(full_body["median_vertical_span_fraction"] - 0.62) / 0.32,
+    )
+    return float(
+        3.0 * np.clip(full_body["p05_margin_fraction"] / 0.12, 0.0, 1.0)
+        + 2.0 * subject_scale
+        - 2.0 * full_body["median_center_offset_fraction"]
+        - 0.20 * float(coverage["translation_m"])
+        - 0.006 * float(coverage["rotation_degrees"])
+    )
+
+
+def _rank(
+    appearance: list[dict[str, float]],
+    coverage: dict[str, float | int],
+    full_body: dict[str, Any],
+    robot_visibility: list[dict[str, Any]],
+    task_visibility: list[dict[str, Any]],
+    *,
+    allow_source_coverage_extrapolation: bool = False,
+) -> float:
+    if (
+        not full_body["all_frames_safe"]
+        or not robot_visibility
+        or not task_visibility
+        or (
+            not allow_source_coverage_extrapolation
+            and (
+                float(coverage["translation_m"]) > MAX_SOURCE_TRANSLATION_M
+                or float(coverage["rotation_degrees"])
+                > MAX_SOURCE_ROTATION_DEGREES
+            )
+        )
+    ):
+        return -1000.0
+    required_groups = (
+        "head",
+        "torso",
+        "left_arm",
+        "right_arm",
+        "legs",
+        "left_leg",
+        "right_leg",
+    )
+    group_visibility = {
+        name: float(
+            np.mean(
+                [item["visible_groups"].get(name, False) for item in robot_visibility]
+            )
+        )
+        for name in required_groups
+    }
+    if not all(item["full_body_extent_passed"] for item in robot_visibility):
+        return -1000.0
+    if not all(item["passed"] for item in task_visibility):
+        return -1000.0
+    if min(group_visibility["left_arm"], group_visibility["right_arm"]) < 0.85:
+        return -1000.0
+    visibility = np.mean(
+        [item["task_context_gaussian_coverage"] for item in appearance]
+    )
+    clear_score = np.mean(
+        [item["task_context_clear_score"] for item in appearance]
+    )
+    bright = np.mean(
+        [item["task_context_bright_fraction"] for item in appearance]
+    )
+    fog = np.mean(
+        [item["task_context_severe_fog_fraction"] for item in appearance]
+    )
+    holes = np.mean(
+        [item["task_context_hole_fraction"] for item in appearance]
+    )
+    foreground = np.mean([item["foreground_fraction"] for item in appearance])
+    task_framing = max(0.0, 1.0 - abs(foreground - 0.20) / 0.20)
+    robot_margin = min(
+        item["minimum_bbox_margin_fraction"] for item in robot_visibility
+    )
+    full_body_margin = full_body["p05_margin_fraction"]
+    subject_scale = max(
+        0.0,
+        1.0 - abs(full_body["median_vertical_span_fraction"] - 0.62) / 0.32,
+    )
+    return float(
+        2.5 * visibility
+        + 2.0 * clear_score
+        + 1.2 * task_framing
+        + 1.4 * np.clip(full_body_margin / 0.12, 0.0, 1.0)
+        + 0.9 * np.clip(robot_margin / 0.08, 0.0, 1.0)
+        + 0.8 * subject_scale
+        + 0.6 * np.mean(list(group_visibility.values()))
+        - 1.5 * bright
+        - 1.5 * fog
+        - 1.0 * holes
+        - 0.30 * float(coverage["translation_m"])
+        - 0.012 * float(coverage["rotation_degrees"])
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--camera-path", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--scene-placement-profile", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--sample-frames", default="0,100,200,300,400,500,648")
+    parser.add_argument("--max-render-candidates", type=int, default=24)
+    parser.add_argument(
+        "--allow-source-coverage-extrapolation",
+        action="store_true",
+        help=(
+            "render full-body-safe cameras outside the source coverage gate for "
+            "diagnostics; the resulting profile remains non-collectable"
+        ),
+    )
+    args = parser.parse_args()
+
+    profile_path = args.profile.expanduser().resolve()
+    profile = json.loads(profile_path.read_text(encoding="utf-8"))
+    alignment_path = (profile_path.parent / profile["alignment"]["path"]).resolve()
+    alignment = json.loads(alignment_path.read_text(encoding="utf-8"))
+    gaussian_to_mujoco = np.asarray(
+        alignment["gaussian_to_mujoco"],
+        dtype=np.float64,
+    )
+    source_cameras = load_source_cameras(args.camera_path.resolve())
+    trajectory = np.load(args.trajectory.resolve())
+    canonical_actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    sample_frames = sorted({int(value) for value in args.sample_frames.split(",")})
+    frame_count = sample_frames[-1] + 1
+    if len(canonical_actions) < frame_count:
+        raise ValueError(
+            f"trajectory has {len(canonical_actions)} actions but frame "
+            f"{sample_frames[-1]} was requested"
+        )
+    placement_path = (
+        args.scene_placement_profile.expanduser().resolve()
+        if args.scene_placement_profile is not None
+        else None
+    )
+    placement = (
+        load_scene_placement_profile(
+            placement_path,
+            expected_task="DishwasherUnloadCutleryLong",
+        )
+        if placement_path is not None
+        else None
+    )
+    task_target = (
+        placement.transform_point([0.15, -0.60, 0.0])[:2]
+        if placement is not None
+        else np.asarray([0.15, -0.60], dtype=np.float64)
+    )
+    candidates = _candidates(task_target)
+    results = [
+        {
+            "candidate_index": candidate_index,
+            **candidate,
+            "coverage": _coverage(
+                source_cameras,
+                gaussian_to_mujoco,
+                candidate,
+            ),
+            "full_body_frames": [],
+            "appearance": [],
+            "robot_visibility": [],
+            "task_visibility": [],
+        }
+        for candidate_index, candidate in enumerate(candidates)
+    ]
+    key_images: dict[int, np.ndarray] = {}
+
+    # First pass: no rendering.  Measure all candidates against all 649 H1
+    # poses, so a good middle frame cannot hide a cropped head or foot later.
+    env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=FOUR_CAMERA_SET,
+        visual_shell_profile=str(profile_path),
+        visual_shell_strict=True,
+        scene_placement_profile=(
+            str(placement_path) if placement_path is not None else None
+        ),
+    )
+    actions = (
+        np.asarray(
+            [
+                env.scene_placement.transform_action(
+                    action,
+                    env.action_mode.floating_dofs,
+                )
+                for action in canonical_actions
+            ],
+            dtype=np.float32,
+        )
+        if env.scene_placement is not None
+        else canonical_actions
+    )
+    try:
+        env.reset(seed=seed)
+        for frame_index in range(frame_count):
+            landmarks = _full_body_landmarks(env.mojo.model, env.mojo.data)
+            for result in results:
+                result["full_body_frames"].append(_project_landmarks(landmarks, result))
+            if frame_index < sample_frames[-1]:
+                env.step(actions[frame_index], fast=True)
+    finally:
+        env.close()
+
+    for result in results:
+        frames = result.pop("full_body_frames")
+        result["full_body"] = _full_body_summary(frames)
+        result["full_body_sample_frames"] = [
+            {"frame": frame_index, **frames[frame_index]}
+            for frame_index in sample_frames
+        ]
+        result["geometry_rank_score"] = _geometry_rank(
+            result["full_body"],
+            result["coverage"],
+        )
+    shortlist = sorted(
+        (
+            result
+            for result in results
+            if result["full_body"]["all_frames_safe"]
+            and result["full_body"]["median_center_offset_fraction"] <= 0.15
+            and (
+                args.allow_source_coverage_extrapolation
+                or (
+                    float(result["coverage"]["translation_m"])
+                    <= MAX_SOURCE_TRANSLATION_M
+                    and float(result["coverage"]["rotation_degrees"])
+                    <= MAX_SOURCE_ROTATION_DEGREES
+                )
+            )
+        ),
+        key=lambda item: item["geometry_rank_score"],
+        reverse=True,
+    )[: args.max_render_candidates]
+    if not shortlist:
+        raise RuntimeError("no external camera keeps the complete H1 body in frame")
+
+    # Second pass: rasterize only geometrically valid finalists.  Segmentation
+    # is used to reject projected-but-occluded head, torso, or leg views.
+    env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=FOUR_CAMERA_SET,
+        visual_shell_profile=str(profile_path),
+        visual_shell_strict=True,
+        scene_placement_profile=(
+            str(placement_path) if placement_path is not None else None
+        ),
+    )
+    try:
+        env.reset(seed=seed)
+        shell = env._visual_shell
+        camera_id = env._cameras_map["external"][0]
+        renderer = env.obs_renderers[(480, 848)]
+        robot_groups = _robot_geom_groups(env.mojo.model)
+        task_groups = _task_geom_groups(env.mojo.model)
+        for frame_index in range(sample_frames[-1] + 1):
+            if frame_index in sample_frames:
+                for result in shortlist:
+                    env.mojo.model.cam_pos[camera_id] = result["position_m"]
+                    env.mojo.model.cam_quat[camera_id] = result["quaternion_wxyz"]
+                    mujoco.mj_forward(env.mojo.model, env.mojo.data)
+                    renderer.update_scene(env.mojo.data, camera_id)
+                    native = renderer.render()
+                    renderer.enable_segmentation_rendering()
+                    segmentation = renderer.render()
+                    renderer.disable_segmentation_rendering()
+                    foreground = shell.native_foreground_mask(segmentation)
+                    floor = shell.native_floor_mask(segmentation)
+                    composite = shell.render_rgb(
+                        env.mojo.model,
+                        env.mojo.data,
+                        camera_id,
+                        native,
+                        native_foreground_mask=foreground,
+                        native_floor_mask=floor,
+                    )
