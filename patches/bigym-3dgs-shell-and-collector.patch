+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from d.replay_generation.make_legacy_room_conservative_profile import (
+    DEFAULT_THRESHOLDS,
+    make_profile,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def test_make_profile_freezes_assets_and_fails_closed(tmp_path: Path) -> None:
+    source = tmp_path / "source"
+    source.mkdir()
+    ply = source / "room.ply"
+    ply.write_bytes(b"ply\nend_header\nroom")
+    alignment = source / "alignment.json"
+    alignment.write_text(json.dumps({"mujoco_to_gaussian": [1]}))
+    cameras = source / "camera-path.json"
+    cameras.write_text(json.dumps({"camtoworlds": []}))
+    source_profile = source / "profile.json"
+    source_profile.write_text(
+        json.dumps(
+            {
+                "schema_version": 3,
+                "asset": {
+                    "path": ply.name,
+                    "bytes": ply.stat().st_size,
+                    "sha256": _sha256(ply),
+                },
+                "layer_files": {"combined": ply.name},
+                "ground_visual": {
+                    "mode": "gaussian_combined_with_confidence_fallback",
+                    "confidence_compositing": "hard_opaque",
+                },
+                "alignment": {
+                    "path": alignment.name,
+                    "sha256": _sha256(alignment),
+                },
+                "capture_path": {
+                    "path": cameras.name,
+                    "sha256": _sha256(cameras),
+                },
+                "integration_contract": {
+                    "camera_set": "bigym-plus-3",
+                },
+            }
+        )
+    )
+    output = tmp_path / "legacy"
+    generated = make_profile(source_profile, output)
+    profile = json.loads(generated.read_text())
+
+    assert (output / "room.ply").is_symlink()
+    assert profile["integration_contract"]["camera_coverage_gate"] == {
+        "mode": "whole_camera_hard_fallback",
+        "camera_path": "camera-path.json",
+        "thresholds": DEFAULT_THRESHOLDS,
+        "fallback": "native_rgb_with_metric_floor",
+        "failure_is_silent": False,
+    }
+    assert profile["legacy_room_contract"]["coordinate_frame"] == "canonical-bigym"
+    assert profile["quality"]["formal_collection_allowed"] is False
+    assert (
+        json.loads((output / "manifest.json").read_text())["formal_collection_allowed"]
+        is False
+    )
+    assert make_profile(source_profile, output) == generated
