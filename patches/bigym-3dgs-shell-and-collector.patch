+#!/usr/bin/env python3
+"""Compose a selected relative shell alignment into placed-world coordinates.
+
+A common rigid world transform applied to the physical task, its cameras, and
+the Gaussian shell is a gauge choice: it cannot change rendered pixels. The
+visual search therefore selects the meaningful relative Sim(3) first. This
+tool then moves the complete physical workspace anchor to the world origin and
+applies the exact same SE(2) to the selected shell alignment.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+import numpy as np
+
+from bigym.utils.scene_placement import load_scene_placement_profile
+from env_utils import EXTERNAL_CAMERA
+from optimize_visual_shell_pose import yaw_rotation
+
+
+def _world_transform(yaw_degrees: float, anchor_xy_m: np.ndarray) -> np.ndarray:
+    transform = np.eye(4, dtype=np.float64)
+    transform[:3, :3] = yaw_rotation(yaw_degrees)
+    transform[:2, 3] = -(transform[:2, :2] @ anchor_xy_m)
+    return transform
+
+
+def _link_assets(source_profile_path: Path, profile: dict, output_dir: Path) -> None:
+    for filename in set(profile["layer_files"].values()):
+        source = (source_profile_path.parent / filename).resolve()
+        target = output_dir / filename
+        if target.exists() or target.is_symlink():
+            target.unlink()
+        os.symlink(source, target)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--selected-profile", type=Path, required=True)
+    parser.add_argument("--search-report", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument(
+        "--external-camera-profile",
+        type=Path,
+        help="optional previously validated full-body external camera profile",
+    )
+    parser.add_argument("--demo-seed", type=int, default=2388573616)
+    parser.add_argument(
+        "--placement-yaw-degrees",
+        type=float,
+        default=0.0,
+        help=(
+            "common physical/world yaw; zero preserves translational physics "
+            "equivariance while retaining the selected relative shell yaw"
+        ),
+    )
+    parser.add_argument(
+        "--allow-diagnostic",
+        action="store_true",
+        help="compose a failed-gate profile for diagnostics only",
+    )
+    parser.add_argument(
+        "--workspace-anchor-xy-m",
+        type=float,
+        nargs=2,
+        default=(0.75, -0.60),
+    )
+    args = parser.parse_args()
+
+    source_profile_path = args.selected_profile.expanduser().resolve()
+    source_profile = json.loads(source_profile_path.read_text(encoding="utf-8"))
+    source_alignment_path = (
+        source_profile_path.parent / source_profile["alignment"]["path"]
+    ).resolve()
+    source_alignment = json.loads(
+        source_alignment_path.read_text(encoding="utf-8")
+    )
+    report = json.loads(args.search_report.read_text(encoding="utf-8"))
+    selected = report["selected"]
+    if not selected.get("visibility_gate_passed") and not args.allow_diagnostic:
+        raise RuntimeError("selected visual-shell candidate did not pass its gate")
+    physical_yaw = float(args.placement_yaw_degrees)
+    anchor = np.asarray(args.workspace_anchor_xy_m, dtype=np.float64)
+    world_transform = _world_transform(physical_yaw, anchor)
+    relative_gaussian_to_mujoco = np.asarray(
+        source_alignment["gaussian_to_mujoco"], dtype=np.float64
+    )
+    placed_gaussian_to_mujoco = (
+        world_transform @ relative_gaussian_to_mujoco
+    )
+    output_dir = args.output_dir.expanduser().resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    placement_payload = {
+        "schema_version": 1,
+        "name": "dishwasher-unload-cutlery-long-dl3dv-center-v1",
+        "task": "DishwasherUnloadCutleryLong",
+        "translation_xy_m": world_transform[:2, 3].tolist(),
+        "yaw_degrees": physical_yaw,
+        "z_offset_m": 0.0,
+        "coordinate_frame": "placed-world-v1",
+        "demo_seed": args.demo_seed,
+        "transform_source": str(args.search_report.resolve()),
+        "selected_relative_shell_yaw_degrees": float(
+            selected["parameters"]["yaw"]
+        ),
+        "gauge_policy": (
+            "workspace anchor is moved to world origin; the same SE(2) is "
+            "applied to physics, cameras, and Gaussian shell"
+        ),
+    }
+    placement_path = output_dir / "scene-placement.json"
+    placement_path.write_text(
+        json.dumps(placement_payload, indent=2) + "\n", encoding="utf-8"
+    )
+    placement = load_scene_placement_profile(placement_path)
+    external_profile = source_profile
+    if args.external_camera_profile is not None:
+        external_profile = json.loads(
+            args.external_camera_profile.expanduser()
+            .resolve()
+            .read_text(encoding="utf-8")
+        )
+    source_external = external_profile.get("integration_contract", {}).get(
+        "external_camera", {}
+    )
+    base_external_position = source_external.get(
+        "position_m", EXTERNAL_CAMERA.pos or ()
+    )
+    base_external_quaternion = source_external.get(
+        "quaternion_wxyz", EXTERNAL_CAMERA.quat or ()
+    )
+    external_position, external_quaternion = placement.camera_pose(
+        base_external_position, base_external_quaternion
+    )
+    # Persist the selected external camera as an absolute placed-world pose.
+    # This prevents build_env from applying the common scene transform twice.
+    placement_payload["external_camera"] = {
+        "position_m": external_position.tolist(),
+        "quaternion_wxyz": external_quaternion.tolist(),
+    }
+    placement_payload["external_camera_transform_source"] = (
+        str(args.external_camera_profile.expanduser().resolve())
+        if args.external_camera_profile is not None
+        else str(source_profile_path)
+    )
+    placement_path.write_text(
+        json.dumps(placement_payload, indent=2) + "\n", encoding="utf-8"
+    )
+    placement = load_scene_placement_profile(placement_path)
+
+    alignment = {
+        **source_alignment,
+        "gaussian_to_mujoco": placed_gaussian_to_mujoco.tolist(),
+        "mujoco_to_gaussian": np.linalg.inv(
+            placed_gaussian_to_mujoco
+        ).tolist(),
+        "placed_world": {
+            "coordinate_frame": placement.coordinate_frame,
+            "scene_placement": placement.snapshot(),
+            "relative_gaussian_to_canonical_mujoco": (
+                relative_gaussian_to_mujoco.tolist()
+            ),
+            "common_world_transform": world_transform.tolist(),
+            "visual_equivalence": (
+                "placed cameras and shell preserve the selected relative "
+                "alignment exactly"
+            ),
+        },
+    }
+    alignment_path = output_dir / "alignment-placed-world.json"
+    alignment_path.write_text(
+        json.dumps(alignment, indent=2) + "\n", encoding="utf-8"
+    )
+    integration = {
+        **source_profile.get("integration_contract", {}),
+        "depth_semantics": "accumulated",
+        "scene_placement_profile": placement_path.name,
+        "coordinate_frame": placement.coordinate_frame,
+        "external_camera": {
+            "position_m": external_position.tolist(),
+            "quaternion_wxyz": external_quaternion.tolist(),
+            "resolution_hw": list(EXTERNAL_CAMERA.resolution),
+            "fovy_degrees": EXTERNAL_CAMERA.fovy,
+            "fixed_in_placed_world": True,
+        },
+    }
+    final_scale = float(
+        np.mean(np.linalg.norm(placed_gaussian_to_mujoco[:3, :3], axis=0))
+    )
+    profile = {
+        **source_profile,
+        "name": "dl3dv-kitchen-unload-cutlery-placed-clear-v1",
+        "alignment": {"path": alignment_path.name},
+        "integration_contract": integration,
+        "quality": {
+            **source_profile.get("quality", {}),
+            "status": (
+                "placed_world_diagnostic_depth_gate_failed"
+                if not selected.get("visibility_gate_passed")
+                else "placed_world_candidate_awaiting_visual_approval"
+            ),
+            "formal_collection_recommended": False,
+            "awaiting_visual_approval": True,
+            "placed_world": {
+                "scene_placement_profile": placement_path.name,
+                "search_report": str(args.search_report.resolve()),
+                "uniform_gaussian_scale_m_per_source_unit": final_scale,
+                "physics_scaled": False,
+                "source_visibility_gate_passed": bool(
+                    selected.get("visibility_gate_passed")
+                ),
+            },
+        },
+    }
+    profile_path = output_dir / "profile.json"
+    profile_path.write_text(
+        json.dumps(profile, indent=2) + "\n", encoding="utf-8"
+    )
+    _link_assets(source_profile_path, profile, output_dir)
+    print(
+        json.dumps(
+            {
+                "status": "composed",
+                "visual_shell_profile": str(profile_path),
+                "scene_placement_profile": str(placement_path),
+                "workspace_anchor_after_placement_m": placement.transform_point(
+                    [anchor[0], anchor[1], 0.0]
+                ).tolist(),
+                "uniform_gaussian_scale": final_scale,
+                "physics_scaled": False,
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
