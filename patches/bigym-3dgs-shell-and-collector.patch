+#!/usr/bin/env python3
+"""Combine capture-path coverage and world-lock results into a fail-closed gate."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import mujoco
+import numpy as np
+from scipy.spatial import cKDTree
+
+from env_utils import EXTERNAL_CAMERA, FOUR_CAMERA_SET
+from optimize_visual_shell_pose import (
+    MUJOCO_TO_CV_CAMERA,
+    TrajectoryPoseObjective,
+    load_source_cameras,
+    normalized_rotation,
+)
+
+
+def _load_alignment(profile_path: Path) -> tuple[dict, dict, Path]:
+    profile = json.loads(profile_path.read_text(encoding="utf-8"))
+    alignment_path = (
+        profile_path.parent
+        / profile.get("alignment", {}).get("path", "alignment.json")
+    ).resolve()
+    return (
+        profile,
+        json.loads(alignment_path.read_text(encoding="utf-8")),
+        alignment_path,
+    )
+
+
+def _external_coverage(
+    source_cameras: np.ndarray,
+    gaussian_to_mujoco: np.ndarray,
+) -> dict[str, float | int]:
+    source_positions = (
+        source_cameras[:, :3, 3] @ gaussian_to_mujoco[:3, :3].T
+        + gaussian_to_mujoco[:3, 3]
+    )
+    source_rotations = np.einsum(
+        "ij,njk->nik",
+        normalized_rotation(gaussian_to_mujoco[:3, :3]),
+        source_cameras[:, :3, :3],
+    )
+    quaternion = np.asarray(EXTERNAL_CAMERA.quat, dtype=np.float64)
+    rotation_mujoco = np.empty(9, dtype=np.float64)
+    mujoco.mju_quat2Mat(rotation_mujoco, quaternion)
+    rotation_cv = rotation_mujoco.reshape(3, 3) @ MUJOCO_TO_CV_CAMERA
+    distance, index = cKDTree(source_positions).query(
+        np.asarray(EXTERNAL_CAMERA.pos, dtype=np.float64)
+    )
+    relative = rotation_cv.T @ source_rotations[index]
+    angle = np.degrees(
+        np.arccos(
+            np.clip((np.trace(relative) - 1.0) * 0.5, -1.0, 1.0)
+        )
+    )
+    return {
+        "nearest_source_index": int(index),
+        "translation_m": float(distance),
+        "rotation_degrees": float(angle),
+    }
+
+
+def _moving_coverage(
+    source_cameras: np.ndarray,
+    gaussian_to_mujoco: np.ndarray,
+    trajectory,
+) -> dict:
+    _score, report = TrajectoryPoseObjective(
+        source_cameras,
+        gaussian_to_mujoco,
+        trajectory,
+        stride=1,
+    ).evaluate([0.0, 0.0, 0.0])
+    return report
+
+
+def _thresholds(original_profile: dict) -> dict:
+    selected = original_profile["quality"]["task_trajectory_optimization"][
+        "selected"
+    ]["per_camera"]
+    moving = {
+        camera: {
+            "p90_translation_m": values[
+                "capture_path_translation_m"
+            ]["p90"],
+            "p90_rotation_degrees": values[
+                "capture_path_rotation_degrees"
+            ]["p90"],
+        }
+        for camera, values in selected.items()
+    }
+    return {
+        "relative_tolerance": 0.01,
+        "moving_cameras": moving,
+        "external": {
+            "translation_m": max(
+                value["p90_translation_m"] for value in moving.values()
+            ),
+            "rotation_degrees": max(
+                value["p90_rotation_degrees"] for value in moving.values()
+            ),
+        },
+    }
+
+
+def _coverage_passed(
+    moving: dict,
+    external: dict,
+    thresholds: dict,
+) -> tuple[bool, dict]:
+    checks = {}
+    for camera, limits in thresholds["moving_cameras"].items():
+        values = moving["per_camera"][camera]
+        passed = (
+            values["capture_path_translation_m"]["p90"]
+            <= limits["p90_translation_m"] * 1.01 + 1e-9
+            and values["capture_path_rotation_degrees"]["p90"]
+            <= limits["p90_rotation_degrees"] * 1.01 + 1e-9
+        )
+        checks[camera] = passed
+    checks["external"] = (
+        external["translation_m"]
+        <= thresholds["external"]["translation_m"] * 1.01 + 1e-9
+        and external["rotation_degrees"]
+        <= thresholds["external"]["rotation_degrees"] * 1.01 + 1e-9
+    )
+    return all(checks.values()), checks
+
+
+def _candidate(
+    *,
+    name: str,
+    profile_path: Path,
+    world_lock_path: Path,
+    source_cameras: np.ndarray,
+    trajectory,
+    thresholds: dict,
+) -> dict:
+    _profile, alignment, alignment_path = _load_alignment(profile_path)
+    transform = np.asarray(
+        alignment["gaussian_to_mujoco"],
+        dtype=np.float64,
+    )
+    moving = _moving_coverage(source_cameras, transform, trajectory)
+    external = _external_coverage(source_cameras, transform)
+    coverage_passed, coverage_checks = _coverage_passed(
+        moving,
+        external,
+        thresholds,
+    )
+    world_lock = json.loads(world_lock_path.read_text(encoding="utf-8"))
+    world_lock_passed = world_lock.get("status") == "passed"
+    return {
+        "name": name,
+        "profile": str(profile_path),
+        "alignment": str(alignment_path),
+        "world_lock_report": str(world_lock_path),
+        "world_lock_passed": world_lock_passed,
+        "world_lock_maximums": world_lock.get("maximums"),
+        "coverage_passed": coverage_passed,
+        "coverage_checks": coverage_checks,
+        "moving_camera_coverage": moving,
+        "external_camera_coverage": external,
+        "joint_gate_passed": world_lock_passed and coverage_passed,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--original-profile", type=Path, required=True)
+    parser.add_argument("--original-world-lock", type=Path, required=True)
+    parser.add_argument("--candidate-profile", type=Path, required=True)
+    parser.add_argument("--candidate-world-lock", type=Path, required=True)
+    parser.add_argument("--camera-path", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    original_profile_path = args.original_profile.resolve()
+    original_profile, _alignment, _path = _load_alignment(
+        original_profile_path
+    )
+    thresholds = _thresholds(original_profile)
+    source_cameras = load_source_cameras(args.camera_path.resolve())
+    trajectory = np.load(args.trajectory.resolve())
+    candidates = [
+        _candidate(
+            name="coverage_optimized_floor04",
+            profile_path=original_profile_path,
+            world_lock_path=args.original_world_lock.resolve(),
+            source_cameras=source_cameras,
+            trajectory=trajectory,
+            thresholds=thresholds,
+        ),
+        _candidate(
+            name="depth_optimized_scale2_yaw20",
+            profile_path=args.candidate_profile.resolve(),
+            world_lock_path=args.candidate_world_lock.resolve(),
+            source_cameras=source_cameras,
+            trajectory=trajectory,
+            thresholds=thresholds,
+        ),
+    ]
+    passed = any(candidate["joint_gate_passed"] for candidate in candidates)
+    report = {
+        "schema_version": 1,
+        "status": "passed" if passed else "blocked_no_joint_candidate",
+        "visual_status": "awaiting_visual_approval",
+        "formal_collection_allowed": passed,
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": int(np.asarray(trajectory["seed"]).reshape(-1)[0]),
+        "camera_set": FOUR_CAMERA_SET,
+        "coverage_thresholds": thresholds,
+        "candidates": candidates,
+        "decision": (
+            "At least one candidate passed both gates."
+            if passed
+            else (
+                "The source-scale profile preserves capture-path coverage but "
+                "fails Gaussian/native depth ordering. The smallest "
+                "depth-passing scale moves all source cameras beyond the "
+                "existing coverage envelope. Formal LeRobot collection is "
+                "therefore stopped; diagnostic visual evidence only."
+            )
+        ),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+    if not passed:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/d/replay_generation/calibrate_gaussian_depth.py b/d/replay_generation/calibrate_gaussian_depth.py
new file mode 100644
index 0000000..52e4e7f
--- /dev/null
+++ b/d/replay_generation/calibrate_gaussian_depth.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Calibrate AMD gsplat D/ED semantics with Gaussians at known distances."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+from bigym.utils.visual_shell import gaussian_depth_to_meters
+
+
+def _version(package: str) -> str | None:
+    try:
+        from importlib.metadata import version
+
+        return version(package)
+    except Exception:
+        return None
+
+
+def _write_plot(samples: list[dict], path: Path) -> None:
+    canvas = np.full((620, 900, 3), 255, dtype=np.uint8)
+    left, right, top, bottom = 95, 850, 55, 545
+    maximum = max(float(item["known_distance_m"]) for item in samples) * 1.08
+
+    def point(x: float, y: float) -> tuple[int, int]:
+        return (
+            int(left + (right - left) * x / maximum),
+            int(bottom - (bottom - top) * y / maximum),
+        )
+
+    cv2.line(canvas, (left, bottom), (right, bottom), (30, 30, 30), 2)
+    cv2.line(canvas, (left, bottom), (left, top), (30, 30, 30), 2)
+    cv2.line(canvas, point(0.0, 0.0), point(maximum, maximum), (150, 150, 150), 2)
+    for item in samples:
+        expected = float(item["known_distance_m"])
+        accumulated = float(item["accumulated_div_alpha_depth_m"])
+        direct_expected = float(item["gsplat_expected_depth_m"])
+        cv2.circle(canvas, point(expected, accumulated), 8, (235, 95, 35), -1)
+        cv2.rectangle(
+            canvas,
+            tuple(value - 7 for value in point(expected, direct_expected)),
+            tuple(value + 7 for value in point(expected, direct_expected)),
+            (35, 155, 65),
+            -1,
+        )
+    cv2.putText(canvas, "Known plane distance (m)", (315, 600), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (20, 20, 20), 2)
+    cv2.putText(canvas, "Measured depth (m)", (105, 38), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (20, 20, 20), 2)
+    cv2.circle(canvas, (590, 30), 7, (235, 95, 35), -1)
+    cv2.putText(canvas, "D / alpha", (608, 37), cv2.FONT_HERSHEY_SIMPLEX, 0.62, (20, 20, 20), 1)
+    cv2.rectangle(canvas, (730, 23), (744, 37), (35, 155, 65), -1)
+    cv2.putText(canvas, "ED", (752, 37), cv2.FONT_HERSHEY_SIMPLEX, 0.62, (20, 20, 20), 1)
+    cv2.imwrite(str(path), canvas)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--distances", default="0.5,1.0,2.0,3.0")
+    parser.add_argument("--maximum-error-m", type=float, default=0.02)
+    args = parser.parse_args()
+
+    import torch
+    from gsplat.rendering import rasterization
+
+    if not torch.cuda.is_available():
+        raise RuntimeError("depth calibration requires the Radeon device")
+    distances = [float(value) for value in args.distances.split(",")]
+    device = torch.device("cuda")
+    viewmats = torch.eye(4, dtype=torch.float32, device=device)[None]
+    intrinsics = torch.tensor(
+        [[[55.0, 0.0, 32.0], [0.0, 55.0, 32.0], [0.0, 0.0, 1.0]]],
+        dtype=torch.float32,
+        device=device,
+    )
+    samples = []
+    maximum_accumulated_error = 0.0
+    maximum_expected_error = 0.0
+    for distance in distances:
+        means = torch.tensor(
+            [[0.0, 0.0, distance]], dtype=torch.float32, device=device
+        )
+        quaternions = torch.tensor(
+            [[1.0, 0.0, 0.0, 0.0]], dtype=torch.float32, device=device
+        )
+        scales = torch.full(
+            (1, 3), max(distance * 0.08, 0.04), dtype=torch.float32, device=device
+        )
+        opacities = torch.tensor([0.98], dtype=torch.float32, device=device)
+        colors = torch.tensor([[0.8, 0.2, 0.1]], dtype=torch.float32, device=device)
+        accumulated, alpha, _ = rasterization(
+            means=means,
+            quats=quaternions,
+            scales=scales,
+            opacities=opacities,
+            colors=colors,
+            viewmats=viewmats,
+            Ks=intrinsics,
+            width=64,
+            height=64,
+            render_mode="D",
+            packed=False,
+        )
+        expected, expected_alpha, _ = rasterization(
+            means=means,
+            quats=quaternions,
+            scales=scales,
+            opacities=opacities,
+            colors=colors,
+            viewmats=viewmats,
+            Ks=intrinsics,
+            width=64,
+            height=64,
+            render_mode="ED",
+            packed=False,
+        )
+        alpha_np = alpha[0, ..., 0].cpu().numpy()
+        accumulated_np = accumulated[0, ..., 0].cpu().numpy()
+        expected_np = expected[0, ..., 0].cpu().numpy()
+        valid = alpha_np >= 0.5
+        if not np.any(valid):
+            raise RuntimeError(f"no opaque pixels at {distance} m")
+        converted = gaussian_depth_to_meters(
+            accumulated_np,
+            1.0,
+            semantics="accumulated",
+            alpha=alpha_np,
+        )
+        accumulated_median = float(np.median(converted[valid]))
+        expected_median = float(np.median(expected_np[valid]))
+        accumulated_error = abs(accumulated_median - distance)
+        expected_error = abs(expected_median - distance)
+        maximum_accumulated_error = max(
+            maximum_accumulated_error, accumulated_error
+        )
+        maximum_expected_error = max(maximum_expected_error, expected_error)
+        samples.append(
+            {
+                "known_distance_m": distance,
+                "opaque_pixels": int(np.count_nonzero(valid)),
+                "alpha_median": float(np.median(alpha_np[valid])),
+                "accumulated_div_alpha_depth_m": accumulated_median,
+                "accumulated_error_m": accumulated_error,
+                "gsplat_expected_depth_m": expected_median,
+                "expected_error_m": expected_error,
+                "alpha_buffers_equal": bool(
+                    torch.equal(alpha, expected_alpha)
+                ),
+            }
+        )
+    passed = (
+        maximum_accumulated_error <= args.maximum_error_m
+        and maximum_expected_error <= args.maximum_error_m
+    )
+    report = {
+        "schema_version": 1,
+        "status": "passed" if passed else "failed",
+        "device": torch.cuda.get_device_name(0),
+        "torch": torch.__version__,
+        "torch_hip": torch.version.hip,
+        "gsplat": _version("gsplat") or _version("amd_gsplat"),
+        "hsa_override_gfx_version": os.environ.get("HSA_OVERRIDE_GFX_VERSION"),
+        "renderer_contract": {
+            "RGB+D": "alpha-accumulated z-depth",
+            "conversion": "D / alpha / gaussian_units_per_meter",
+            "normalization_count": 1,
+        },
+        "thresholds": {"maximum_error_m": args.maximum_error_m},
+        "maximums": {
+            "accumulated_div_alpha_error_m": maximum_accumulated_error,
+            "expected_depth_error_m": maximum_expected_error,
+        },
+        "samples": samples,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    plot_path = args.output.with_name("depth-calibration.png")
+    _write_plot(samples, plot_path)
+    report["plot"] = str(plot_path)
+    args.output.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(report, indent=2))
+    if not passed:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/d/replay_generation/check_demo_success.md b/d/replay_generation/check_demo_success.md
new file mode 100644
index 0000000..71b8736
--- /dev/null
+++ b/d/replay_generation/check_demo_success.md
@@ -0,0 +1,122 @@
+# demo success 审计(无渲染回灌)
+
+检查 BiGym 官方演示轨迹在回灌(replay)后是否真正达到 task success。生成脚本 generate_dataset.py 回放 demo 时不检查 success,无条件保存;本脚本用无渲染的快速回灌逐条判定,统计成功率,定位受影响的任务。
+
+## 为什么需要
+
+demo 文件录制时的依赖版本(mujoco 3.1.5, bigym 4.0.0)可能与当前回放环境版本不同。回灌理论上是确定性的(reset 同 seed + 逐帧 step 原动作),但 mujoco 物理引擎跨版本会改求解器、积分器、接触约束的数值细节,bigym 跨版本可能改 action_mode 或子步数,导致同 seed + 同动作走出不同数值轨迹,部分演示回灌后不再达到 success。本脚本量化这个比例,供决定是否在生成管线加 success 过滤,或回退依赖版本对齐 demo 录制版本。
+
+## 原理
+
+无渲染最快路径:不建相机、不渲染图像,只跑 mujoco 物理仿真。
+
+- env 构建:build_env(with_cameras=False, render_mode=None),不挂观测相机,不调 env.render()。obs 仍含 proprioception,但本脚本不读 obs。
+- 回灌:env.reset(seed=demo.seed) 复现录制 seed,逐帧 env.step(demo 的 executed_action, fast=True)。fast=True 跳过观测构建,返回默认值,但 env.reward 属性仍从内部缓存读出真实 reward。
+- 判定:env.reward 大于 0 即该演示回灌后达到 success。reward 取值 0 或 1(由 env.success 派生)。
+
+判定口径与以下两条等价:
+
+- 评测端 check_success 的主路径 reward 大于 0.5(eval_bigym.py)
+- 官方 DemoPlayer.validate_in_env 的 env.reward 大于 0(demo_player.py)
+
+env 复用:每个任务建一次 env,循环该任务全部 demo(不像官方 validate_in_env 每条 demo 都 close env),提高批量效率。取 demo 的方式(DemoStore.get_demos + Metadata.from_env,is_lightweight)与 generate_dataset.py 完全一致,保证审计的就是生成时存入数据集的那批 demo。
+
+## 用法
+
+所有命令在 replay_generation/ 目录下执行,conda 环境 amd_bigym_plus312,设 MUJOCO_GL=egl。脚本纯 mujoco CPU 物理仿真,实测不占 GPU 显存,但仍需指定 CUDA_VISIBLE_DEVICES 给 EGL 初始化。
+
+前置:首次运行前先下载演示数据(同 generate_dataset,BiGym 官方轨迹 v0.9.0,缓存到 ~/.bigym):
+
+```
+python download_demos.py
+```
+
+验证管线(每任务 1 条):
+
+```
+CUDA_VISIBLE_DEVICES=0 MUJOCO_GL=egl python check_demo_success.py --group reach --probe
+```
+
+单任务全量:
+
+```
+CUDA_VISIBLE_DEVICES=0 MUJOCO_GL=egl python check_demo_success.py --task ReachTargetDual
+```
+
+单组全量:
+
+```
+CUDA_VISIBLE_DEVICES=0 MUJOCO_GL=egl python check_demo_success.py --group reach
+```
+
+4 组全量(40 任务):
+
+```
+CUDA_VISIBLE_DEVICES=0 MUJOCO_GL=egl python check_demo_success.py --group all
+```
+
+限制每任务条数(调试):
+
+```
+CUDA_VISIBLE_DEVICES=0 MUJOCO_GL=egl python check_demo_success.py --group all --amount 12
+```
+
+主要参数:
+
+| 参数 | 作用 |
+|---|---|
+| --task <名> | 单任务模式,接受 PascalCase 或 snake_case(与 --group 互斥) |
+| --group <组\|all> | 组模式,组名 reach / long_horizon / dishwasher / tabletop 或 all |
+| --amount N | 每任务演示条数上限(默认全量) |
+| --probe | 每任务只跑 1 条,验证管线 |
+
+不带 --task 也不带 --group 时默认等价 --group all,审计全部 40 任务。
+
+## 输出
+
+stdout 打印每任务统计表,列含义:
+
+- task:任务名(PascalCase)
+- dof:浮动基座自由度(3 或 4)
+- succ/total:回灌后达到 success 的条数 / 该任务总条数
+- rate%:成功率
+- err:回灌异常条数(reset 失败或 step 抛错,如 action 越界)
+- no_succ:回灌跑通但未达到 success 的条数(版本偏离的主要表现)
+
+末尾打印合计:总任务数、总演示数、总 success、总 err、总 no_succ、整体成功率、耗时。
+
+JSON 结果落到项目根目录的 claude_analysis_notes/demo_success_audit.json,含三部分:
+
+- meta:环境(conda、频率、判定口径、参数)
+- tasks:每任务统计(probe 模式另附 per_demo 逐条记录,非 probe 模式为空省空间)
+- summary:合计(任务数、演示数、success、err、no_succ、整体成功率)
+
+## 性能
+
+无渲染 fast step,纯 mujoco CPU 物理仿真,单条 demo 回灌毫秒级,耗时主要在每任务建一次 env(加载 mujoco 模型)。参考实测(amd_bigym_plus312, mujoco 3.10.0, bigym 4.1.0):
+
+- probe(每任务 1 条):秒级
+- 单任务全量(50 条左右):数秒
+- 4 组全量(40 任务 / 1868 条):约 1 小时
+
+全量审计耗时较长,建议后台运行(nohup),进程号记入 process.txt,轮询日志直到出现 saved 字样。
+
+## 参考基线
+
+当前环境(amd_bigym_plus312, mujoco 3.10.0, bigym 4.1.0)实测全量 40 任务 / 1868 条,整体 success 约 72%;单刚体 reach 与 drawer/wall_cupboard close 类任务接近 100%,多物体精细操作类(dishwasher unload cups/plates/cutlery、stack blocks、sandwich 系列、cupboards open all)普遍偏低。各任务明细见 JSON。审计结果随环境依赖版本变化,换 mujoco 或 bigym 版本后需重跑。
+
+## 依赖
+
+不依赖 lerobot,只需 bigym + numpy。复用本目录现有模块,不改任何生成或评测代码:
+
+- env_utils.build_env:无相机 env 构建
+- tasks.TASKS / FREQ / resolve_task:任务定义与频率(20 Hz)
+- groups.GROUPS_DICT / all_group_keys:分组
+- demonstrations.demo_store.DemoStore + demonstrations.utils.Metadata:取演示与元数据
+- demonstrations.demo_player.validate_in_env:判定口径来源(本脚本不复用它,因它每条 demo close env,批量效率低)
+
+## 注意
+
+- no_succ 不等于坏 demo:它只表示当前环境版本下回灌后未达 success,根因多为录制版本与回放版本不一致(mujoco / bigym 升级),非演示本身错误。
+- 审计结果随环境依赖版本变化:换 mujoco 或 bigym 版本后,各任务成功率会变,需重跑。
+- 脚本只读 demo + 跑物理 + 统计,不写入任何数据集或模型。
