+def _write_profile(profile_path: Path, source: dict[str, Any], alignment: dict[str, Any],
+                   selected: dict[str, Any], output_dir: Path, *,
+                   search_mode: str, selection_report: str) -> Path:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    alignment_out = {**alignment, "gaussian_to_mujoco": selected["gaussian_to_mujoco"],
+                     "mujoco_to_gaussian": np.linalg.inv(np.asarray(selected["gaussian_to_mujoco"])).tolist(),
+                     "adaptive_clarity_search": {"task": "DishwasherUnloadCutleryLong",
+                         "required_cameras": list(REQUIRED_CAMERAS), "selected": selected["parameters"],
+                         "search_mode": search_mode,
+                         "selection_report": selection_report}}
+    alignment_file = output_dir / "alignment-adaptive-clarity.json"
+    alignment_file.write_text(json.dumps(alignment_out, indent=2) + "\n")
+    cameras = _resolve_camera_set()
+    profile = {**source, "name": f"{source.get('name', 'visual-shell')}-adaptive-clarity-threecam",
+               "alignment": {"path": alignment_file.name},
+               "integration_contract": {**source.get("integration_contract", {}),
+                   "camera_set": DEFAULT_CAMERA_SET, "camera_names": [x.name for x in cameras],
+                   "external_camera": None, "foreground_policy": "dynamic_only",
+                   "background_physics": {"body_count": 0, "geom_count": 0, "collision_count": 0}},
+               "quality": {**source.get("quality", {}), "status": "awaiting_visual_approval",
+                   "formal_collection_recommended": False, "awaiting_visual_approval": True,
+                   "adaptive_clarity_gate_passed": True}}
+    destination = output_dir / "profile.json"
+    destination.write_text(json.dumps(profile, indent=2) + "\n")
+    for filename in set(profile["layer_files"].values()):
+        target = output_dir / filename
+        if target.exists() or target.is_symlink(): target.unlink()
+        os.symlink((profile_path.parent / filename).resolve(), target)
+    return destination
+
+
+def _write_contact_sheet(previews: dict[int, dict[str, np.ndarray]], ranked: list[dict[str, Any]], path: Path) -> None:
+    if not ranked:
+        return
+    rows = []
+    for result in ranked[:5]:
+        index = result["candidate_index"]
+        cells = []
+        for camera in REQUIRED_CAMERAS:
+            image = cv2.resize(previews[index][camera], (424, 240), interpolation=cv2.INTER_AREA)
+            cv2.rectangle(image, (0, 0), (424, 30), (0, 0, 0), -1)
+            cv2.putText(image, f"c{index} {camera} pass={result['gate']['per_camera'][camera]['passed']}",
+                        (8, 21), cv2.FONT_HERSHEY_SIMPLEX, .45, (255,255,255), 1, cv2.LINE_AA)
+            cells.append(image)
+        rows.append(np.concatenate(cells, axis=1))
+    cv2.imwrite(str(path), cv2.cvtColor(np.concatenate(rows, axis=0), cv2.COLOR_RGB2BGR))
+
