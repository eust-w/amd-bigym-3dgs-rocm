+            "camera_set": FOUR_CAMERA_SET,
+            "camera_names": [camera.name for camera in cameras],
+            "foreground_policy": args.foreground_policy,
+            "native_background_geom_names": ["floor"],
+            "observations": observations,
+            "external_camera": {
+                "position_m": list(EXTERNAL_CAMERA.pos or ()),
+                "quaternion_wxyz": list(EXTERNAL_CAMERA.quat or ()),
+                "resolution_hw": list(EXTERNAL_CAMERA.resolution),
+                "fovy_degrees": EXTERNAL_CAMERA.fovy,
+                "fixed_in_mujoco_world": True,
+            },
+            "background_physics": {
+                "body_count": 0,
+                "geom_count": 0,
