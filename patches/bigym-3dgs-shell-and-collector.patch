+#!/usr/bin/env python3
+"""Adaptive fail-closed search for a clear three-camera Gaussian shell pose.
+
+The canonical BiGym world and H1 camera mounts never move.  Candidates only
+post-transform the visual shell around its floor anchor.  The head and both
+wrist cameras are mandatory; an external camera is explicitly diagnostic and
+is not allowed to rescue a failed formal camera.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import traceback
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+import cv2
+import numpy as np
+from scipy.stats import qmc
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from optimize_visual_shell_pose import (
+    TrajectoryPoseObjective,
+    load_source_cameras,
+    yaw_rotation,
+)
+from run_receipt import profile_snapshot, runtime_snapshot
+
+
+DEFAULT_CAMERA_SET = "bigym-plus-3"
+REQUIRED_CAMERAS = ("head", "left_wrist", "right_wrist")
+CAPTURE_PATH_LIMITS = {
+    "head": {"translation_p90_m": 0.3553, "rotation_p90_degrees": 71.46},
+    "left_wrist": {"translation_p90_m": 0.8929, "rotation_p90_degrees": 84.47},
+    "right_wrist": {"translation_p90_m": 0.8290, "rotation_p90_degrees": 58.92},
+}
+METRIC_ROOM_COVERAGE = "free-view-obb"
+SOURCE_PATH_COVERAGE = "source-path"
+METRIC_ROOM_TASK_MARGIN_XY_M = 0.15
+METRIC_ROOM_FLOOR_TOLERANCE_M = 0.10
+
+
+def _resolve_camera_set():
+    from env_utils import resolve_camera_set
+
+    return resolve_camera_set(DEFAULT_CAMERA_SET)
+
+
+def _post_transform(
+    scale: float,
+    yaw_degrees: float,
+    translation_xyz_m: np.ndarray,
+    anchor_xyz_m: np.ndarray,
+) -> np.ndarray:
+    rotation_scale = scale * yaw_rotation(yaw_degrees)
+    transform = np.eye(4, dtype=np.float64)
+    transform[:3, :3] = rotation_scale
+    transform[:3, 3] = anchor_xyz_m - rotation_scale @ anchor_xyz_m + translation_xyz_m
+    return transform
+
+
+def _candidate_set(
+    count: int,
+    seed: int,
+    *,
+    scale_range: tuple[float, float] = (0.80, 1.15),
+    yaw_limit_degrees: float = 20.0,
+    translation_xy_limit_m: float = 0.30,
+    translation_z_limit_m: float = 0.05,
+) -> list[dict[str, float]]:
+    """Deterministic Sobol search including the exact baseline as candidate 0."""
+
+    if count < 1:
+        return []
+    dimensions = 5
+    exponent = int(np.ceil(np.log2(max(count - 1, 1))))
+    samples = qmc.Sobol(d=dimensions, scramble=True, seed=seed).random_base2(exponent)
+    lower = np.asarray(
+        [scale_range[0], -yaw_limit_degrees, -translation_xy_limit_m,
+         -translation_xy_limit_m, -translation_z_limit_m],
+        dtype=np.float64,
+    )
+    upper = np.asarray(
+        [scale_range[1], yaw_limit_degrees, translation_xy_limit_m,
+         translation_xy_limit_m, translation_z_limit_m],
+        dtype=np.float64,
+    )
+    values = qmc.scale(samples, lower, upper)
+    candidates = [{"scale": 1.0, "yaw": 0.0, "x": 0.0, "y": 0.0, "z": 0.0}]
+    for scale, yaw, x, y, z in values[: max(count - 1, 0)]:
+        candidates.append(
+            {"scale": float(scale), "yaw": float(yaw), "x": float(x),
+             "y": float(y), "z": float(z)}
+        )
+    return candidates
+
+
+def _metric_room_candidate_set(
+    count: int,
+    seed: int,
+    *,
+    translation_xy_limit_m: float = 0.35,
+) -> list[dict[str, float]]:
+    """Sample fixed-metric room placements over XY and a full yaw turn."""
+
+    if count < 1:
+        return []
+    exponent = int(np.ceil(np.log2(max(count - 1, 1))))
+    samples = qmc.Sobol(d=3, scramble=True, seed=seed).random_base2(exponent)
+    values = qmc.scale(
+        samples,
+        [-translation_xy_limit_m, -translation_xy_limit_m, 0.0],
+        [translation_xy_limit_m, translation_xy_limit_m, 360.0],
+    )
+    candidates = [
+        {"scale": 1.0, "yaw": 0.0, "x": 0.0, "y": 0.0, "z": 0.0}
+    ]
+    for x, y, yaw in values[: max(count - 1, 0)]:
+        candidates.append(
+            {
+                "scale": 1.0,
+                "yaw": float(yaw),
+                "x": float(x),
+                "y": float(y),
+                "z": 0.0,
+            }
+        )
+    return candidates
+
+
+def _metric_room_refined_candidate_set(
+    parents: list[dict[str, Any]],
+    count: int,
+    seed: int,
+    *,
+    translation_xy_limit_m: float = 0.35,
+) -> list[dict[str, float]]:
+    """Refine fixed-scale room placements without changing floor height."""
+
+    if not parents or count < 1:
+        return []
+    samples = qmc.Sobol(d=3, scramble=True, seed=seed).random_base2(
+        int(np.ceil(np.log2(count)))
+    )[:count]
+    signed = 2.0 * samples - 1.0
+    output = [dict(item["parameters"]) for item in parents[:count]]
+    for index in range(len(output), count):
+        parent = parents[index % len(parents)]["parameters"]
+        output.append(
+            {
+                "scale": 1.0,
+                "yaw": float((parent["yaw"] + 18.0 * signed[index, 2]) % 360.0),
+                "x": float(
+                    np.clip(
+                        parent["x"] + 0.07 * signed[index, 0],
+                        -translation_xy_limit_m,
+                        translation_xy_limit_m,
+                    )
+                ),
+                "y": float(
+                    np.clip(
+                        parent["y"] + 0.07 * signed[index, 1],
+                        -translation_xy_limit_m,
+                        translation_xy_limit_m,
+                    )
+                ),
+                "z": 0.0,
+            }
+        )
+    return output
+
+
+def _obb_corners(minimum: np.ndarray, maximum: np.ndarray) -> np.ndarray:
+    return np.asarray(
+        [
+            [x, y, z]
+            for x in (minimum[0], maximum[0])
+            for y in (minimum[1], maximum[1])
+            for z in (minimum[2], maximum[2])
+        ],
+        dtype=np.float64,
+    )
+
+
+def _points_in_candidate_frame(
+    points: np.ndarray,
+    gaussian_to_mujoco: np.ndarray,
+) -> np.ndarray:
+    points = np.asarray(points, dtype=np.float64)
+    inverse = np.linalg.inv(np.asarray(gaussian_to_mujoco, dtype=np.float64))
+    return points @ inverse[:3, :3].T + inverse[:3, 3]
+
+
+def _obb_point_contract(
+    points: np.ndarray,
+    minimum: np.ndarray,
+    maximum: np.ndarray,
+) -> dict[str, Any]:
+    lower = points - minimum
+    upper = maximum - points
+    clearances = np.minimum(lower, upper)
+    outside = np.any(clearances < -1e-9, axis=1)
+    return {
+        "point_count": len(points),
+        "inside_count": int(np.count_nonzero(~outside)),
+        "outside_count": int(np.count_nonzero(outside)),
+        "inside_fraction": float(np.mean(~outside)) if len(points) else 0.0,
+        "minimum_clearance_m": float(np.min(clearances)) if len(points) else -1.0,
+        "minimum_clearance_xyz_m": (
+            np.min(clearances, axis=0).astype(float).tolist()
+            if len(points)
+            else [-1.0, -1.0, -1.0]
+        ),
+    }
+
+
+def _profile_room_contract(profile: dict[str, Any]) -> dict[str, np.ndarray]:
+    contract = profile.get("free_view_contract", {})
+    safe = contract.get("safe_space_obb_mujoco")
+    clear = contract.get("clear_obb_mujoco")
+    if not isinstance(safe, dict) or not isinstance(clear, dict):
+        raise ValueError(
+            "free-view-obb coverage requires safe_space_obb_mujoco and "
+            "clear_obb_mujoco"
+        )
+    output = {
+        "safe_min": np.asarray(safe.get("min"), dtype=np.float64),
+        "safe_max": np.asarray(safe.get("max"), dtype=np.float64),
+        "clear_min": np.asarray(clear.get("min"), dtype=np.float64),
+        "clear_max": np.asarray(clear.get("max"), dtype=np.float64),
+    }
+    for name, value in output.items():
+        if value.shape != (3,) or not np.isfinite(value).all():
+            raise ValueError(f"invalid free-view room bound: {name}")
+    if np.any(output["safe_max"] <= output["safe_min"]) or np.any(
+        output["clear_max"] <= output["clear_min"]
+    ):
+        raise ValueError("free-view room bounds must have positive extent")
+    return output
+
+
+def _trajectory_camera_points(trajectory: Any) -> dict[str, np.ndarray]:
+    return {
+        name: np.asarray(trajectory[f"{name}_positions"], dtype=np.float64)
+        for name in REQUIRED_CAMERAS
+    }
+
+
+def _metric_room_coverage(
+    gaussian_to_mujoco: np.ndarray,
+    trajectory: Any,
+    task_obb_world: dict[str, np.ndarray],
+    room: dict[str, np.ndarray],
+    *,
+    task_margin_xy_m: float = METRIC_ROOM_TASK_MARGIN_XY_M,
+    floor_tolerance_m: float = METRIC_ROOM_FLOOR_TOLERANCE_M,
+) -> dict[str, Any]:
+    per_camera = {}
+    all_cameras_inside = True
+    for name, points in _trajectory_camera_points(trajectory).items():
+        transformed = _points_in_candidate_frame(points, gaussian_to_mujoco)
+        result = _obb_point_contract(
+            transformed,
+            room["safe_min"],
+            room["safe_max"],
+        )
+        result["all_frames_inside_safe_obb"] = result["outside_count"] == 0
+        all_cameras_inside &= result["all_frames_inside_safe_obb"]
+        per_camera[name] = result
+
+    task_corners = _obb_corners(
+        np.asarray(task_obb_world["min"], dtype=np.float64),
+        np.asarray(task_obb_world["max"], dtype=np.float64),
+    )
+    transformed_task = _points_in_candidate_frame(
+        task_corners,
+        gaussian_to_mujoco,
+    )
+    task = _obb_point_contract(
+        transformed_task,
+        room["clear_min"],
+        room["clear_max"],
+    )
+    clearance = np.asarray(task["minimum_clearance_xyz_m"], dtype=np.float64)
+    # The physical and Gaussian floors share a fixed anchor.  Requiring a
+    # 15 cm vertical gap would reject every floor-standing task by design, so
+    # the safety margin applies to room walls (XY); Z remains fail-closed on
+    # containment.
+    task["minimum_horizontal_clearance_m"] = float(np.min(clearance[:2]))
+    task["horizontal_margin_required_m"] = float(task_margin_xy_m)
+    task["horizontal_margin_passed"] = bool(
+        task["minimum_horizontal_clearance_m"] >= task_margin_xy_m
+    )
+    task_minimum = transformed_task.min(axis=0)
+    task_maximum = transformed_task.max(axis=0)
+    task["floor_tolerance_m"] = float(floor_tolerance_m)
+    task["vertical_lower_bound_passed"] = bool(
+        task_minimum[2] >= room["clear_min"][2] - floor_tolerance_m
+    )
+    task["vertical_upper_bound_passed"] = bool(
+        task_maximum[2] <= room["clear_max"][2] + 1e-9
+    )
+    task["vertical_containment_passed"] = bool(
+        task["vertical_lower_bound_passed"]
+        and task["vertical_upper_bound_passed"]
+    )
+    task["floor_anchor_exception"] = (
+        "margin_xy_only; lower_z_allows_declared_floor_tolerance; "
+        "upper_z_is_strict"
+    )
+    task_passed = bool(
+        task["horizontal_margin_passed"]
+        and task["vertical_containment_passed"]
+    )
+    centre = 0.5 * (transformed_task.min(axis=0) + transformed_task.max(axis=0))
+    clear_centre = 0.5 * (room["clear_min"] + room["clear_max"])
+    centre_error = float(np.linalg.norm(centre - clear_centre))
+    minimum_camera_clearance = min(
+        float(item["minimum_clearance_m"]) for item in per_camera.values()
+    )
+    return {
+        "contract": METRIC_ROOM_COVERAGE,
+        "passed": bool(all_cameras_inside and task_passed),
+        "per_camera": per_camera,
+        "task_obb": task,
+        "task_obb_world": {
+            "min": np.asarray(task_obb_world["min"]).astype(float).tolist(),
+            "max": np.asarray(task_obb_world["max"]).astype(float).tolist(),
+        },
+        "task_centre_to_clear_centre_m": centre_error,
+        "analytic_rank": [minimum_camera_clearance, -centre_error],
+    }
+
+
+def _prefilter_metric_room(
+    candidates: list[dict[str, float]],
+    transforms: list[np.ndarray],
+    trajectory: Any,
+    task_obb_world: dict[str, np.ndarray],
+    room: dict[str, np.ndarray],
+    *,
+    render_limit: int,
+) -> tuple[
+    list[dict[str, float]],
+    list[np.ndarray],
+    list[dict[str, Any]],
+    list[dict[str, Any]],
+]:
+    accepted = []
+    rejected = []
+    for index, (candidate, transform) in enumerate(
+        zip(candidates, transforms, strict=True)
+    ):
+        coverage = _metric_room_coverage(
+            transform,
+            trajectory,
+            task_obb_world,
+            room,
+        )
+        row = {
+            "source_candidate_index": index,
+            "parameters": candidate,
+            "coverage": coverage,
+            "transform": transform,
+        }
+        (accepted if coverage["passed"] else rejected).append(row)
+    accepted.sort(
+        key=lambda row: tuple(row["coverage"]["analytic_rank"]),
+        reverse=True,
+    )
+    rendered = accepted[:render_limit]
+    return (
+        [row["parameters"] for row in rendered],
+        [row["transform"] for row in rendered],
+        [row["coverage"] for row in rendered],
+        [
+            {
+                "source_candidate_index": row["source_candidate_index"],
+                "parameters": row["parameters"],
+                "coverage": row["coverage"],
+            }
+            for row in [*accepted[render_limit:], *rejected]
+        ],
+    )
+
+
+def _refined_candidate_set(
+    parents: list[dict[str, Any]],
+    count: int,
+    seed: int,
+    *,
+    scale_range: tuple[float, float],
+    yaw_limit_degrees: float,
+    translation_xy_limit_m: float,
+    translation_z_limit_m: float,
+) -> list[dict[str, float]]:
+    """Sample shrinking deterministic neighborhoods around retained parents."""
+
+    if not parents or count < 1:
+        return []
+    unit = qmc.Sobol(d=5, scramble=True, seed=seed).random_base2(
+        int(np.ceil(np.log2(count)))
+    )[:count]
+    signed = 2.0 * unit - 1.0
+    radii = np.asarray(
+        [0.08 * (scale_range[1] - scale_range[0]), 0.18 * yaw_limit_degrees,
+         0.18 * translation_xy_limit_m, 0.18 * translation_xy_limit_m,
+         0.18 * max(translation_z_limit_m, 1e-9)],
+        dtype=np.float64,
+    )
+    bounds_low = np.asarray(
+        [scale_range[0], -yaw_limit_degrees, -translation_xy_limit_m,
+         -translation_xy_limit_m, -translation_z_limit_m]
+    )
+    bounds_high = -bounds_low
+    bounds_high[0] = scale_range[1]
+    output: list[dict[str, float]] = [dict(item["parameters"]) for item in parents[:count]]
+    for index in range(len(output), count):
+        parent = parents[index % len(parents)]["parameters"]
+        centre = np.asarray(
+            [parent["scale"], parent["yaw"], parent["x"], parent["y"], parent["z"]]
+        )
+        value = np.clip(centre + signed[index] * radii, bounds_low, bounds_high)
+        output.append(dict(zip(("scale", "yaw", "x", "y", "z"), map(float, value))))
+    return output
+
+
+def _capture_path_gate(coverage: dict[str, Any]) -> bool:
+    for camera, limits in CAPTURE_PATH_LIMITS.items():
+        path = coverage["per_camera"][camera]
+        if path["capture_path_translation_m"]["p90"] > limits["translation_p90_m"]:
+            return False
+        if path["capture_path_rotation_degrees"]["p90"] > limits["rotation_p90_degrees"]:
+            return False
+    return True
+
+
+def _prefilter_capture_path(
+    candidates: list[dict[str, float]],
+    transforms: list[np.ndarray],
+    source_cameras: np.ndarray,
+    trajectory: Any,
+) -> tuple[list[dict[str, float]], list[np.ndarray], int]:
+    """Reject source-coverage failures before spending GPU renders on them."""
+
+    kept_candidates: list[dict[str, float]] = []
+    kept_transforms: list[np.ndarray] = []
+    for candidate, transform in zip(candidates, transforms, strict=True):
+        _, coverage = TrajectoryPoseObjective(
+            source_cameras, transform, trajectory, stride=8
+        ).evaluate([0, 0, 0])
+        if _capture_path_gate(coverage):
+            kept_candidates.append(candidate)
+            kept_transforms.append(transform)
+    return kept_candidates, kept_transforms, len(candidates) - len(kept_candidates)
+
+
+def _pure_gaussian(shell, model, data, camera_id: int, height: int, width: int):
+    buffers = shell.render_buffers(
+        model, data, camera_id, height, width,
+        background_rgb=np.zeros((height, width, 3), dtype=np.uint8),
+        include_expected_depth=True,
+    )
+    if buffers.alpha is None or buffers.expected_depth_m is None:
+        raise RuntimeError("adaptive search requires Gaussian RGB, alpha, and depth")
+    return buffers.rgb, buffers.alpha, buffers.expected_depth_m
+
+
+def _task_context_mask(
+    foreground: np.ndarray,
+    *,
+    inner_radius_px: int = 2,
+    outer_radius_px: int = 96,
+) -> np.ndarray:
+    """Full task ROI, including its interior, excluding only a thin seam band."""
+
+    if inner_radius_px < 0 or outer_radius_px <= inner_radius_px:
+        raise ValueError("task ROI radii must satisfy 0 <= inner < outer")
+    source = np.asarray(foreground, dtype=np.uint8)
+    if not np.any(source):
+        return np.zeros_like(source, dtype=bool)
+    outer_kernel = cv2.getStructuringElement(
+        cv2.MORPH_ELLIPSE, (2 * outer_radius_px + 1, 2 * outer_radius_px + 1)
+    )
+    region = cv2.dilate(source, outer_kernel).astype(bool)
+    if inner_radius_px:
+        seam_kernel = cv2.getStructuringElement(
+            cv2.MORPH_ELLIPSE, (2 * inner_radius_px + 1, 2 * inner_radius_px + 1)
+        )
+        dilated = cv2.dilate(source, seam_kernel).astype(bool)
+        # Keep the full projected task interior (we score the pure Gaussian,
+        # not native CAD pixels) and remove only the outside antialias seam.
+        region &= ~(dilated & ~source.astype(bool))
+    return region
+
+
+def _task_region_from_segmentation(shell, model, segmentation: np.ndarray) -> np.ndarray:
+    """Union H1/dynamic pixels with dishwasher, drawer, tray and cutlery geoms."""
+
+    task = shell.native_foreground_mask(segmentation)
+    object_ids = np.asarray(segmentation)[..., 0]
+    object_types = np.asarray(segmentation)[..., 1]
+    try:
+        import mujoco
+
+        geom_type = int(mujoco.mjtObj.mjOBJ_GEOM)
+        keywords = (
+            "dishwasher", "drawer", "cutlery", "utensil", "tray", "basket",
+            "fork", "knife", "spoon", "plate", "h1", "robot",
+        )
+        for geom_id in np.unique(object_ids[object_types == geom_type]):
+            geom_id = int(geom_id)
+            if geom_id < 0 or geom_id >= model.ngeom:
+                continue
+            name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_GEOM, geom_id) or ""
+            if any(token in name.lower() for token in keywords):
+                task |= (object_types == geom_type) & (object_ids == geom_id)
+    except (ImportError, AttributeError, ValueError):
+        pass
+    return task
+
+
+def _task_geom_ids(shell: Any, model: Any) -> np.ndarray:
+    """Resolve robot and task-object geoms without including the native room."""
+
+    selected = {int(value) for value in shell.dynamic_foreground_geom_ids}
+    keywords = (
+        "dishwasher",
+        "drawer",
+        "cutlery",
+        "utensil",
+        "tray",
+        "basket",
+        "fork",
+        "knife",
+        "spoon",
+        "plate",
+        "h1",
+        "robot",
+    )
+    try:
+        import mujoco
+
+        for geom_id in range(model.ngeom):
+            name = (
+                mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_GEOM, geom_id)
+                or ""
+            )
+            if any(token in name.lower() for token in keywords):
+                selected.add(geom_id)
+    except (ImportError, AttributeError, ValueError):
+        pass
+    if not selected:
+        raise RuntimeError("failed to resolve H1 and task-object geoms")
+    return np.asarray(sorted(selected), dtype=np.int64)
+
+
+def _geom_local_corners(model: Any, geom_id: int) -> np.ndarray | None:
+    """Return a tight local AABB for one MuJoCo geom."""
+
+    import mujoco
+
+    geom_type = int(model.geom_type[geom_id])
+    size = np.asarray(model.geom_size[geom_id], dtype=np.float64)
+    if geom_type == int(mujoco.mjtGeom.mjGEOM_PLANE):
+        return None
+    if geom_type == int(mujoco.mjtGeom.mjGEOM_SPHERE):
+        extent = np.repeat(size[0], 3)
+    elif geom_type == int(mujoco.mjtGeom.mjGEOM_CAPSULE):
+        extent = np.asarray([size[0], size[0], size[1] + size[0]])
+    elif geom_type == int(mujoco.mjtGeom.mjGEOM_CYLINDER):
+        extent = np.asarray([size[0], size[0], size[1]])
+    elif geom_type in {
+        int(mujoco.mjtGeom.mjGEOM_ELLIPSOID),
+        int(mujoco.mjtGeom.mjGEOM_BOX),
+    }:
+        extent = size
+    elif geom_type == int(mujoco.mjtGeom.mjGEOM_MESH):
+        mesh_id = int(model.geom_dataid[geom_id])
+        if mesh_id < 0:
+            return None
+        start = int(model.mesh_vertadr[mesh_id])
+        count = int(model.mesh_vertnum[mesh_id])
+        vertices = np.asarray(
+            model.mesh_vert[start : start + count], dtype=np.float64
+        )
+        if len(vertices) == 0 or not np.isfinite(vertices).all():
+            return None
+        return _obb_corners(vertices.min(axis=0), vertices.max(axis=0))
+    else:
+        radius = float(model.geom_rbound[geom_id])
+        if not np.isfinite(radius) or radius <= 0.0 or radius >= 3.0:
+            return None
+        extent = np.repeat(radius, 3)
+    if not np.isfinite(extent).all() or np.any(extent <= 0.0):
+        return None
+    return _obb_corners(-extent, extent)
+
+
+def _collect_task_obb(
+    env: Any,
+    actions: np.ndarray,
+    seed: int,
+    *,
+    frame_count: int = 649,
+) -> dict[str, Any]:
+    """Collect a conservative world OBB before any Gaussian rendering."""
+
+    if len(actions) < frame_count:
+        raise ValueError(
+            f"trajectory has {len(actions)} actions; expected {frame_count}"
+        )
+    shell = env._visual_shell
+    model = env.mojo.model
+    data = env.mojo.data
+    geom_ids = _task_geom_ids(shell, model)
+    local_corners = []
+    kept_geom_ids = []
+    for geom_id in geom_ids:
+        corners = _geom_local_corners(model, int(geom_id))
+        if corners is not None:
+            kept_geom_ids.append(int(geom_id))
+            local_corners.append(corners)
+    geom_ids = np.asarray(kept_geom_ids, dtype=np.int64)
+    if len(geom_ids) == 0:
+        raise RuntimeError("task OBB contains no finite task geometry")
+    minimum = np.full(3, np.inf, dtype=np.float64)
+    maximum = np.full(3, -np.inf, dtype=np.float64)
+    env.reset(seed=seed)
+    for frame in range(frame_count):
+        for geom_id, corners in zip(geom_ids, local_corners, strict=True):
+            rotation = np.asarray(data.geom_xmat[geom_id], dtype=np.float64).reshape(
+                3, 3
+            )
+            centre = np.asarray(data.geom_xpos[geom_id], dtype=np.float64)
+            world = corners @ rotation.T + centre
+            minimum = np.minimum(minimum, world.min(axis=0))
+            maximum = np.maximum(maximum, world.max(axis=0))
+        if frame + 1 < frame_count:
+            env.step(actions[frame], fast=True)
+    if not np.isfinite(minimum).all() or not np.isfinite(maximum).all():
+        raise RuntimeError("task OBB collection produced non-finite bounds")
+    return {
+        "min": minimum,
+        "max": maximum,
+        "geom_count": len(geom_ids),
+        "frame_count": int(frame_count),
+    }
+
+
+def _depth_conflict_metrics(
+    gaussian_depth_m: np.ndarray,
+    alpha: np.ndarray,
+    native_depth_m: np.ndarray,
+    task_region: np.ndarray,
+    *,
+    tolerance_m: float = 0.02,
+) -> dict[str, float | int]:
+    valid = (
+        task_region & np.isfinite(native_depth_m) & (native_depth_m > 0)
+        & np.isfinite(gaussian_depth_m) & (gaussian_depth_m > 0) & (alpha >= 0.05)
+    )
+    conflict = valid & (gaussian_depth_m < native_depth_m - tolerance_m)
+    return {
+        "depth_valid_pixels": int(np.count_nonzero(valid)),
+        "depth_conflict_pixels": int(np.count_nonzero(conflict)),
+        "depth_conflict_fraction": float(np.mean(conflict[valid])) if np.any(valid) else 0.0,
+    }
+
+
+def _task_context_metrics(
+    pure: np.ndarray,
+    alpha: np.ndarray,
+    foreground: np.ndarray,
+    *,
+    inner_radius_px: int = 2,
+    outer_radius_px: int = 96,
+    context_mask: np.ndarray | None = None,
+) -> dict[str, float]:
+    context = np.asarray(context_mask, dtype=bool) if context_mask is not None else _task_context_mask(
+        foreground, inner_radius_px=inner_radius_px, outer_radius_px=outer_radius_px
+    )
+    opaque = context & (alpha >= 0.5)
+    count = int(np.count_nonzero(context))
+    visible_count = int(np.count_nonzero(opaque))
+    empty = {
+        "task_context_fraction": float(np.mean(context)),
+        "task_context_gaussian_coverage": 0.0,
+        "task_context_hole_fraction": 1.0,
+        "task_context_luma_mean": 0.0,
+        "task_context_luma_std": 0.0,
+        "task_context_laplacian_variance": 0.0,
+        "task_context_gradient_mean": 0.0,
+        "task_context_edge_density": 0.0,
+        "task_context_dark_fraction": 1.0,
+        "task_context_bright_fraction": 1.0,
+        "task_context_semitransparent_fraction": 1.0,
+        "task_context_severe_fog_fraction": 1.0,
+        "task_context_largest_problem_component_fraction": 1.0,
+        "task_context_clear_score": 0.0,
+    }
+    if count == 0 or visible_count == 0:
+        return empty
+    gray = cv2.cvtColor(pure, cv2.COLOR_RGB2GRAY)
+    values = gray[opaque].astype(np.float64)
+    laplacian = cv2.Laplacian(gray, cv2.CV_64F)
+    gx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
+    gy = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)
+    gradient = np.hypot(gx, gy)
+    edges = cv2.Canny(gray, 50, 100) > 0
+    local_mean = cv2.blur(gray.astype(np.float32), (15, 15))
+    local_square_mean = cv2.blur(
+        np.square(gray.astype(np.float32)), (15, 15)
+    )
+    local_std = np.sqrt(
+        np.maximum(local_square_mean - np.square(local_mean), 0.0)
+    )
+    semitransparent = context & (alpha >= 0.05) & (alpha < 0.95)
+    severe_fog = semitransparent & (local_std < 8.0) & (gradient < 8.0)
+    problem = context & ((alpha < 0.5) | severe_fog)
+    component_count, _labels, stats, _ = cv2.connectedComponentsWithStats(
+        problem.astype(np.uint8),
+        connectivity=8,
+    )
+    largest_problem = (
+        int(np.max(stats[1:, cv2.CC_STAT_AREA]))
+        if component_count > 1
+        else 0
+    )
+    coverage = visible_count / count
+    std = float(np.std(values))
+    detail = float(np.var(laplacian[opaque]))
+    gradient_mean = float(np.mean(gradient[opaque]))
+    edge_density = float(np.mean(edges[opaque]))
+    score = coverage * (
+        0.30 * float(np.clip(std / 45.0, 0, 1))
+        + 0.30 * float(np.clip(np.log1p(detail) / 7.0, 0, 1))
+        + 0.20 * float(np.clip(gradient_mean / 80.0, 0, 1))
+        + 0.20 * float(np.clip(edge_density / 0.16, 0, 1))
+    )
+    return {
+        "task_context_fraction": float(np.mean(context)),
+        "task_context_gaussian_coverage": float(coverage),
+        "task_context_hole_fraction": float(1.0 - coverage),
+        "task_context_luma_mean": float(np.mean(values)),
+        "task_context_luma_std": std,
+        "task_context_laplacian_variance": detail,
+        "task_context_gradient_mean": gradient_mean,
+        "task_context_edge_density": edge_density,
+        "task_context_dark_fraction": float(np.mean(values < 18.0)),
+        "task_context_bright_fraction": float(np.mean(values > 245.0)),
+        "task_context_semitransparent_fraction": float(
+            np.count_nonzero(semitransparent) / count
+        ),
+        "task_context_severe_fog_fraction": float(
+            np.count_nonzero(severe_fog) / count
+        ),
+        "task_context_largest_problem_component_fraction": float(
+            largest_problem / count
+        ),
+        "task_context_clear_score": float(score),
+    }
+
+
+def _percentiles(values: Iterable[float]) -> dict[str, float]:
+    data = np.asarray(list(values), dtype=np.float64)
+    return {"p10": float(np.percentile(data, 10)), "mean": float(np.mean(data)),
+            "maximum": float(np.max(data))}
+
+
+def _camera_summary(metrics: list[dict[str, Any]], camera: str) -> dict[str, Any]:
+    rows = [item for item in metrics if item["camera"] == camera]
+    return {
+        "frame_count": len(rows),
+        "coverage": _percentiles(item["task_context_gaussian_coverage"] for item in rows),
+        "holes": _percentiles(item["task_context_hole_fraction"] for item in rows),
+        "semitransparent": _percentiles(
+            item.get("task_context_semitransparent_fraction", 0.0)
+            for item in rows
+        ),
+        "severe_fog": _percentiles(
+            item.get("task_context_severe_fog_fraction", 0.0)
+            for item in rows
+        ),
+        "largest_problem_component": _percentiles(
+            item.get("task_context_largest_problem_component_fraction", 0.0)
+            for item in rows
+        ),
+        "clear_score": _percentiles(item["task_context_clear_score"] for item in rows),
+        "edge_density": _percentiles(item["task_context_edge_density"] for item in rows),
+        "dark_fraction": _percentiles(item["task_context_dark_fraction"] for item in rows),
+        "bright_fraction": _percentiles(item["task_context_bright_fraction"] for item in rows),
+        "depth_conflict": _percentiles(item["depth_conflict_fraction"] for item in rows),
+    }
+
+
+def _gate_candidate(
+    metrics: list[dict[str, Any]],
+    baseline: dict[str, Any],
+    trajectory_coverage: dict[str, Any],
+    required_cameras: tuple[str, ...] = REQUIRED_CAMERAS,
+    coverage_contract: str = SOURCE_PATH_COVERAGE,
+) -> dict[str, Any]:
+    per_camera: dict[str, Any] = {}
+    all_passed = True
+    for camera in required_cameras:
+        current = _camera_summary(metrics, camera)
+        reference = baseline[camera]
+        path = trajectory_coverage["per_camera"][camera]
+        limits = CAPTURE_PATH_LIMITS[camera]
+        minimum_coverage = 0.95 if coverage_contract == METRIC_ROOM_COVERAGE else 0.90
+        checks = {
+            "coverage_p10": current["coverage"]["p10"] >= max(minimum_coverage, reference["coverage"]["p10"]),
+            "holes_max": current["holes"]["maximum"] <= 0.010000001,
+            "severe_fog_max": current["severe_fog"]["maximum"] <= 0.010000001,
+            "largest_problem_component_max": current["largest_problem_component"]["maximum"] <= 0.010000001,
+            "clear_p10": current["clear_score"]["p10"] >= reference["clear_score"]["p10"],
+            "edge_p10": current["edge_density"]["p10"] >= reference["edge_density"]["p10"],
+            "dark_not_worse": current["dark_fraction"]["mean"] <= reference["dark_fraction"]["mean"] + 1e-9,
+            "bright_not_worse": current["bright_fraction"]["mean"] <= reference["bright_fraction"]["mean"] + 1e-9,
+            "depth_conflict_max": current["depth_conflict"]["maximum"] <= 0.01,
+        }
+        if coverage_contract == SOURCE_PATH_COVERAGE:
+            checks.update(
+                {
+                    "capture_translation_p90": path[
+                        "capture_path_translation_m"
+                    ]["p90"]
+                    <= limits["translation_p90_m"],
+                    "capture_rotation_p90": path[
+                        "capture_path_rotation_degrees"
+                    ]["p90"]
+                    <= limits["rotation_p90_degrees"],
+                }
+            )
+        elif coverage_contract == METRIC_ROOM_COVERAGE:
+            checks["all_frames_inside_safe_obb"] = bool(
+                path["all_frames_inside_safe_obb"]
+            )
+        else:
+            raise ValueError(f"unsupported coverage contract: {coverage_contract}")
+        passed = all(checks.values())
+        all_passed &= passed
+        per_camera[camera] = {"passed": passed, "checks": checks, "metrics": current,
+                              "baseline": reference, "capture_path": path, "limits": limits}
+    current_mean = float(
+        np.mean(
+            [per_camera[name]["metrics"]["clear_score"]["mean"] for name in required_cameras]
+        )
+    )
+    baseline_mean = float(
+        np.mean([baseline[name]["clear_score"]["mean"] for name in required_cameras])
+    )
+    global_checks = {
+        "three_camera_mean_clear_plus_10_percent": current_mean
+        >= 1.10 * baseline_mean,
+    }
+    if coverage_contract == METRIC_ROOM_COVERAGE:
+        global_checks["metric_room_contract"] = bool(
+            trajectory_coverage.get("passed", False)
+        )
+    all_passed &= all(global_checks.values())
+    reasons = [f"{camera}:{name}" for camera, result in per_camera.items()
+               for name, passed in result["checks"].items() if not passed]
+    reasons.extend(
+        f"global:{name}" for name, passed in global_checks.items() if not passed
+    )
+    return {"passed": bool(all_passed), "clear_camera_count": int(sum(x["passed"] for x in per_camera.values())),
+            "required_cameras": list(required_cameras), "per_camera": per_camera,
+            "global_checks": global_checks,
+            "three_camera_mean_clear": current_mean,
+            "baseline_three_camera_mean_clear": baseline_mean,
+            "rejection_reasons": reasons}
+
+
+def _rank_key(result: dict[str, Any]) -> tuple[float, ...]:
+    gate = result["gate"]
+    summaries = [gate["per_camera"][name]["metrics"] for name in REQUIRED_CAMERAS]
+    capture = result["trajectory_coverage"]["per_camera"]
+    if result.get("coverage_contract") == METRIC_ROOM_COVERAGE:
+        coverage_quality = min(
+            float(capture[name]["minimum_clearance_m"])
+            for name in REQUIRED_CAMERAS
+        )
+    else:
+        coverage_quality = -max(
+            capture[name]["capture_path_translation_m"]["p90"]
+            for name in REQUIRED_CAMERAS
+        )
+    return (
+        float(gate["passed"]),
+        float(gate["clear_camera_count"]),
+        min(item["clear_score"]["p10"] for item in summaries),
+        -max(item["depth_conflict"]["maximum"] for item in summaries),
+        coverage_quality,
+        float(np.mean([item["clear_score"]["mean"] for item in summaries])),
+    )
+
+
+def _evaluate(
+    env: Any,
+    transforms: list[np.ndarray],
+    actions: np.ndarray,
+    seed: int,
+    frames: list[int],
+    *,
+    scale_factor: float,
+) -> tuple[dict[int, list[dict[str, Any]]], dict[int, dict[str, np.ndarray]]]:
+    specs = _resolve_camera_set()
+    shell = env._visual_shell
+    metrics = {index: [] for index in range(len(transforms))}
+    previews: dict[int, dict[str, np.ndarray]] = {}
+    env.reset(seed=seed)
+    for frame in range(frames[-1] + 1):
+        if frame in frames:
+            cached = {}
+            for camera in specs:
+                renderer = env.obs_renderers[camera.resolution]
+                camera_id = env._cameras_map[camera.name][0]
+                renderer.update_scene(env.mojo.data, camera_id)
+                renderer.enable_depth_rendering(); depth = renderer.render(); renderer.disable_depth_rendering()
+                renderer.enable_segmentation_rendering(); segmentation = renderer.render(); renderer.disable_segmentation_rendering()
+                task = _task_region_from_segmentation(shell, env.mojo.model, segmentation)
+                height = max(64, int(camera.resolution[0] * scale_factor))
+                width = max(64, int(camera.resolution[1] * scale_factor))
+                if (height, width) != camera.resolution:
+                    depth = cv2.resize(depth, (width, height), interpolation=cv2.INTER_NEAREST)
+                    task = cv2.resize(task.astype(np.uint8), (width, height), interpolation=cv2.INTER_NEAREST).astype(bool)
+                cached[camera.name] = (camera_id, height, width, depth, task)
+            for index, transform in enumerate(transforms):
+                shell.mujoco_to_gaussian = np.linalg.inv(transform)
+                if frame == frames[len(frames) // 2]:
+                    previews[index] = {}
+                for camera in specs:
+                    camera_id, height, width, depth, task = cached[camera.name]
+                    pure, alpha, gaussian_depth = _pure_gaussian(shell, env.mojo.model, env.mojo.data, camera_id, height, width)
+                    context = _task_context_mask(task, inner_radius_px=max(1, int(2 * scale_factor)),
+                                                 outer_radius_px=max(8, int(96 * scale_factor)))
+                    row = _task_context_metrics(pure, alpha, task, context_mask=context)
+                    row.update(_depth_conflict_metrics(gaussian_depth, alpha, depth, task))
+                    row.update({"frame": frame, "camera": camera.name})
+                    metrics[index].append(row)
+                    if frame == frames[len(frames) // 2]:
+                        previews[index][camera.name] = pure.copy()
+        if frame < frames[-1]:
+            env.step(actions[frame], fast=True)
+    return metrics, previews
+
