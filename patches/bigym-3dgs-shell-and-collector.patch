+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+
+from d.replay_generation.prepare_iphone_room_visual_shell_profile import (
+    prepare_profile,
+)
+
+
+def _write_ply(path: Path) -> None:
+    floor = np.column_stack(
+        [
+            np.linspace(-1.0, 1.0, 200),
+            np.zeros(200),
+            np.linspace(-0.5, 0.5, 200),
+        ]
+    ).astype("<f4")
+    ceiling = floor.copy()
+    ceiling[:, 1] = -1.0
+    points = np.concatenate([floor, ceiling])
+    header = (
+        "ply\n"
+        "format binary_little_endian 1.0\n"
+        f"element vertex {len(points)}\n"
+        "property float x\n"
+        "property float y\n"
+        "property float z\n"
+        "end_header\n"
+    ).encode()
+    path.write_bytes(header + points.tobytes())
+
+
+def test_prepares_verified_visual_only_combined_profile(tmp_path: Path) -> None:
+    ply = tmp_path / "room.ply"
+    _write_ply(ply)
+    cameras = []
+    for index, x in enumerate(np.linspace(-0.5, 0.5, 12)):
+        cameras.append(
+            {
+                "id": index,
+                "img_name": f"frame_{index:04d}.jpg",
+                "position": [float(x), -0.5, 0.0],
+                "rotation": np.eye(3).tolist(),
+                "width": 960,
+                "height": 538,
+                "fx": 800.0,
+                "fy": 800.0,
+            }
+        )
+    camera_path = tmp_path / "cameras.json"
+    camera_path.write_text(json.dumps(cameras))
+    trajectory_path = tmp_path / "trajectory.npz"
+    identity = np.repeat(np.eye(3)[None], 8, axis=0)
+    positions = np.column_stack(
+        [np.linspace(-0.2, 0.2, 8), np.full(8, -0.6), np.full(8, 1.2)]
+    )
+    np.savez(
+        trajectory_path,
+        head_positions=positions,
+        left_wrist_positions=positions + [0.0, 0.1, -0.3],
+        right_wrist_positions=positions + [0.0, -0.1, -0.3],
+        head_rotations_mujoco=identity,
+        left_wrist_rotations_mujoco=identity,
+        right_wrist_rotations_mujoco=identity,
+    )
+    output = tmp_path / "prepared"
+    profile_path = prepare_profile(
+        ply=ply,
+        cameras_path=camera_path,
+        trajectory_path=trajectory_path,
+        output_dir=output,
+        expected_sha256=hashlib.sha256(ply.read_bytes()).hexdigest(),
+        room_height_m=2.6,
+        floor_quantile=0.0,
+        ceiling_quantile=1.0,
+        sample_count=400,
+        yaw_steps=4,
+        scale_steps=1,
+        trajectory_stride=1,
+    )
+
+    profile = json.loads(profile_path.read_text())
+    alignment = json.loads((output / "alignment.json").read_text())
+    assert profile["layer_files"] == {"combined": "room.ply"}
+    assert profile["ground_visual"]["mode"] == "gaussian_combined"
+    assert profile["asset"]["sha256"] == hashlib.sha256(ply.read_bytes()).hexdigest()
+    assert profile["integration_contract"]["background_physics"] == {
+        "body_count": 0,
+        "geom_count": 0,
+        "collision_count": 0,
+    }
+    assert alignment["scale_m_per_gaussian_unit"] == 2.6
+    transform = np.asarray(alignment["gaussian_to_mujoco"])
+    source_up = np.asarray(alignment["source_up_gaussian"])
+    mapped_up = transform[:3, :3] @ source_up
+    mapped_up /= np.linalg.norm(mapped_up)
+    np.testing.assert_allclose(mapped_up, [0.0, 0.0, 1.0], atol=1e-7)
+    assert (output / "camera-path.json").is_file()
+    assert (output / "manifest.json").is_file()
