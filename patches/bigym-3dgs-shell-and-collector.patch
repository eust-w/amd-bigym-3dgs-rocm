index 0000000..8619d36
--- /dev/null
+++ b/d/replay_generation/prepare_iphone_room_visual_shell_profile.py
@@ -0,0 +1,520 @@
+#!/usr/bin/env python3
+"""Prepare an OpenSplat iPhone room as a verified BiGym visual-only shell.
+
+The tool never creates MuJoCo bodies or geoms.  It estimates an upright,
+floor-anchored Sim(3) from the reconstructed camera poses and a robust sample
+of Gaussian centres, then searches yaw and a small metric scale band against a
+recorded H1 head/wrist trajectory.  The result is an explicit starting profile
+for the existing fail-closed visual clarity search.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+REQUIRED_CAMERAS = ("head", "left_wrist", "right_wrist")
+MUJOCO_TO_CV_CAMERA = np.diag([1.0, -1.0, -1.0])
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _normalise(vector: np.ndarray) -> np.ndarray:
+    vector = np.asarray(vector, dtype=np.float64)
+    norm = float(np.linalg.norm(vector))
+    if not np.isfinite(norm) or norm < 1e-12:
+        raise ValueError("cannot normalise a zero or non-finite vector")
+    return vector / norm
+
+
+def _rotation_between(source: np.ndarray, target: np.ndarray) -> np.ndarray:
+    """Return a proper rotation mapping one unit vector onto another."""
+
+    source = _normalise(source)
+    target = _normalise(target)
+    cosine = float(np.clip(source @ target, -1.0, 1.0))
+    if cosine > 1.0 - 1e-12:
+        return np.eye(3, dtype=np.float64)
+    if cosine < -1.0 + 1e-12:
+        axis = np.asarray([1.0, 0.0, 0.0], dtype=np.float64)
+        if abs(float(source @ axis)) > 0.9:
+            axis = np.asarray([0.0, 1.0, 0.0], dtype=np.float64)
+        axis = _normalise(axis - source * float(source @ axis))
+        return 2.0 * np.outer(axis, axis) - np.eye(3, dtype=np.float64)
+    cross = np.cross(source, target)
+    sine = float(np.linalg.norm(cross))
+    skew = np.asarray(
+        [
+            [0.0, -cross[2], cross[1]],
+            [cross[2], 0.0, -cross[0]],
+            [-cross[1], cross[0], 0.0],
+        ],
+        dtype=np.float64,
+    )
+    return np.eye(3) + skew + skew @ skew * ((1.0 - cosine) / (sine * sine))
+
+
+def _yaw_rotation(degrees: float) -> np.ndarray:
+    radians = math.radians(degrees)
+    cosine, sine = math.cos(radians), math.sin(radians)
+    return np.asarray(
+        [[cosine, -sine, 0.0], [sine, cosine, 0.0], [0.0, 0.0, 1.0]],
+        dtype=np.float64,
+    )
+
+
+def _normalised_rotation(matrix: np.ndarray) -> np.ndarray:
+    u, _, vh = np.linalg.svd(np.asarray(matrix, dtype=np.float64))
+    result = u @ vh
+    if np.linalg.det(result) < 0.0:
+        u[:, -1] *= -1.0
+        result = u @ vh
+    return result
+
+
+def _percentiles(values: np.ndarray) -> dict[str, float]:
+    return {
+        "minimum": float(np.min(values)),
+        "p50": float(np.percentile(values, 50)),
+        "p90": float(np.percentile(values, 90)),
+        "p99": float(np.percentile(values, 99)),
+        "maximum": float(np.max(values)),
+        "mean": float(np.mean(values)),
+    }
+
+
+def _read_opensplat_cameras(path: Path) -> tuple[np.ndarray, list[dict[str, Any]]]:
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(payload, list) or not payload:
+        raise ValueError("OpenSplat cameras.json must contain a non-empty list")
+    matrices = []
+    for camera in payload:
+        rotation = np.asarray(camera.get("rotation"), dtype=np.float64)
+        position = np.asarray(camera.get("position"), dtype=np.float64)
+        if rotation.shape != (3, 3) or position.shape != (3,):
+            raise ValueError("invalid OpenSplat camera pose")
+        matrix = np.eye(4, dtype=np.float64)
+        matrix[:3, :3] = _normalised_rotation(rotation)
+        matrix[:3, 3] = position
+        matrices.append(matrix)
+    result = np.asarray(matrices, dtype=np.float64)
+    if not np.isfinite(result).all():
+        raise ValueError("OpenSplat camera path contains non-finite values")
+    return result, payload
+
+
+def _read_ply_centres(path: Path, sample_count: int) -> tuple[np.ndarray, int]:
+    properties: list[str] = []
+    vertex_count: int | None = None
+    with path.open("rb") as stream:
+        while True:
+            raw = stream.readline()
+            if not raw:
+                raise ValueError("PLY ended before end_header")
+            line = raw.decode("ascii").strip()
+            if line.startswith("element vertex "):
+                vertex_count = int(line.split()[-1])
+            elif line.startswith("property float "):
+                properties.append(line.split()[-1])
+            elif line == "end_header":
+                offset = stream.tell()
+                break
+    if vertex_count is None or vertex_count < 1:
+        raise ValueError("PLY has no vertices")
+    if not {"x", "y", "z"}.issubset(properties):
+        raise ValueError("PLY lacks x/y/z float properties")
+    dtype = np.dtype([(name, "<f4") for name in properties])
+    expected = offset + vertex_count * dtype.itemsize
+    if path.stat().st_size != expected:
+        raise ValueError(
+            f"unexpected PLY byte count for float-only vertices: "
+            f"{path.stat().st_size} != {expected}"
+        )
+    vertices = np.memmap(
+        path,
+        dtype=dtype,
+        mode="r",
+        offset=offset,
+        shape=(vertex_count,),
+    )
+    indices = np.linspace(
+        0,
+        vertex_count - 1,
+        min(sample_count, vertex_count),
+        dtype=np.int64,
+    )
+    centres = np.column_stack(
+        [vertices["x"][indices], vertices["y"][indices], vertices["z"][indices]]
+    ).astype(np.float64)
+    centres = centres[np.isfinite(centres).all(axis=1)]
+    if len(centres) < 100:
+        raise ValueError("too few finite Gaussian centres")
+    return centres, vertex_count
+
+
+def _nearest_indices(source: np.ndarray, query: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """Small deterministic nearest-neighbour helper without a SciPy dependency."""
+
+    best_distance = np.full(len(query), np.inf, dtype=np.float64)
+    best_index = np.zeros(len(query), dtype=np.int64)
+    for start in range(0, len(source), 128):
+        block = source[start : start + 128]
+        squared = np.sum((query[:, None, :] - block[None, :, :]) ** 2, axis=2)
+        local = np.argmin(squared, axis=1)
+        distance = squared[np.arange(len(query)), local]
+        update = distance < best_distance
+        best_distance[update] = distance[update]
+        best_index[update] = start + local[update]
+    return np.sqrt(best_distance), best_index
+
+
+def _coverage_score(
+    source_cameras: np.ndarray,
+    transform: np.ndarray,
+    trajectory: Any,
+    *,
+    stride: int,
+) -> tuple[float, dict[str, Any]]:
+    source_positions = (
+        source_cameras[:, :3, 3] @ transform[:3, :3].T + transform[:3, 3]
+    )
+    rotation = _normalised_rotation(transform[:3, :3])
+    source_rotations = np.einsum("ij,njk->nik", rotation, source_cameras[:, :3, :3])
+    per_camera = {}
+    scores = []
+    for name in REQUIRED_CAMERAS:
+        target_positions = np.asarray(trajectory[f"{name}_positions"][::stride])
+        target_rotations = np.einsum(
+            "nij,jk->nik",
+            np.asarray(trajectory[f"{name}_rotations_mujoco"][::stride]),
+            MUJOCO_TO_CV_CAMERA,
+        )
+        distances, indices = _nearest_indices(source_positions, target_positions)
+        relative = np.einsum(
+            "nji,njk->nik", target_rotations, source_rotations[indices]
+        )
+        traces = np.trace(relative, axis1=1, axis2=2)
+        angles = np.degrees(
+            np.arccos(np.clip((traces - 1.0) * 0.5, -1.0, 1.0))
+        )
+        distance_summary = _percentiles(distances)
+        angle_summary = _percentiles(angles)
+        score = (
+            distance_summary["p50"] / 0.35
+            + distance_summary["p90"] / 0.50
+            + angle_summary["p50"] / 60.0
+            + angle_summary["p90"] / 90.0
+        )
+        scores.append(score)
+        per_camera[name] = {
+            "capture_path_translation_m": distance_summary,
+            "capture_path_rotation_degrees": angle_summary,
+            "score": float(score),
+        }
+    return float(np.mean(scores)), {"score": float(np.mean(scores)), "per_camera": per_camera}
+
+
+def prepare_profile(
+    *,
+    ply: Path,
+    cameras_path: Path,
+    trajectory_path: Path,
+    output_dir: Path,
+    expected_sha256: str,
+    room_height_m: float,
+    floor_quantile: float,
+    ceiling_quantile: float,
+    sample_count: int,
+    yaw_steps: int,
+    scale_steps: int,
+    trajectory_stride: int,
+    reconstruction_receipt: Path | None = None,
+) -> Path:
+    ply = ply.expanduser().resolve()
+    cameras_path = cameras_path.expanduser().resolve()
+    trajectory_path = trajectory_path.expanduser().resolve()
+    output_dir = output_dir.expanduser().resolve()
+    actual_sha256 = _sha256(ply)
+    if actual_sha256 != expected_sha256.lower():
+        raise ValueError(f"PLY SHA-256 mismatch: {actual_sha256} != {expected_sha256}")
+    if not (2.0 <= room_height_m <= 4.0):
+        raise ValueError("room_height_m must be in [2, 4]")
+    if not (0.0 <= floor_quantile < ceiling_quantile <= 1.0):
+        raise ValueError("invalid floor/ceiling quantiles")
+
+    source_cameras, camera_payload = _read_opensplat_cameras(cameras_path)
+    centres, vertex_count = _read_ply_centres(ply, sample_count)
+    trajectory = np.load(trajectory_path)
+    missing = [
+        key
+        for camera in REQUIRED_CAMERAS
+        for key in (f"{camera}_positions", f"{camera}_rotations_mujoco")
+        if key not in trajectory
+    ]
+    if missing:
+        raise ValueError(f"trajectory is missing keys: {missing}")
+
+    camera_down = source_cameras[:, :3, 1]
+    source_up = -_normalise(camera_down.mean(axis=0))
+    upright = _rotation_between(source_up, np.asarray([0.0, 0.0, 1.0]))
+    heights = centres @ source_up
+    floor_height = float(np.quantile(heights, floor_quantile))
+    ceiling_height = float(np.quantile(heights, ceiling_quantile))
+    reconstructed_height = ceiling_height - floor_height
+    if reconstructed_height <= 1e-6:
+        raise ValueError("invalid reconstructed floor-to-ceiling height")
+    estimated_scale = room_height_m / reconstructed_height
+
+    source_center = np.median(source_cameras[:, :3, 3], axis=0)
+    target_positions = np.concatenate(
+        [np.asarray(trajectory[f"{camera}_positions"]) for camera in REQUIRED_CAMERAS],
+        axis=0,
+    )
+    target_center = np.median(target_positions, axis=0)
+    candidates = []
+    scale_multipliers = (
+        np.asarray([1.0], dtype=np.float64)
+        if scale_steps == 1
+        else np.linspace(0.85, 1.15, scale_steps)
+    )
+    for scale_multiplier in scale_multipliers:
+        scale = float(estimated_scale * scale_multiplier)
+        for yaw in np.linspace(0.0, 360.0, yaw_steps, endpoint=False):
+            rotation = _yaw_rotation(float(yaw)) @ upright
+            linear = scale * rotation
+            transformed_center = linear @ source_center
+            translation = np.asarray(
+                [
+                    target_center[0] - transformed_center[0],
+                    target_center[1] - transformed_center[1],
+                    -scale * floor_height,
+                ],
+                dtype=np.float64,
+            )
+            transform = np.eye(4, dtype=np.float64)
+            transform[:3, :3] = linear
+            transform[:3, 3] = translation
