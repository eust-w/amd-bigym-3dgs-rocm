+#!/usr/bin/env python3
+"""Create visual-only confidence/floor fallback variants for one combined PLY."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def parse_threshold_pairs(value: str) -> list[tuple[float, float]]:
+    pairs: list[tuple[float, float]] = []
+    for item in value.split(","):
+        fields = item.strip().split(":")
+        if len(fields) != 2:
+            raise argparse.ArgumentTypeError(
+                "threshold pairs must use alpha_replace:alpha_keep"
+            )
+        replace, keep = (float(field) for field in fields)
+        if not (0.0 <= replace < keep <= 1.0):
+            raise argparse.ArgumentTypeError(
+                "threshold pairs must satisfy 0 <= replace < keep <= 1"
+            )
+        pair = (replace, keep)
+        if pair not in pairs:
+            pairs.append(pair)
+    if not pairs:
+        raise argparse.ArgumentTypeError("at least one threshold pair is required")
+    return pairs
+
+
+def parse_exclusion_box(value: str) -> dict[str, object]:
+    fields = value.split(":")
+    if len(fields) != 3 or not fields[0].strip():
+        raise argparse.ArgumentTypeError(
+            "exclusion box must use NAME:min_x,min_y,min_z:max_x,max_y,max_z"
+        )
+    try:
+        lower = [float(item) for item in fields[1].split(",")]
+        upper = [float(item) for item in fields[2].split(",")]
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError(
+            "exclusion box coordinates must be numeric"
+        ) from exc
+    if len(lower) != 3 or len(upper) != 3 or any(
+        low >= high for low, high in zip(lower, upper, strict=True)
+    ):
+        raise argparse.ArgumentTypeError(
+            "exclusion box must have three ordered min/max coordinates"
+        )
+    return {"name": fields[0].strip(), "min_m": lower, "max_m": upper}
+
+
+def _safe_symlink(source: Path, target: Path) -> None:
+    target.parent.mkdir(parents=True, exist_ok=True)
+    if target.exists() or target.is_symlink():
+        target.unlink()
+    os.symlink(source, target)
+
+
+def make_variants(
+    source_profile_path: Path,
+    output_root: Path,
+    threshold_pairs: list[tuple[float, float]],
+    confidence_compositing: str = "legacy_smooth",
+    foreground_policy: str | None = None,
+    static_foreground_geom_name_prefixes: tuple[str, ...] = (),
+    gaussian_exclusion_boxes_mujoco: tuple[dict[str, object], ...] = (),
+    floor_confidence_policy: str = "always_metric",
+    floor_depth_tolerance_m: float = 0.05,
+) -> Path:
+    source_profile_path = source_profile_path.expanduser().resolve()
+    source_profile: dict[str, Any] = json.loads(
+        source_profile_path.read_text(encoding="utf-8")
+    )
+    layer_files = source_profile.get("layer_files", {})
+    if set(layer_files) != {"combined"}:
+        raise RuntimeError("confidence variants require one combined PLY")
+    asset = source_profile.get("asset", {})
+    combined_name = str(layer_files["combined"])
+    if str(asset.get("path")) != combined_name:
+        raise RuntimeError("combined PLY does not match the asset contract")
+    combined_path = (source_profile_path.parent / combined_name).resolve()
+    if not combined_path.is_file():
+        raise FileNotFoundError(combined_path)
+    if combined_path.stat().st_size != int(asset.get("bytes", -1)):
+        raise RuntimeError("combined PLY byte size does not match the profile")
+    if _sha256(combined_path) != str(asset.get("sha256", "")).lower():
+        raise RuntimeError("combined PLY SHA-256 does not match the profile")
+
+    alignment_name = str(
+        source_profile.get("alignment", {}).get("path", "alignment.json")
+    )
