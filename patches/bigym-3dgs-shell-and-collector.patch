+def test_layered_task_contract_and_exclusion_are_written(tmp_path) -> None:
+    source = tmp_path / "source"
+    source.mkdir()
+    ply = source / "combined.ply"
+    ply.write_bytes(b"ply\nend_header\ncombined")
+    alignment = source / "alignment.json"
+    alignment.write_text(
