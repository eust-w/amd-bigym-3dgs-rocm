index 0000000..42641d1
--- /dev/null
+++ b/tests/test_external_camera_full_body_search.py
@@ -0,0 +1,153 @@
+from __future__ import annotations
+
+import numpy as np
+
+from d.replay_generation.search_external_camera_appearance import (
+    _add_projected_extent_check,
+    _candidates,
+    _full_body_summary,
+    _look_at_quaternion,
+    _project_landmarks,
+    _rank,
+)
+
+
+def _standing_landmarks() -> dict[str, np.ndarray]:
+    return {
+        "head_top": np.asarray([0.0, 0.0, 1.78]),
+        "left_shoulder": np.asarray([0.0, 0.22, 1.45]),
+        "right_shoulder": np.asarray([0.0, -0.22, 1.45]),
+        "left_elbow": np.asarray([0.18, 0.28, 1.15]),
+        "right_elbow": np.asarray([0.18, -0.28, 1.15]),
+        "left_wrist": np.asarray([0.38, 0.30, 0.95]),
+        "right_wrist": np.asarray([0.38, -0.30, 0.95]),
+        "pelvis": np.asarray([0.0, 0.0, 0.95]),
+        "left_knee": np.asarray([0.0, 0.12, 0.48]),
+        "right_knee": np.asarray([0.0, -0.12, 0.48]),
+        "left_foot": np.asarray([0.10, 0.12, 0.0]),
+        "right_foot": np.asarray([0.10, -0.12, 0.0]),
+    }
+
+
+def _candidate(position, target) -> dict:
+    return {
+        "position_m": list(position),
+        "target_m": list(target),
+        "quaternion_wxyz": _look_at_quaternion(
+            np.asarray(position, dtype=np.float64),
+            np.asarray(target, dtype=np.float64),
+        ).tolist(),
+    }
+
+
+def test_full_body_gate_rejects_near_cropped_camera() -> None:
+    landmarks = _standing_landmarks()
+    near = _candidate((-0.8, -0.5, 1.45), (0.0, 0.0, 0.85))
+    far = _candidate((-2.1, -1.1, 1.45), (0.0, 0.0, 0.85))
+
+    near_metrics = _project_landmarks(landmarks, near)
+    far_metrics = _project_landmarks(landmarks, far)
+
+    assert near_metrics["safe"] is False
+    assert far_metrics["safe"] is True
+    assert far_metrics["minimum_margin_fraction"] > 0.025
+
+
+def test_summary_requires_every_trajectory_frame_to_be_safe() -> None:
+    safe = {
+        "safe": True,
+        "minimum_margin_fraction": 0.08,
+        "head_top_margin_fraction": 0.10,
+        "feet_bottom_margin_fraction": 0.09,
+        "vertical_span_fraction": 0.70,
+        "center_offset_fraction": 0.02,
+    }
+    cropped = {**safe, "safe": False, "minimum_margin_fraction": -0.01}
+
+    summary = _full_body_summary([safe, safe, cropped])
+
+    assert summary["safe_frame_count"] == 2
+    assert summary["safe_frame_fraction"] == 2 / 3
+    assert summary["all_frames_safe"] is False
+
+
+def test_search_grid_uses_full_body_distance_band() -> None:
+    candidates = _candidates()
+
+    assert len(candidates) == 162
+    distances = {
+        round(
+            float(
+                np.linalg.norm(
+                    np.asarray(item["position_m"][:2])
+                    - np.asarray(item["target_m"][:2])
+                )
+            ),
+            1,
+        )
+        for item in candidates
+    }
+    assert distances == {1.8, 2.1, 2.4}
+    west = next(item for item in candidates if item["name"] == "az170_d2.1_h1.45_tz0.78")
+    assert np.allclose(west["position_m"], [-1.91809628, -0.23533883, 1.45])
+
+
+def test_rendered_robot_extent_must_cover_projected_head_and_feet() -> None:
+    projected = {"bbox_xyxy_normalized": [0.3, 0.10, 0.7, 0.90]}
+    complete = {
+        "visible": True,
+        "minimum_bbox_margin_fraction": 0.05,
+        "bbox_xyxy_normalized": [0.28, 0.08, 0.72, 0.92],
+    }
+    cropped_feet = {
+        **complete,
+        "bbox_xyxy_normalized": [0.28, 0.08, 0.72, 0.72],
+    }
+
+    assert _add_projected_extent_check(complete, projected)["full_body_extent_passed"]
+    assert not _add_projected_extent_check(cropped_feet, projected)[
+        "full_body_extent_passed"
+    ]
+
+
+def test_external_rank_uses_current_task_context_metrics() -> None:
+    appearance = [
+        {
+            "task_context_gaussian_coverage": 0.95,
+            "task_context_clear_score": 0.7,
+            "task_context_bright_fraction": 0.01,
+            "task_context_severe_fog_fraction": 0.01,
+            "task_context_hole_fraction": 0.05,
+            "foreground_fraction": 0.20,
+        }
+    ]
+    coverage = {"translation_m": 0.7, "rotation_degrees": 50.0}
+    full_body = {
+        "all_frames_safe": True,
+        "p05_margin_fraction": 0.08,
+        "median_vertical_span_fraction": 0.60,
+    }
+    robot_visibility = [
+        {
+            "full_body_extent_passed": True,
+            "minimum_bbox_margin_fraction": 0.04,
+            "visible_groups": {
+                "head": True,
+                "torso": True,
+                "left_arm": True,
+                "right_arm": True,
+                "legs": True,
+                "left_leg": True,
+                "right_leg": True,
+            },
+        }
+    ]
+    task_visibility = [{"passed": True}]
+
+    assert _rank(
+        appearance,
+        coverage,
+        full_body,
+        robot_visibility,
+        task_visibility,
+    ) > 0.0
