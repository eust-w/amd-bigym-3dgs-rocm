+#!/usr/bin/env python3
+"""Verify fixed-camera world lock and Gaussian/native depth ordering."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+import cv2
+import mujoco
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import FOUR_CAMERA_SET, build_env  # noqa: E402
+from tasks import TASKS  # noqa: E402
+
+
+def _dynamic_geom_lookup(model: mujoco.MjModel) -> np.ndarray:
+    dynamic_body = np.zeros(model.nbody, dtype=bool)
+    for body_id in range(1, model.nbody):
+        cursor = body_id
+        while cursor > 0:
+            if model.body_jntnum[cursor] > 0:
+                dynamic_body[body_id] = True
+                break
+            cursor = int(model.body_parentid[cursor])
+    return dynamic_body[np.asarray(model.geom_bodyid, dtype=np.int64)]
+
+
+def _dynamic_mask(
+    segmentation: np.ndarray,
+    dynamic_geoms: np.ndarray,
+) -> np.ndarray:
+    object_id = segmentation[..., 0]
+    object_type = segmentation[..., 1]
+    valid = (
+        (object_id >= 0)
+        & (object_type == int(mujoco.mjtObj.mjOBJ_GEOM))
+    )
+    result = np.zeros(object_id.shape, dtype=bool)
+    result[valid] = dynamic_geoms[object_id[valid]]
+    return cv2.dilate(
+        result.astype(np.uint8),
+        np.ones((7, 7), dtype=np.uint8),
+    ).astype(bool)
+
+
+def _physical_floor_mask(
+    model: mujoco.MjModel,
+    segmentation: np.ndarray,
+) -> np.ndarray:
+    floor_id = mujoco.mj_name2id(
+        model,
+        mujoco.mjtObj.mjOBJ_GEOM,
+        "floor",
+    )
+    if floor_id < 0:
+        return np.zeros(segmentation.shape[:2], dtype=bool)
+    return (
+        (segmentation[..., 0] == floor_id)
+        & (
+            segmentation[..., 1]
+            == int(mujoco.mjtObj.mjOBJ_GEOM)
+        )
+    )
+
+
+def _project(
+    points: np.ndarray,
+    position: np.ndarray,
+    rotation_mujoco: np.ndarray,
+    height: int,
+    width: int,
+    fovy: float,
+) -> np.ndarray:
+    conversion = np.diag([1.0, -1.0, -1.0])
+    rotation_cv = rotation_mujoco @ conversion
+    camera = (points - position) @ rotation_cv
+    focal = 0.5 * height / np.tan(np.radians(fovy) / 2.0)
+    return np.column_stack(
+        [
+            focal * camera[:, 0] / camera[:, 2] + width / 2.0,
+            focal * camera[:, 1] / camera[:, 2] + height / 2.0,
+        ]
+    )
+
+
+def _projection_round_trip(env, camera_id: int, height: int, width: int) -> dict:
+    model = env.mojo.model
+    data = env.mojo.data
+    position = np.asarray(data.cam_xpos[camera_id], dtype=np.float64)
+    rotation = np.asarray(data.cam_xmat[camera_id], dtype=np.float64).reshape(3, 3)
+    conversion = np.diag([1.0, -1.0, -1.0])
+    rotation_cv = rotation @ conversion
+    camera_points = np.asarray(
+        [
+            [x, y, z]
+            for z in (0.5, 1.0, 2.0, 3.0)
+            for y in (-0.25, 0.0, 0.25)
+            for x in (-0.4, 0.0, 0.4)
+        ],
+        dtype=np.float64,
+    )
+    world_points = camera_points @ rotation_cv.T + position
+    native_pixels = _project(
+        world_points,
+        position,
+        rotation,
+        height,
+        width,
+        float(model.cam_fovy[camera_id]),
+    )
+    shell = env._visual_shell
+    gaussian_points = (
+        world_points @ shell.mujoco_to_gaussian[:3, :3].T
+        + shell.mujoco_to_gaussian[:3, 3]
+    )
+    gaussian_position, gaussian_xmat, _units = shell._camera_in_gaussian_frame(
+        data,
+        camera_id,
+    )
+    gaussian_pixels = _project(
+        gaussian_points,
+        gaussian_position,
+        gaussian_xmat.reshape(3, 3),
+        height,
+        width,
+        float(model.cam_fovy[camera_id]),
+    )
+    errors = np.linalg.norm(native_pixels - gaussian_pixels, axis=1)
+    return {
+        "samples": int(len(errors)),
+        "median_pixels": float(np.median(errors)),
+        "p95_pixels": float(np.percentile(errors, 95)),
+        "maximum_pixels": float(np.max(errors)),
+    }
+
+
+def _capture_external(env, dynamic_geoms: np.ndarray) -> dict:
+    camera_config = next(
+        camera
+        for camera in env.observation_config.cameras
+        if camera.name == "external"
+    )
+    height, width = camera_config.resolution
+    renderer = env.obs_renderers[camera_config.resolution]
+    camera_id = env._cameras_map["external"][0]
+    renderer.update_scene(env.mojo.data, camera_id)
+    native = renderer.render()
+    renderer.enable_segmentation_rendering()
+    segmentation = renderer.render()
+    renderer.disable_segmentation_rendering()
+    renderer.enable_depth_rendering()
+    native_depth = renderer.render()
+    renderer.disable_depth_rendering()
+    foreground = env._visual_shell.native_foreground_mask(segmentation)
+    native_floor = env._visual_shell.native_floor_mask(segmentation)
+    composite = env._visual_shell.render_rgb(
+        env.mojo.model,
+        env.mojo.data,
+        camera_id,
+        native,
+        native_foreground_mask=foreground,
+        native_floor_mask=native_floor,
+    )
+    shell = env._visual_shell
+    gaussian_buffers = shell.render_buffers(
+        env.mojo.model,
+        env.mojo.data,
+        camera_id,
+        height,
+        width,
+        background_rgb=np.zeros((height, width, 3), dtype=np.uint8),
+        include_expected_depth=True,
+    )
+    pure_gaussian = gaussian_buffers.rgb
+    if (
+        gaussian_buffers.expected_depth_m is None
+        or gaussian_buffers.alpha is None
+    ):
+        raise RuntimeError("world-lock validation requires Gaussian depth and alpha")
+    gaussian_depth = gaussian_buffers.expected_depth_m
+    gaussian_alpha_np = gaussian_buffers.alpha
+    physical_floor = _physical_floor_mask(env.mojo.model, segmentation)
+    depth_subject = foreground & ~physical_floor
+    valid_depth = (
+        depth_subject
+        & np.isfinite(native_depth)
+        & (native_depth > 0.0)
+        & np.isfinite(gaussian_depth)
+        & (gaussian_depth > 0.0)
+        & (gaussian_alpha_np >= 0.05)
+    )
+    conflict = valid_depth & (gaussian_depth < native_depth - 0.02)
+    native_valid_depth = native_depth[valid_depth]
+    gaussian_valid_depth = gaussian_depth[valid_depth]
+    return {
+        "native": native,
+        "segmentation": segmentation,
+        "dynamic_mask": _dynamic_mask(segmentation, dynamic_geoms),
+        "composite": composite,
+        "pure_gaussian": pure_gaussian,
+        "native_depth_m": native_depth,
+        "gaussian_depth_m": gaussian_depth,
+        "depth_valid_mask": valid_depth,
+        "depth_conflict_mask": conflict,
+        "depth_valid_pixels": int(np.count_nonzero(valid_depth)),
+        "depth_conflict_pixels": int(np.count_nonzero(conflict)),
+        "depth_conflict_fraction": (
+            float(np.mean(conflict[valid_depth]))
+            if np.any(valid_depth)
+            else 0.0
+        ),
+        "native_depth_m_quantiles": (
+            {
+                "p10": float(np.percentile(native_valid_depth, 10)),
+                "p50": float(np.percentile(native_valid_depth, 50)),
+                "p90": float(np.percentile(native_valid_depth, 90)),
+            }
+            if np.any(valid_depth)
+            else None
+        ),
+        "gaussian_depth_m_quantiles": (
+            {
+                "p10": float(np.percentile(gaussian_valid_depth, 10)),
+                "p50": float(np.percentile(gaussian_valid_depth, 50)),
+                "p90": float(np.percentile(gaussian_valid_depth, 90)),
+            }
+            if np.any(valid_depth)
+            else None
+        ),
+        "gaussian_alpha_quantiles": {
+            "p10": float(np.percentile(gaussian_alpha_np, 10)),
+            "p50": float(np.percentile(gaussian_alpha_np, 50)),
+            "p90": float(np.percentile(gaussian_alpha_np, 90)),
+        },
+        "projection": _projection_round_trip(
+            env,
+            camera_id,
+            height,
+            width,
+        ),
+    }
+
+
+def _write_review(
+    captures: dict[int, dict],
+    output_dir: Path,
+) -> None:
+    rows = []
+    for frame_index, capture in captures.items():
+        columns = []
+        for label, key in (
+            ("composite", "composite"),
+            ("gaussian-only", "pure_gaussian"),
+        ):
+            image = cv2.resize(
+                capture[key],
+                (424, 240),
+                interpolation=cv2.INTER_AREA,
+            )
+            cv2.rectangle(image, (0, 0), (424, 28), (0, 0, 0), -1)
+            cv2.putText(
+                image,
+                f"f{frame_index} | {label}",
+                (8, 20),
+                cv2.FONT_HERSHEY_SIMPLEX,
+                0.52,
+                (255, 255, 255),
+                1,
+                cv2.LINE_AA,
+            )
+            columns.append(image)
+        rows.append(np.concatenate(columns, axis=1))
+    sheet = np.concatenate(rows, axis=0)
+    cv2.imwrite(
+        str(output_dir / "external-world-lock-contact-sheet.png"),
+        cv2.cvtColor(sheet, cv2.COLOR_RGB2BGR),
+    )
+
+
+def _write_depth_conflict_review(
+    capture: dict,
+    output_dir: Path,
+) -> Path:
+    native_depth = np.asarray(capture["native_depth_m"], dtype=np.float32)
+    gaussian_depth = np.asarray(capture["gaussian_depth_m"], dtype=np.float32)
+    valid = np.asarray(capture["depth_valid_mask"], dtype=bool)
+    conflict = np.asarray(capture["depth_conflict_mask"], dtype=bool)
+
+    def depth_image(values: np.ndarray) -> np.ndarray:
+        normalized = np.clip(values / 3.0, 0.0, 1.0)
+        colored = cv2.applyColorMap(
+            np.asarray(normalized * 255.0, dtype=np.uint8),
+            cv2.COLORMAP_TURBO,
+        )
+        colored[~valid] = 0
+        return colored
+
+    native_view = depth_image(native_depth)
+    gaussian_view = depth_image(gaussian_depth)
+    overlay = cv2.cvtColor(capture["composite"], cv2.COLOR_RGB2BGR)
+    overlay = np.asarray(overlay * 0.35, dtype=np.uint8)
+    overlay[valid & ~conflict] = (35, 180, 35)
+    overlay[conflict] = (30, 30, 245)
+    panels = []
+    for label, image in (
+        ("MuJoCo depth (0-3m)", native_view),
+        ("Gaussian expected depth (0-3m)", gaussian_view),
+        ("depth conflict: red", overlay),
+    ):
+        panel = cv2.resize(image, (424, 240), interpolation=cv2.INTER_AREA)
+        cv2.rectangle(panel, (0, 0), (424, 30), (0, 0, 0), -1)
+        cv2.putText(panel, label, (8, 21), cv2.FONT_HERSHEY_SIMPLEX, 0.52, (255, 255, 255), 1, cv2.LINE_AA)
+        panels.append(panel)
+    path = output_dir / "external-depth-conflict-heatmap.png"
+    cv2.imwrite(str(path), np.concatenate(panels, axis=1))
+    return path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--scene-placement-profile", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--sample-frames", default="0,100,300,648")
+    parser.add_argument(
+        "--maximum-depth-conflict-fraction",
+        type=float,
+        default=0.01,
+    )
+    args = parser.parse_args()
+
+    sample_frames = sorted(
+        {int(value) for value in args.sample_frames.split(",")}
+    )
+    trajectory = np.load(args.trajectory)
+    canonical_actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    if sample_frames[0] < 0 or sample_frames[-1] >= len(canonical_actions):
+        parser.error(
+            "sample frames must fall in "
+            f"[0, {len(canonical_actions) - 1}]"
+        )
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=FOUR_CAMERA_SET,
+        visual_shell_profile=str(args.profile.resolve()),
+        visual_shell_strict=True,
+        scene_placement_profile=(
+            str(args.scene_placement_profile.resolve())
+            if args.scene_placement_profile is not None
+            else None
+        ),
+    )
+    actions = (
+        np.asarray(
+            [
+                env.scene_placement.transform_action(
+                    action,
+                    TASKS["DishwasherUnloadCutleryLong"]["floating_dofs"],
+                )
+                for action in canonical_actions
+            ],
+            dtype=np.float32,
+        )
+        if env.scene_placement is not None
+        else canonical_actions
+    )
+    captures: dict[int, dict] = {}
+    try:
+        env.reset(seed=seed)
+        dynamic_geoms = _dynamic_geom_lookup(env.mojo.model)
+        captures[0] = _capture_external(env, dynamic_geoms)
+        for action_index in range(sample_frames[-1]):
+            env.step(actions[action_index], fast=True)
+            frame_index = action_index + 1
+            if frame_index in sample_frames:
+                captures[frame_index] = _capture_external(
+                    env,
+                    dynamic_geoms,
+                )
+    finally:
+        env.close()
+
+    reference = captures[sample_frames[0]]
+    frame_reports = {}
+    pure_errors = []
+    segmentation_errors = []
+    depth_conflicts = []
+    projection_errors = []
+    for frame_index in sample_frames:
+        capture = captures[frame_index]
+        pure_difference = np.abs(
+            capture["pure_gaussian"].astype(np.int16)
+            - reference["pure_gaussian"].astype(np.int16)
+        )
+        excluded = reference["dynamic_mask"] | capture["dynamic_mask"]
+        comparable = ~excluded
+        segmentation_difference = np.any(
+            capture["segmentation"] != reference["segmentation"],
+            axis=2,
+        )
+        pure_max = int(np.max(pure_difference))
+        segmentation_fraction = (
+            float(np.mean(segmentation_difference[comparable]))
+            if np.any(comparable)
+            else 0.0
+        )
+        pure_errors.append(pure_max)
+        segmentation_errors.append(segmentation_fraction)
+        depth_conflicts.append(capture["depth_conflict_fraction"])
+        projection_errors.append(capture["projection"]["p95_pixels"])
+        frame_reports[str(frame_index)] = {
+            "pure_gaussian_maximum_absolute_rgb_error": pure_max,
+            "static_segmentation_mismatch_fraction": segmentation_fraction,
+            "depth_valid_pixels": capture["depth_valid_pixels"],
+            "depth_conflict_pixels": capture["depth_conflict_pixels"],
+            "depth_conflict_fraction": capture["depth_conflict_fraction"],
+            "native_depth_m_quantiles": capture[
+                "native_depth_m_quantiles"
+            ],
+            "gaussian_depth_m_quantiles": capture[
+                "gaussian_depth_m_quantiles"
+            ],
+            "gaussian_alpha_quantiles": capture[
+                "gaussian_alpha_quantiles"
+            ],
+            "projection": capture["projection"],
+        }
+    passed = (
+        max(pure_errors) == 0
+        and max(segmentation_errors) == 0.0
+        and max(projection_errors) <= 2.0
+        and max(depth_conflicts)
+        <= args.maximum_depth_conflict_fraction
+    )
+    _write_review(captures, args.output_dir)
+    conflict_heatmap_path = _write_depth_conflict_review(
+        reference,
+        args.output_dir,
+    )
+    report = {
+        "schema_version": 1,
+        "status": "passed" if passed else "failed",
+        "visual_status": "awaiting_visual_approval",
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": seed,
+        "camera_set": FOUR_CAMERA_SET,
+        "profile": str(args.profile.resolve()),
+        "profile_sha256": hashlib.sha256(
+            args.profile.resolve().read_bytes()
+        ).hexdigest(),
+        "scene_placement": (
+            env.scene_placement.snapshot()
+            if env.scene_placement is not None
+            else None
+        ),
+        "fixed_camera": "external",
+        "sample_frames": sample_frames,
+        "thresholds": {
+            "pure_gaussian_maximum_absolute_rgb_error": 0,
+            "static_segmentation_mismatch_fraction": 0.0,
+            "projection_p95_pixels": 2.0,
+            "depth_conflict_fraction": (
+                args.maximum_depth_conflict_fraction
+            ),
+        },
+        "maximums": {
+            "pure_gaussian_maximum_absolute_rgb_error": max(pure_errors),
+            "static_segmentation_mismatch_fraction": max(
+                segmentation_errors
+            ),
+            "projection_p95_pixels": max(projection_errors),
+            "depth_conflict_fraction": max(depth_conflicts),
+        },
+        "frames": frame_reports,
+        "background_physics": {
+            "body_count": 0,
+            "geom_count": 0,
+            "collision_count": 0,
+        },
+        "depth_conflict_heatmap": str(conflict_heatmap_path),
+    }
+    report_path = args.output_dir / "world-lock-report.json"
+    report_path.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+    if not passed:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
