@@ -0,0 +1,225 @@
+#!/usr/bin/env python3
+"""Compare native and visual-shell physics on an identical action replay."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import (  # noqa: E402
+    CAMERA_SETS,
+    DEFAULT_CAMERA_SET,
+    build_env,
+)
+from tasks import TASKS  # noqa: E402
+
+
+def contact_signature(env) -> np.ndarray:
+    data = env.mojo.data
+    if data.ncon == 0:
+        return np.empty((0, 4), dtype=np.float64)
+    contacts = [
+        (
+            int(data.contact[index].geom1),
+            int(data.contact[index].geom2),
+            int(data.contact[index].dim),
+            float(data.contact[index].dist),
+        )
+        for index in range(data.ncon)
+    ]
+    return np.asarray(sorted(contacts), dtype=np.float64)
+
+
+def scalar_state(env) -> dict[str, object]:
+    return {
+        "time": float(env.mojo.data.time),
+        "reward": float(env.reward),
+        "terminate": bool(env.terminate),
+        "truncate": bool(env.truncate),
+        "contacts": int(env.mojo.data.ncon),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--task", default="DishwasherUnloadCutleryLong")
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--scene-placement-profile", type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument(
+        "--camera-set",
+        choices=sorted(CAMERA_SETS),
+        default=DEFAULT_CAMERA_SET,
+    )
+    args = parser.parse_args()
+
+    trajectory = np.load(args.trajectory)
+    canonical_actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    placement_path = (
+        str(args.scene_placement_profile.resolve())
+        if args.scene_placement_profile is not None
+        else None
+    )
+    native = build_env(
+        args.task,
+        with_cameras=False,
+        scene_placement_profile=placement_path,
+    )
+    visual = build_env(
+        args.task,
+        with_cameras=False,
+        visual_shell_profile=str(args.profile.resolve()),
+        visual_shell_strict=True,
+        scene_placement_profile=placement_path,
+    )
+    actions = (
+        np.asarray(
+            [
+                native.scene_placement.transform_action(
+                    action,
+                    TASKS[args.task]["floating_dofs"],
+                )
+                for action in canonical_actions
+            ],
+            dtype=np.float32,
+        )
+        if native.scene_placement is not None
+        else canonical_actions
+    )
+    maximum_qpos_error = 0.0
+    maximum_qvel_error = 0.0
+    maximum_ctrl_error = 0.0
+    maximum_time_error = 0.0
+    maximum_contact_distance_error = 0.0
+    checkpoints: dict[str, dict[str, object]] = {}
+    try:
+        native.reset(seed=seed)
+        visual.reset(seed=seed)
+        for frame_index, action in enumerate(actions, start=1):
+            native.step(action, fast=True)
+            visual.step(action, fast=True)
+            native_qpos = np.asarray(native.mojo.data.qpos)
+            visual_qpos = np.asarray(visual.mojo.data.qpos)
+            native_qvel = np.asarray(native.mojo.data.qvel)
+            visual_qvel = np.asarray(visual.mojo.data.qvel)
+            native_ctrl = np.asarray(native.mojo.data.ctrl)
+            visual_ctrl = np.asarray(visual.mojo.data.ctrl)
+            packed = np.concatenate(
+                [
+                    native_qpos,
+                    visual_qpos,
+                    native_qvel,
+                    visual_qvel,
+                    native_ctrl,
+                    visual_ctrl,
+                ]
+            )
+            if not np.isfinite(packed).all():
+                raise RuntimeError(f"non-finite physics state at frame {frame_index}")
+            maximum_qpos_error = max(
+                maximum_qpos_error,
+                float(np.max(np.abs(native_qpos - visual_qpos))),
+            )
+            maximum_qvel_error = max(
+                maximum_qvel_error,
+                float(np.max(np.abs(native_qvel - visual_qvel))),
+            )
+            maximum_ctrl_error = max(
+                maximum_ctrl_error,
+                float(np.max(np.abs(native_ctrl - visual_ctrl))),
+            )
+            native_scalars = scalar_state(native)
+            visual_scalars = scalar_state(visual)
+            maximum_time_error = max(
+                maximum_time_error,
+                abs(native_scalars["time"] - visual_scalars["time"]),
+            )
+            for key in ("reward", "terminate", "truncate", "contacts"):
+                if native_scalars[key] != visual_scalars[key]:
+                    raise RuntimeError(
+                        f"{key} differs at frame {frame_index}: "
+                        f"{native_scalars[key]} != {visual_scalars[key]}"
+                    )
+            native_contacts = contact_signature(native)
+            visual_contacts = contact_signature(visual)
+            if native_contacts.shape != visual_contacts.shape:
+                raise RuntimeError(
+                    f"contact shape differs at frame {frame_index}: "
+                    f"{native_contacts.shape} != {visual_contacts.shape}"
+                )
+            if len(native_contacts):
+                if not np.array_equal(
+                    native_contacts[:, :3],
+                    visual_contacts[:, :3],
+                ):
+                    raise RuntimeError(
+                        f"contact identities differ at frame {frame_index}"
+                    )
+                maximum_contact_distance_error = max(
+                    maximum_contact_distance_error,
+                    float(
+                        np.max(
+                            np.abs(
+                                native_contacts[:, 3]
+                                - visual_contacts[:, 3]
+                            )
+                        )
+                    ),
+                )
+            if frame_index in {100, 300, len(actions)}:
+                checkpoints[str(frame_index)] = {
+                    "native": native_scalars,
+                    "visual_shell": visual_scalars,
+                }
+        status = "passed"
+    finally:
+        native.close()
+        visual.close()
+    report = {
+        "schema_version": 1,
+        "status": status,
+        "task": args.task,
+        "profile": str(args.profile.resolve()),
+        "trajectory": str(args.trajectory.resolve()),
+        "seed": seed,
+        "camera_set": args.camera_set,
+        "scene_placement": (
+            native.scene_placement.snapshot()
+            if native.scene_placement is not None
+            else None
+        ),
+        "frames": len(actions),
+        "checkpoints": checkpoints,
+        "maximum_absolute_error": {
+            "qpos": maximum_qpos_error,
+            "qvel": maximum_qvel_error,
+            "ctrl": maximum_ctrl_error,
+            "simulation_time": maximum_time_error,
+            "contact_distance": maximum_contact_distance_error,
+        },
+        "finite": True,
+        "reward_termination_truncation_contacts_equal": True,
+        "visual_shell_background_physics": {
+            "body_count": 0,
+            "geom_count": 0,
+            "collision_count": 0,
+        },
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
