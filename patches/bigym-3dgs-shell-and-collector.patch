@@ -0,0 +1,322 @@
+from __future__ import annotations
+
+import importlib.util
+import sys
+import types
+from enum import Enum
+from pathlib import Path
+
+
+REPOSITORY = Path(__file__).resolve().parents[1]
+REPLAY_DIR = REPOSITORY / "d" / "replay_generation"
+EVAL_DIR = REPOSITORY / "d" / "eval"
+
+
+def _stub_bigym(monkeypatch) -> None:
+    """Keep CLI parser tests independent from an installed BiGym wheel."""
+
+    class PelvisDof(Enum):
+        X = "x"
+        Y = "y"
+        Z = "z"
+        RZ = "rz"
+
+    fake_bigym = types.ModuleType("bigym")
+    fake_action_modes = types.ModuleType("bigym.action_modes")
+    fake_utils = types.ModuleType("bigym.utils")
+    fake_scene_placement = types.ModuleType("bigym.utils.scene_placement")
+    fake_scene_placement.ScenePlacement = object
+    fake_scene_placement.load_scene_placement_profile = lambda *args, **kwargs: None
+    fake_action_modes.PelvisDof = PelvisDof
+    fake_bigym.action_modes = fake_action_modes
+    fake_bigym.utils = fake_utils
+    monkeypatch.setitem(sys.modules, "bigym", fake_bigym)
+    monkeypatch.setitem(sys.modules, "bigym.action_modes", fake_action_modes)
+    monkeypatch.setitem(sys.modules, "bigym.utils", fake_utils)
+    monkeypatch.setitem(
+        sys.modules,
+        "bigym.utils.scene_placement",
+        fake_scene_placement,
+    )
+    for name in ("tasks", "env_utils", "dim_utils", "groups"):
+        monkeypatch.delitem(sys.modules, name, raising=False)
+
+
+def _load(name: str, path: Path):
+    sys.path.insert(0, str(path.parent))
+    try:
+        spec = importlib.util.spec_from_file_location(name, path)
+        assert spec is not None and spec.loader is not None
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        return module
+    finally:
+        sys.path.pop(0)
+
+
+def test_generation_cli_defaults_to_strict_visual_shell(monkeypatch) -> None:
+    _stub_bigym(monkeypatch)
+    module = _load(
+        "_test_generate_dataset",
+        REPLAY_DIR / "generate_dataset.py",
+    )
+    _parser, args = module.parse_args(
+        [
+            "--task",
+            "DishwasherLoadPlates",
+            "--visual-shell-profile",
+            "/tmp/shell/profile.json",
+        ]
+    )
+    assert args.visual_shell_profile == "/tmp/shell/profile.json"
+    assert args.visual_shell_strict is True
+    assert args.camera_set == "bigym-plus-3"
+
+
+def test_diagnostic_only_external_marker_does_not_require_a_pose(
+    monkeypatch,
+    tmp_path,
+) -> None:
+    _stub_bigym(monkeypatch)
+    module = _load("_test_env_utils_external_marker", REPLAY_DIR / "env_utils.py")
+    profile = tmp_path / "profile.json"
+    profile.write_text(
+        '{"integration_contract":{"external_camera":'
+        '{"formal":false,"diagnostic_only":true}}}'
+    )
+    assert module._profile_external_camera(profile) is None
+
+
+def test_generation_cli_can_explicitly_disable_strict_mode(monkeypatch) -> None:
+    _stub_bigym(monkeypatch)
+    module = _load(
+        "_test_generate_dataset_non_strict",
+        REPLAY_DIR / "generate_dataset.py",
+    )
+    _parser, args = module.parse_args(
+        [
+            "--task",
+            "DishwasherLoadPlates",
+            "--no-visual-shell-strict",
+        ]
+    )
+    assert args.visual_shell_strict is False
+
+
+def test_generation_probe_accepts_a_fixed_demo_seed(monkeypatch) -> None:
+    _stub_bigym(monkeypatch)
+    module = _load(
+        "_test_generate_dataset_fixed_seed",
+        REPLAY_DIR / "generate_dataset.py",
+    )
+    _parser, args = module.parse_args(
