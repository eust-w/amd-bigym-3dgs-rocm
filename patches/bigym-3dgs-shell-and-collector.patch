+#!/usr/bin/env python3
+"""Freeze an iPhone room shell behind a fail-closed source-view gate."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import shutil
+from pathlib import Path
+from typing import Any
+
+DEFAULT_THRESHOLDS = {
+    "head": {"translation_m": 0.30, "rotation_degrees": 45.0},
+    "left_wrist": {"translation_m": 0.65, "rotation_degrees": 45.0},
+    "right_wrist": {"translation_m": 0.50, "rotation_degrees": 45.0},
+}
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _copy_verified_json(
+    source_dir: Path,
+    output_dir: Path,
+    contract: dict[str, Any],
+) -> dict[str, Any]:
+    name = Path(str(contract["path"]))
+    if name.is_absolute() or ".." in name.parts:
+        raise RuntimeError(f"unsafe profile dependency: {name}")
+    source = source_dir / name
+    expected = str(contract.get("sha256", "")).lower()
+    if not source.is_file() or len(expected) != 64 or _sha256(source) != expected:
+        raise RuntimeError(f"profile dependency failed verification: {source}")
+    target = output_dir / name
+    target.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(source, target)
+    return {**contract, "path": str(name)}
+
+
+def make_profile(source_profile_path: Path, output_dir: Path) -> Path:
+    source_path = source_profile_path.expanduser().resolve()
+    output = output_dir.expanduser().resolve()
+    profile = json.loads(source_path.read_text(encoding="utf-8"))
+    source_dir = source_path.parent
+    if (
+        profile.get("ground_visual", {}).get("mode")
+        != "gaussian_combined_with_confidence_fallback"
+        or profile.get("ground_visual", {}).get("confidence_compositing")
+        != "hard_opaque"
+    ):
+        raise RuntimeError("legacy profile requires the hard-opaque baseline")
+    if profile.get("integration_contract", {}).get("camera_set") != "bigym-plus-3":
+        raise RuntimeError("legacy profile requires the canonical three cameras")
+
+    asset = profile.get("asset", {})
+    asset_name = Path(str(asset.get("path", "")))
+    source_asset = source_dir / asset_name
+    expected_bytes = int(asset.get("bytes", -1))
+    expected_sha = str(asset.get("sha256", "")).lower()
+    if (
+        not source_asset.is_file()
+        or asset_name.is_absolute()
+        or ".." in asset_name.parts
+        or source_asset.stat().st_size != expected_bytes
+        or len(expected_sha) != 64
+        or _sha256(source_asset) != expected_sha
+    ):
+        raise RuntimeError("source Gaussian asset failed immutable verification")
+
+    output.mkdir(parents=True, exist_ok=True)
+    target_asset = output / asset_name
+    if target_asset.exists() or target_asset.is_symlink():
+        if target_asset.resolve() != source_asset.resolve():
+            raise FileExistsError(f"refusing to replace {target_asset}")
+    else:
+        target_asset.symlink_to(source_asset)
+    profile["alignment"] = _copy_verified_json(
+        source_dir,
+        output,
+        profile["alignment"],
+    )
+    profile["capture_path"] = _copy_verified_json(
+        source_dir,
+        output,
+        profile["capture_path"],
+    )
+
+    profile["name"] = "iphone-room-legacy-v1-conservative-three-camera"
+    profile["description"] = (
+        "Immutable 2026-08-01 iPhone room snapshot used only as a conservative "
+        "visual background; out-of-capture camera poses hard-fallback to native "
+        "MuJoCo RGB with the world-locked metric floor."
+    )
+    profile["status"] = "diagnostic_legacy_room_awaiting_visual_approval"
+    profile["integration_contract"] = {
+        **profile["integration_contract"],
+        "camera_set": "bigym-plus-3",
+        "camera_names": ["head", "left_wrist", "right_wrist"],
+        "camera_coverage_gate": {
+            "mode": "whole_camera_hard_fallback",
+            "camera_path": profile["capture_path"]["path"],
+            "thresholds": DEFAULT_THRESHOLDS,
+            "fallback": "native_rgb_with_metric_floor",
+            "failure_is_silent": False,
+        },
+        "external_camera": {
+            "diagnostic_only": True,
+            "formal_schema_included": False,
+        },
+    }
+    profile["quality"] = {
+        **profile.get("quality", {}),
+        "status": "awaiting_legacy_three_camera_video_review",
+        "formal_collection_allowed": False,
+        "awaiting_visual_approval": True,
+        "environment_fidelity": "historical_snapshot_only",
+        "known_limitation": (
+            "The physical room changed after capture; this profile does not "
+            "claim to reproduce the current room."
+        ),
+    }
+    profile["legacy_room_contract"] = {
+        "schema_version": 1,
+        "coordinate_frame": "canonical-bigym",
+        "source_environment_snapshot_date": "2026-08-01",
+        "physical_environment_changed_after_capture": True,
+        "allowed_use": "diagnostic_background_and_visual_poc",
+        "formal_collection_allowed": False,
+        "scene_placement_profile": None,
+        "external_camera_in_formal_schema": False,
+    }
+
+    profile_path = output / "profile.json"
+    profile_path.write_text(json.dumps(profile, indent=2) + "\n", encoding="utf-8")
+    manifest = {
+        "schema_version": 1,
+        "status": "prepared_awaiting_visual_approval",
+        "profile": {
+            "path": profile_path.name,
+            "bytes": profile_path.stat().st_size,
+            "sha256": _sha256(profile_path),
+        },
+        "asset": profile["asset"],
+        "alignment": profile["alignment"],
+        "capture_path": profile["capture_path"],
+        "formal_collection_allowed": False,
+    }
+    (output / "manifest.json").write_text(
+        json.dumps(manifest, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    return profile_path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source-profile", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    path = make_profile(args.source_profile, args.output_dir)
+    print(path)
+
+
+if __name__ == "__main__":
+    main()
