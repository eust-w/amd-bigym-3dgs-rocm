+)
+
+
+def technical_status(
+    *,
+    world_lock_passed: bool,
+    physics_parity_passed: bool,
+) -> str:
+    if world_lock_passed and physics_parity_passed:
+        return "world_lock_and_physics_passed"
+    if physics_parity_passed:
+        return "world_lock_failed_physics_passed"
+    if world_lock_passed:
+        return "world_lock_passed_physics_failed"
+    return "world_lock_and_physics_failed"
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--world-lock-report", type=Path, required=True)
+    parser.add_argument("--visual-acceptance-report", type=Path)
+    parser.add_argument("--physics-parity-report", type=Path, required=True)
