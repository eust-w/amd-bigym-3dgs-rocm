+        "stages": {"coarse": {"candidate_count": args.coarse_candidate_count,
+                                "capture_path_rejected_before_render": coarse_prefiltered,
+                                "rendered_candidate_count": len(coarse), "frames": coarse_frames,
+                                "render_limit": coarse_render_limit,
+                                "retained": min(coarse_retain, len(coarse))},
+                   "refine": {"candidate_count": refine_candidate_count,
+                                "capture_path_rejected_before_render": refine_prefiltered,
+                                "rendered_candidate_count": len(refined), "frames": refine_frames,
+                                "retained": min(args.full_retain, len(refined))},
+                   "full": {"candidate_count": len(final), "frames": len(full_frames)}},
+        "analytic_rejections": analytic_rejections,
+        "baseline_649": baseline_649, "selected": selected,
+        "final_candidates": final, "refine_ranking": refined, "coarse_ranking": coarse,
+        "failure_policy": "keep_pose_optimized_final; never_materialize_failed_candidate",
+        "external_policy": "diagnostic_only_after_three_camera_pass",
+    }
+    report_path = output_dir / report_name
+    report_path.write_text(json.dumps(report, indent=2) + "\n")
+    _write_contact_sheet(
+        final_previews,
+        final,
+        output_dir / (
+            "metric-room-finalists.png"
+            if metric_room
+            else "adaptive-clarity-finalists.png"
+        ),
+    )
+    selected_profile = None
+    if selected is not None:
+        selected_profile = _write_profile(
+            profile_path,
+            source_profile,
+            alignment,
+            selected,
+            output_dir,
+            search_mode=args.search_mode,
+            selection_report=report_name,
+        )
+    receipt = {
+        "schema_version": 2, "status": status, "technical_status": "passed" if selected else "blocked",
+        "visual_status": "awaiting_visual_approval", "formal_collection_allowed": False,
+        "task": "DishwasherUnloadCutleryLong", "seed": trajectory_seed,
+        "camera_set": DEFAULT_CAMERA_SET, "camera_order": list(REQUIRED_CAMERAS),
+        "coordinate_frame": "bigym-canonical", "scene_placement": None,
+        "source_kind": source_profile.get("source_kind"),
+        "combined_layer_mode": "combined" in source_profile.get("layer_files", {}),
+        "asset": source_profile.get("asset"),
+        "prealigned_mujoco_metric": source_profile.get("asset", {}).get("prealigned_mujoco_metric"),
+        "safe_obb_mujoco": source_profile.get("free_view_contract", {}).get("safe_space_obb_mujoco"),
+        "clear_obb_mujoco": source_profile.get("free_view_contract", {}).get("clear_obb_mujoco"),
+        "coverage_contract": coverage_contract,
+        "baseline_profile": str(profile_path),
+        "comparison_profile": str(comparison_profile_path),
+        "selected_profile": str(selected_profile) if selected_profile else None,
+        "clear_camera_count": selected["gate"]["clear_camera_count"] if selected else final[0]["gate"]["clear_camera_count"],
+        "per_camera_gates": (selected or final[0])["gate"]["per_camera"],
+        "global_gates": (selected or final[0])["gate"]["global_checks"],
+        "rejection_reasons": [] if selected else final[0]["gate"]["rejection_reasons"],
+        "external": {"formal": False, "diagnostic_only": True,
+                     "status": "not_searched" if selected is None else "eligible_for_diagnostic_search"},
+        "implementation_commits": list(args.implementation_commit),
+        "runtime": runtime_snapshot(),
+        "visual_shell_profile": profile_snapshot(profile_path),
+        "search_report": str(report_path),
+    }
+    (output_dir / "run-receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
+    print(json.dumps({"status": status, "report": str(report_path), "profile": str(selected_profile) if selected_profile else None}, indent=2))
+    if selected is None:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
