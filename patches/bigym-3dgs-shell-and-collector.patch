+from __future__ import annotations
+
+import hashlib
+import json
+
+
+def test_profile_snapshot_hashes_profile_alignment_and_layers(tmp_path) -> None:
+    from d.replay_generation.run_receipt import profile_snapshot
+
+    files = {
+        "alignment.json": b'{"schema_version": 1}\n',
+        "walls.ply": b"ply\nend_header\n",
+        "floor.ply": b"ply\nend_header\n",
+        "ceiling.ply": b"ply\nend_header\n",
+    }
+    for name, content in files.items():
+        (tmp_path / name).write_bytes(content)
+    profile = tmp_path / "profile.json"
+    profile.write_text(
+        json.dumps(
+            {
+                "name": "tiny-shell",
+                "alignment": {"path": "alignment.json"},
+                "layer_files": {
+                    "walls_decor": "walls.ply",
+                    "floor": "floor.ply",
+                    "ceiling": "ceiling.ply",
+                },
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    snapshot = profile_snapshot(profile)
+    entries = {entry["path"]: entry for entry in snapshot["files"]}
+    expected = {
+        str(profile.resolve()): profile.read_bytes(),
+        **{
+            str((tmp_path / name).resolve()): content
+            for name, content in files.items()
+        },
+    }
+    assert set(entries) == set(expected)
+    for path, content in expected.items():
+        assert entries[path]["bytes"] == len(content)
+        assert entries[path]["sha256"] == hashlib.sha256(content).hexdigest()
+
+
+def test_profile_snapshot_records_combined_freeview_contract(tmp_path) -> None:
+    from d.replay_generation.run_receipt import profile_snapshot
+
+    (tmp_path / "alignment.json").write_text("{}")
+    (tmp_path / "combined.ply").write_bytes(b"ply")
+    profile = tmp_path / "profile.json"
+    profile.write_text(
+        json.dumps(
+            {
+                "name": "infinigen",
+                "source_kind": "infinigen",
+                "alignment": {"path": "alignment.json"},
+                "layer_files": {"combined": "combined.ply"},
+                "asset": {"prealigned_mujoco_metric": True},
+                "free_view_contract": {
+                    "safe_space_obb_mujoco": {"min": [0, 0, 0], "max": [1, 1, 1]},
+                    "clear_obb_mujoco": {"min": [0, 0, 0], "max": [1, 1, 1]},
+                },
+            }
+        )
+    )
+    snapshot = profile_snapshot(profile)
+    assert snapshot["source_kind"] == "infinigen"
+    assert snapshot["layer_mode"] == "combined"
+    assert snapshot["prealigned_mujoco_metric"] is True
+    assert snapshot["safe_obb_mujoco"]["max"] == [1, 1, 1]
