+#!/usr/bin/env python3
+"""Render a search result beside its comparison profile for visual review.
+
+The chosen search transform is applied only in memory.  In particular, a
+failed candidate is never materialised as a reusable visual-shell profile.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import av
+import cv2
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import DEFAULT_CAMERA_SET, build_env, resolve_camera_set  # noqa: E402
+from render_visual_shell_pose_candidates import capture_cameras  # noqa: E402
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+class _H264Writer:
+    def __init__(self, path: Path, width: int, height: int, fps: float) -> None:
+        self.container = av.open(str(path), mode="w")
+        self.stream = self.container.add_stream("libx264", rate=round(fps))
+        self.stream.width = width
+        self.stream.height = height
+        self.stream.pix_fmt = "yuv420p"
+        self.stream.options = {"crf": "20", "preset": "medium"}
+
+    def write(self, rgb: np.ndarray) -> None:
+        frame = av.VideoFrame.from_ndarray(rgb, format="rgb24")
+        for packet in self.stream.encode(frame):
+            self.container.mux(packet)
+
+    def close(self) -> None:
+        for packet in self.stream.encode():
+            self.container.mux(packet)
+        self.container.close()
+
+
+def _label(image: np.ndarray, label: str) -> np.ndarray:
+    result = image.copy()
+    cv2.rectangle(result, (0, 0), (result.shape[1], 30), (0, 0, 0), -1)
+    cv2.putText(
+        result,
+        label,
+        (8, 21),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        0.52,
+        (255, 255, 255),
+        1,
+        cv2.LINE_AA,
+    )
+    return result
+
+
+def _camera_row(images: dict[str, np.ndarray], prefix: str) -> np.ndarray:
+    widths = {"head": 424, "left_wrist": 320, "right_wrist": 320}
+    tiles = []
+    for name in ("head", "left_wrist", "right_wrist"):
+        tile = cv2.resize(
+            images[name],
+            (widths[name], 240),
+            interpolation=cv2.INTER_AREA,
+        )
+        tiles.append(_label(tile, f"{prefix} | {name}"))
+    return np.concatenate(tiles, axis=1)
+
+
+def _candidate(report: dict) -> tuple[dict, str]:
+    selected = report.get("selected")
+    if selected is not None:
+        return selected, "selected_gate_pass"
+    finalists = report.get("final_candidates") or []
+    if not finalists:
+        raise RuntimeError("search report contains no full-run candidate")
+    return finalists[0], "best_failed_diagnostic_only"
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--search-report", type=Path, required=True)
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--comparison-profile", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--fps", type=float, default=20.0)
+    args = parser.parse_args()
+
+    output_dir = args.output_dir.resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+    report = json.loads(args.search_report.read_text(encoding="utf-8"))
+    candidate, disposition = _candidate(report)
+    transform = np.asarray(candidate["gaussian_to_mujoco"], dtype=np.float64)
+    if transform.shape != (4, 4) or not np.isfinite(transform).all():
+        raise RuntimeError("candidate gaussian_to_mujoco must be a finite 4x4 matrix")
+
+    trajectory = np.load(args.trajectory.resolve())
+    actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    if len(actions) != 649:
+        raise RuntimeError(f"expected 649 actions, got {len(actions)}")
+    specs = resolve_camera_set(DEFAULT_CAMERA_SET)
+
+    candidate_env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=DEFAULT_CAMERA_SET,
+        visual_shell_profile=str(args.profile.resolve()),
+        visual_shell_strict=True,
+    )
+    comparison_env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=DEFAULT_CAMERA_SET,
+        visual_shell_profile=str(args.comparison_profile.resolve()),
+        visual_shell_strict=True,
+    )
+    width = 424 + 320 + 320
+    video_path = output_dir / "baseline-infinigen-three-camera-sync.mp4"
+    writer = _H264Writer(video_path, width, 480, args.fps)
+    key_frames = {0, 100, 200, 300, 400, 500, 648}
+    started = time.perf_counter()
+    frame_metrics: dict[str, dict] = {}
+    try:
+        candidate_env.reset(seed=seed)
+        comparison_env.reset(seed=seed)
+        candidate_env._visual_shell.mujoco_to_gaussian = np.linalg.inv(transform)
+        for frame_index in range(649):
+            candidate_images, candidate_metrics = capture_cameras(candidate_env)
+            comparison_images, comparison_metrics = capture_cameras(comparison_env)
+            writer.write(
+                np.concatenate(
+                    [
+                        _camera_row(comparison_images, "pose-optimized-final"),
+                        _camera_row(candidate_images, "Infinigen"),
+                    ],
+                    axis=0,
+                )
+            )
+            if frame_index in key_frames:
+                still = np.concatenate(
+                    [
+                        _camera_row(comparison_images, "pose-optimized-final"),
+                        _camera_row(candidate_images, "Infinigen"),
+                    ],
+                    axis=0,
+                )
+                cv2.imwrite(
+                    str(output_dir / f"comparison-frame-{frame_index:04d}.png"),
+                    cv2.cvtColor(still, cv2.COLOR_RGB2BGR),
+                )
+                frame_metrics[str(frame_index)] = {
+                    "comparison": comparison_metrics,
+                    "infinigen": candidate_metrics,
+                }
+            if frame_index < 648:
+                candidate_env.step(actions[frame_index], fast=True)
+                comparison_env.step(actions[frame_index], fast=True)
+    finally:
+        writer.close()
+        candidate_status = candidate_env._visual_shell.status()
+        comparison_status = comparison_env._visual_shell.status()
+        candidate_env.close()
+        comparison_env.close()
+
+    result = {
+        "schema_version": 1,
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": seed,
+        "frames": 649,
+        "fps": args.fps,
+        "camera_set": DEFAULT_CAMERA_SET,
+        "camera_order": [spec.name for spec in specs],
+        "candidate_disposition": disposition,
+        "candidate_profile_materialized": False,
+        "candidate_gate_passed": bool(candidate.get("gate", {}).get("passed")),
+        "candidate_parameters": candidate.get("parameters"),
+        "candidate_gaussian_to_mujoco": transform.tolist(),
+        "elapsed_seconds": time.perf_counter() - started,
+        "candidate_shell_status": candidate_status,
+        "comparison_shell_status": comparison_status,
+        "key_frame_metrics": frame_metrics,
+        "video": {
+            "path": str(video_path),
+            "bytes": video_path.stat().st_size,
+            "sha256": _sha256(video_path),
+        },
+    }
+    (output_dir / "diagnostic-video-report.json").write_text(
+        json.dumps(result, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
