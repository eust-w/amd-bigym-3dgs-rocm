+    parser.add_argument("--scene-placement-equivariance-report", type=Path)
+    parser.add_argument("--scene-placement-profile", type=Path)
+    parser.add_argument(
+        "--code-commit",
+        help="local reviewed commit containing the deployed diagnostic code",
+    )
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    acceptance = (
+        evidence_report_snapshot(args.visual_acceptance_report)
+        if args.visual_acceptance_report is not None
+        else None
+    )
+    if (
+        acceptance is not None
+        and acceptance["report"].get("formal_collection_allowed") is not False
+    ):
+        parser.error("receipt is only for a blocked formal collection")
+    world_lock = evidence_report_snapshot(args.world_lock_report)
+    physics_parity = evidence_report_snapshot(args.physics_parity_report)
+    depth_calibration = (
+        evidence_report_snapshot(args.depth_calibration_report)
+        if args.depth_calibration_report is not None
+        else None
+    )
+    appearance_search = (
+        evidence_report_snapshot(args.appearance_search_report)
+        if args.appearance_search_report is not None
+        else None
+    )
+    external_search = (
+        evidence_report_snapshot(args.external_camera_search_report)
+        if args.external_camera_search_report is not None
+        else None
+    )
+    placement_equivariance = (
+        evidence_report_snapshot(args.scene_placement_equivariance_report)
+        if args.scene_placement_equivariance_report is not None
