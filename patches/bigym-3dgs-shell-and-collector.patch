+#!/usr/bin/env python3
+"""Fit an upright visual-shell pose to a recorded BiGym camera trajectory.
+
+This optimizer deliberately keeps the reconstruction scale, floor height,
+pitch, and roll unchanged.  It only searches a horizontal translation and a
+yaw offset, so a visual quality improvement cannot come from tilting or
+rescaling the photographed room.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+CAMERA_KEYS = {
+    "head": ("head_positions", "head_rotations_mujoco"),
+    "left_wrist": (
+        "left_wrist_positions",
+        "left_wrist_rotations_mujoco",
+    ),
+    "right_wrist": (
+        "right_wrist_positions",
+        "right_wrist_rotations_mujoco",
+    ),
+}
+MUJOCO_TO_CV_CAMERA = np.diag([1.0, -1.0, -1.0])
+
+
+def normalized_rotation(matrix: np.ndarray) -> np.ndarray:
+    u, _, vh = np.linalg.svd(matrix)
+    rotation = u @ vh
+    if np.linalg.det(rotation) < 0.0:
+        u[:, -1] *= -1.0
+        rotation = u @ vh
+    return rotation
+
+
+def yaw_rotation(yaw_degrees: float) -> np.ndarray:
+    yaw = math.radians(yaw_degrees)
+    cosine = math.cos(yaw)
+    sine = math.sin(yaw)
+    return np.asarray(
+        [
+            [cosine, -sine, 0.0],
+            [sine, cosine, 0.0],
+            [0.0, 0.0, 1.0],
+        ],
+        dtype=np.float64,
+    )
+
+
+def percentile_summary(values: np.ndarray) -> dict[str, float]:
+    return {
+        "minimum": float(np.min(values)),
+        "p50": float(np.percentile(values, 50)),
+        "p90": float(np.percentile(values, 90)),
+        "p99": float(np.percentile(values, 99)),
+        "maximum": float(np.max(values)),
+        "mean": float(np.mean(values)),
+    }
+
+
+class TrajectoryPoseObjective:
+    def __init__(
+        self,
+        source_cameras: np.ndarray,
+        gaussian_to_mujoco: np.ndarray,
+        trajectory: Any,
+        *,
+        stride: int,
+    ) -> None:
+        from scipy.spatial import cKDTree
+
+        self.source_positions = (
+            source_cameras[:, :3, 3]
+            @ gaussian_to_mujoco[:3, :3].T
+            + gaussian_to_mujoco[:3, 3]
+        )
+        base_rotation = normalized_rotation(
+            gaussian_to_mujoco[:3, :3]
+        )
+        self.source_rotations = np.einsum(
+            "ij,njk->nik",
+            base_rotation,
+            source_cameras[:, :3, :3],
+        )
+        self.tree = cKDTree(self.source_positions)
+        self.positions: dict[str, np.ndarray] = {}
+        self.rotations_cv: dict[str, np.ndarray] = {}
+        for name, (position_key, rotation_key) in CAMERA_KEYS.items():
+            self.positions[name] = np.asarray(
+                trajectory[position_key][::stride],
+                dtype=np.float64,
+            )
+            rotations_mujoco = np.asarray(
+                trajectory[rotation_key][::stride],
+                dtype=np.float64,
+            )
+            self.rotations_cv[name] = np.einsum(
+                "nij,jk->nik",
+                rotations_mujoco,
+                MUJOCO_TO_CV_CAMERA,
+            )
+
+    def evaluate(
+        self,
+        parameters: np.ndarray | list[float] | tuple[float, ...],
+    ) -> tuple[float, dict[str, Any]]:
+        yaw_degrees, translation_x, translation_y = (
+            float(item) for item in parameters
+        )
+        rotation = yaw_rotation(yaw_degrees)
+        translation = np.asarray(
+            [translation_x, translation_y, 0.0],
+            dtype=np.float64,
+        )
+        per_camera: dict[str, Any] = {}
+        camera_scores: list[float] = []
+        for name in CAMERA_KEYS:
+            # Query in the current alignment frame.  Rigid transforms preserve
+            # distance, so the returned metric is also the candidate-frame
+            # distance.
+            query_positions = (
+                self.positions[name] - translation
+            ) @ rotation
+            distances, indices = self.tree.query(
+                query_positions,
+                workers=1,
+            )
+            candidate_source_rotations = np.einsum(
+                "ij,njk->nik",
+                rotation,
+                self.source_rotations[indices],
+            )
+            relative = np.einsum(
+                "nji,njk->nik",
+                self.rotations_cv[name],
+                candidate_source_rotations,
+            )
+            traces = np.trace(relative, axis1=1, axis2=2)
+            angles = np.degrees(
+                np.arccos(np.clip((traces - 1.0) * 0.5, -1.0, 1.0))
+            )
+            distance_summary = percentile_summary(distances)
+            angle_summary = percentile_summary(angles)
+            # Give each physical camera equal influence.  The robust p50/p90
+            # terms avoid selecting a pose for a handful of isolated frames.
+            camera_score = (
+                distance_summary["p50"] / 0.35
+                + distance_summary["p90"] / 0.50
+                + angle_summary["p50"] / 60.0
+                + angle_summary["p90"] / 90.0
+            )
+            camera_scores.append(camera_score)
+            per_camera[name] = {
+                "capture_path_translation_m": distance_summary,
+                "capture_path_rotation_degrees": angle_summary,
+                "score": float(camera_score),
+            }
+        score = float(np.mean(camera_scores))
+        return score, {
+            "score": score,
+            "yaw_offset_degrees": yaw_degrees,
+            "translation_xy_m": [translation_x, translation_y],
+            "per_camera": per_camera,
+        }
+
+
+def load_source_cameras(path: Path) -> np.ndarray:
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    cameras = np.asarray(
+        payload.get("camtoworlds")
+        or [
+            frame.get("transform_matrix") or frame.get("camtoworld")
+            for frame in payload["frames"]
+        ],
+        dtype=np.float64,
+    )
+    if cameras.ndim != 3 or cameras.shape[1:] != (4, 4):
+        raise ValueError(f"invalid source camera path: {path}")
+    if not np.isfinite(cameras).all():
+        raise ValueError(f"non-finite source camera path: {path}")
+    return cameras
+
+
+def candidate_transform(
+    current_transform: np.ndarray,
+    result: dict[str, Any],
+) -> tuple[np.ndarray, np.ndarray]:
+    post_transform = np.eye(4, dtype=np.float64)
+    post_transform[:3, :3] = yaw_rotation(
+        result["yaw_offset_degrees"]
+    )
+    post_transform[:2, 3] = result["translation_xy_m"]
+    return post_transform @ current_transform, post_transform
+
+
+def write_optimized_profile(
+    *,
+    source_profile_path: Path,
+    output_dir: Path,
+    current_alignment: dict[str, Any],
+    selected: dict[str, Any],
+    baseline: dict[str, Any],
+    full_stride: int,
+) -> Path:
+    profile = json.loads(source_profile_path.read_text(encoding="utf-8"))
+    current_transform = np.asarray(
+        current_alignment["gaussian_to_mujoco"],
+        dtype=np.float64,
+    )
+    transform, post_transform = candidate_transform(
+        current_transform,
+        selected,
+    )
+    output_dir.mkdir(parents=True, exist_ok=True)
+    optimization = {
+        "schema_version": 1,
+        "task": "DishwasherUnloadCutleryLong",
+        "constraints": {
+            "scale_unchanged": True,
+            "floor_height_unchanged": True,
+            "pitch_roll_unchanged": True,
+            "searched_parameters": [
+                "horizontal_translation_x_m",
+                "horizontal_translation_y_m",
+                "yaw_offset_degrees",
+            ],
+        },
+        "trajectory_stride": full_stride,
+        "baseline": baseline,
+        "selected": selected,
+        "disclosure": (
+            "This is the best upright pose found for the fixed reconstruction. "
+            "The source path remains a narrow, near-constant-height capture, "
+            "so low wrist views are still diagnostic extrapolation."
+        ),
+    }
+    alignment = {
+        **current_alignment,
+        "gaussian_to_mujoco": transform.tolist(),
+        "mujoco_to_gaussian": np.linalg.inv(transform).tolist(),
+        "task_trajectory_optimization": {
+            **optimization,
+            "post_transform": post_transform.tolist(),
+        },
+        "alignment_quality": {
+            "status": "diagnostic_camera_extrapolation",
+            "task": "DishwasherUnloadCutleryLong",
+            "selected_trajectory_coverage": selected["per_camera"],
+            "formal_collection_recommended": False,
+            "awaiting_visual_approval": True,
+        },
+    }
+    alignment_path = output_dir / "alignment-task-optimized.json"
+    alignment_path.write_text(
+        json.dumps(alignment, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    profile["name"] = (
+        f"{profile.get('name', 'visual-shell')}"
+        "-dishwasher-unload-cutlery-long-opt"
+    )
+    profile["description"] = (
+        f"{profile.get('description', '')} Task-trajectory upright pose "
+        "optimization for DishwasherUnloadCutleryLong."
+    ).strip()
+    profile["alignment"] = {"path": alignment_path.name}
+    profile["quality"] = {
+        **profile.get("quality", {}),
+        "status": "diagnostic_camera_extrapolation",
+        "formal_collection_recommended": False,
+        "awaiting_visual_approval": True,
+        "task": "DishwasherUnloadCutleryLong",
+        "task_trajectory_optimization": optimization,
+    }
+    profile_path = output_dir / "profile.json"
+    profile_path.write_text(
+        json.dumps(profile, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    for filename in set(profile["layer_files"].values()):
+        source = (source_profile_path.parent / filename).resolve()
+        target = output_dir / filename
+        if target.exists() or target.is_symlink():
+            target.unlink()
+        os.symlink(source, target)
+    return profile_path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--camera-path", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--search-stride", type=int, default=8)
+    parser.add_argument("--full-stride", type=int, default=1)
+    parser.add_argument("--yaw-bound-degrees", type=float, default=75.0)
+    parser.add_argument("--translation-bound-m", type=float, default=0.75)
+    parser.add_argument("--seed", type=int, default=20260731)
+    parser.add_argument(
+        "--fixed-parameters",
+        type=float,
+        nargs=3,
+        metavar=("YAW_DEGREES", "TRANSLATION_X_M", "TRANSLATION_Y_M"),
+        help=(
+            "skip optimization and emit a profile for an explicit candidate; "
+            "useful for matched visual interpolation checks"
+        ),
+    )
+    args = parser.parse_args()
+
+    if args.search_stride < 1 or args.full_stride < 1:
+        parser.error("trajectory strides must be positive")
+    profile = json.loads(args.profile.read_text(encoding="utf-8"))
+    alignment_path = args.profile.parent / profile["alignment"]["path"]
+    alignment = json.loads(alignment_path.read_text(encoding="utf-8"))
+    transform = np.asarray(
+        alignment["gaussian_to_mujoco"],
+        dtype=np.float64,
+    )
+    source_cameras = load_source_cameras(args.camera_path)
+    trajectory = np.load(args.trajectory)
+
+    search_objective = TrajectoryPoseObjective(
+        source_cameras,
+        transform,
+        trajectory,
+        stride=args.search_stride,
+    )
+    from scipy.optimize import differential_evolution
+
+    bounds = [
+        (-args.yaw_bound_degrees, args.yaw_bound_degrees),
+        (-args.translation_bound_m, args.translation_bound_m),
+        (-args.translation_bound_m, args.translation_bound_m),
+    ]
+    if args.fixed_parameters is None:
+        optimized = differential_evolution(
+            lambda parameters: search_objective.evaluate(parameters)[0],
+            bounds=bounds,
+            seed=args.seed,
+            popsize=18,
+            maxiter=120,
+            tol=1e-7,
+            polish=True,
+            updating="immediate",
+            workers=1,
+        )
+        parameters = optimized.x
+        optimizer_report = {
+            "mode": "differential_evolution",
+            "success": bool(optimized.success),
+            "message": str(optimized.message),
+            "iterations": int(optimized.nit),
+            "function_evaluations": int(optimized.nfev),
+            "search_score": float(optimized.fun),
+        }
+    else:
+        parameters = np.asarray(args.fixed_parameters, dtype=np.float64)
+        search_score, _ = search_objective.evaluate(parameters)
+        optimizer_report = {
+            "mode": "fixed_candidate",
+            "success": True,
+            "message": "explicit parameters requested",
+            "iterations": 0,
+            "function_evaluations": 1,
+            "search_score": float(search_score),
+        }
+    full_objective = TrajectoryPoseObjective(
+        source_cameras,
+        transform,
+        trajectory,
+        stride=args.full_stride,
+    )
+    _, baseline = full_objective.evaluate([0.0, 0.0, 0.0])
+    _, selected = full_objective.evaluate(parameters)
+    selected["optimizer"] = {
+        **optimizer_report,
+        "bounds": {
+            "yaw_offset_degrees": bounds[0],
+            "translation_x_m": bounds[1],
+            "translation_y_m": bounds[2],
+        },
+    }
+    selected["relative_score_improvement_percent"] = float(
+        100.0 * (baseline["score"] - selected["score"]) / baseline["score"]
+    )
+    profile_path = write_optimized_profile(
+        source_profile_path=args.profile.resolve(),
+        output_dir=args.output_dir.resolve(),
+        current_alignment=alignment,
+        selected=selected,
+        baseline=baseline,
+        full_stride=args.full_stride,
+    )
+    report = {
+        "schema_version": 1,
+        "source_profile": str(args.profile.resolve()),
+        "source_alignment": str(alignment_path.resolve()),
+        "source_camera_path": str(args.camera_path.resolve()),
+        "trajectory": str(args.trajectory.resolve()),
+        "output_profile": str(profile_path),
+        "baseline": baseline,
+        "selected": selected,
+    }
+    report_path = args.output_dir / "pose-optimization-report.json"
+    report_path.write_text(
+        json.dumps(report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
