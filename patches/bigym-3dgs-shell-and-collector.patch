+#!/usr/bin/env python3
+"""Turn a visual-shell search report into compact review evidence."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+from pathlib import Path
+from typing import Any
+
+import cv2
+import numpy as np
+
+
+CAMERAS = ("head", "left_wrist", "right_wrist")
+HEATMAP_METRICS = (
+    ("task_context_gaussian_coverage", "Gaussian coverage", True),
+    ("task_context_severe_fog_fraction", "Severe fog", False),
+    ("depth_conflict_fraction", "Depth conflict", False),
+)
+
+
+def _camera_rows(candidate: dict[str, Any], camera: str) -> list[dict[str, Any]]:
+    return sorted(
+        (row for row in candidate["appearance"] if row["camera"] == camera),
+        key=lambda row: int(row["frame"]),
+    )
+
+
+def worst_frames(candidate: dict[str, Any]) -> dict[str, Any]:
+    result = {}
+    definitions = {
+        "lowest_coverage": ("task_context_gaussian_coverage", min),
+        "lowest_clear_score": ("task_context_clear_score", min),
+        "highest_severe_fog": ("task_context_severe_fog_fraction", max),
+        "highest_depth_conflict": ("depth_conflict_fraction", max),
+    }
+    for camera in CAMERAS:
+        rows = _camera_rows(candidate, camera)
+        camera_result = {}
+        for name, (metric, operation) in definitions.items():
+            row = operation(rows, key=lambda item: float(item.get(metric, 0.0)))
+            camera_result[name] = {
+                "frame": int(row["frame"]),
+                "value": float(row.get(metric, 0.0)),
+                "metric": metric,
+            }
+        result[camera] = camera_result
+    return result
+
+
+def _label(canvas: np.ndarray, text: str, x: int, y: int) -> None:
+    cv2.putText(
+        canvas,
+        text,
+        (x, y),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        0.48,
+        (25, 25, 25),
+        1,
+        cv2.LINE_AA,
+    )
+
+
+def write_heatmaps(candidate: dict[str, Any], destination: Path) -> None:
+    width = 1050
+    label_width = 155
+    row_height = 34
+    panel_gap = 44
+    panel_height = row_height * len(CAMERAS) + panel_gap
+    canvas = np.full(
+        (panel_height * len(HEATMAP_METRICS), width, 3), 255, dtype=np.uint8
+    )
+    for panel_index, (metric, title, positive) in enumerate(HEATMAP_METRICS):
+        top = panel_index * panel_height
+        _label(canvas, title, 10, top + 22)
+        for camera_index, camera in enumerate(CAMERAS):
+            rows = _camera_rows(candidate, camera)
+            values = np.asarray(
+                [float(row.get(metric, 0.0)) for row in rows], dtype=np.float32
+            )
+            strip = np.clip(values, 0.0, 1.0)[None, :]
+            if positive:
+                strip = 1.0 - strip
+            pixels = np.round(strip * 255.0).astype(np.uint8)
+            colored = cv2.applyColorMap(pixels, cv2.COLORMAP_TURBO)
+            colored = cv2.resize(
+                colored,
+                (width - label_width - 15, row_height - 6),
+                interpolation=cv2.INTER_NEAREST,
+            )
+            y = top + panel_gap + camera_index * row_height
+            _label(canvas, camera, 10, y + 20)
+            canvas[y : y + row_height - 6, label_width : width - 15] = colored
+            _label(
+                canvas,
+                f"p10={np.percentile(values, 10):.4f} max={np.max(values):.4f}",
+                width - 235,
+                y + 20,
+            )
+    cv2.imwrite(str(destination), canvas)
+
+
+def write_clarity_curves(candidate: dict[str, Any], destination: Path) -> None:
+    width, height = 1100, 720
+    canvas = np.full((height, width, 3), 255, dtype=np.uint8)
+    left, right = 125, width - 30
+    panel_height = 205
+    colors = [(200, 70, 20), (30, 140, 60), (30, 90, 210)]
+    for index, camera in enumerate(CAMERAS):
+        rows = _camera_rows(candidate, camera)
+        values = np.asarray(
+            [float(row["task_context_clear_score"]) for row in rows]
+        )
+        baseline = float(
+            candidate["gate"]["per_camera"][camera]["baseline"]["clear_score"][
+                "p10"
+            ]
+        )
+        maximum = max(float(np.max(values)), baseline, 1e-6) * 1.08
+        top = 25 + index * (panel_height + 20)
+        bottom = top + panel_height
+        cv2.rectangle(canvas, (left, top), (right, bottom), (220, 220, 220), 1)
+        points = []
+        for sample, value in enumerate(values):
+            x = left + int((right - left) * sample / max(len(values) - 1, 1))
+            y = bottom - int(panel_height * value / maximum)
+            points.append([x, y])
+        cv2.polylines(
+            canvas,
+            [np.asarray(points, dtype=np.int32)],
+            False,
+            colors[index],
+            2,
+            cv2.LINE_AA,
+        )
+        baseline_y = bottom - int(panel_height * baseline / maximum)
+        cv2.line(canvas, (left, baseline_y), (right, baseline_y), (80, 80, 80), 1)
+        _label(canvas, camera, 12, top + 24)
+        _label(
+            canvas,
+            f"current p10={np.percentile(values, 10):.4f}  baseline p10={baseline:.4f}",
+            left + 10,
+            top + 22,
+        )
+    cv2.imwrite(str(destination), canvas)
+
+
+def write_ranking(report: dict[str, Any], destination: Path) -> None:
+    with destination.open("w", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(
+            stream,
+            fieldnames=(
+                "rank",
+                "passed",
+                "clear_camera_count",
+                "scale",
+                "yaw_degrees",
+                "x_m",
+                "y_m",
+                "z_m",
+                "three_camera_mean_clear",
+                "rejection_reasons",
+            ),
+        )
+        writer.writeheader()
+        for rank, candidate in enumerate(report["final_candidates"], start=1):
+            parameters = candidate["parameters"]
+            gate = candidate["gate"]
+            writer.writerow(
+                {
+                    "rank": rank,
+                    "passed": gate["passed"],
+                    "clear_camera_count": gate["clear_camera_count"],
+                    "scale": parameters["scale"],
+                    "yaw_degrees": parameters["yaw"],
+                    "x_m": parameters["x"],
+                    "y_m": parameters["y"],
+                    "z_m": parameters["z"],
+                    "three_camera_mean_clear": gate["three_camera_mean_clear"],
+                    "rejection_reasons": ";".join(gate["rejection_reasons"]),
+                }
+            )
+
+
+def summarize(report_path: Path, output_dir: Path) -> dict[str, Any]:
+    report = json.loads(report_path.read_text(encoding="utf-8"))
+    candidates = report.get("final_candidates", [])
+    if not candidates:
+        raise ValueError("search report contains no full-trajectory candidate")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    selected = report.get("selected") or candidates[0]
+    worst = worst_frames(selected)
+    worst_path = output_dir / "worst-frames.json"
+    worst_path.write_text(json.dumps(worst, indent=2) + "\n", encoding="utf-8")
+    heatmaps = output_dir / "coverage-fog-depth-heatmaps.png"
+    curves = output_dir / "clarity-curves.png"
+    ranking = output_dir / "candidate-ranking.csv"
+    write_heatmaps(selected, heatmaps)
+    write_clarity_curves(selected, curves)
+    write_ranking(report, ranking)
+    result = {
+        "schema_version": 1,
+        "status": "generated",
+        "search_status": report["status"],
+        "candidate_passed": bool(selected["gate"]["passed"]),
+        "candidate_parameters": selected["parameters"],
+        "worst_frames": str(worst_path),
+        "heatmaps": str(heatmaps),
+        "clarity_curves": str(curves),
+        "ranking": str(ranking),
+    }
+    (output_dir / "evidence-summary.json").write_text(
+        json.dumps(result, indent=2) + "\n", encoding="utf-8"
+    )
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(summarize(args.report, args.output_dir), indent=2))
+
+
+if __name__ == "__main__":
+    main()
