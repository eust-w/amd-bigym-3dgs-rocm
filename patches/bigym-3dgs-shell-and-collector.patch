+#!/usr/bin/env python3
+"""Rank already-authorized ScanNet++ kitchen IDs without downloading data.
+
+This tool consumes only a local ``scene_types.json`` supplied by the user.  It
+does not authenticate, accept terms, call a network endpoint, or inspect a
+credential file.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+
+SCENE_ID_PATTERN = re.compile(r"^[0-9a-f]{10}$")
+PRIMARY_SCENE_ID = "c0f5742640"
+
+
+def _label(value: Any) -> str | None:
+    if isinstance(value, dict):
+        value = value.get("scene_type") or value.get("type") or value.get("label")
+    if isinstance(value, list):
+        value = " ".join(str(item) for item in value)
+    return value.strip() if isinstance(value, str) and value.strip() else None
+
+
+def kitchen_scene_candidates(
+    scene_types_path: Path,
+    *,
+    primary_scene_id: str = PRIMARY_SCENE_ID,
+    maximum: int = 4,
+) -> list[dict[str, Any]]:
+    if maximum < 1:
+        raise ValueError("maximum must be positive")
+    payload = json.loads(scene_types_path.read_text(encoding="utf-8"))
+    if not isinstance(payload, dict):
+        raise ValueError("scene_types.json must contain an object")
+    scenes = payload.get("scenes", payload)
+    if not isinstance(scenes, dict):
+        raise ValueError("scene_types.json scenes must contain an object")
+    candidates = []
+    for scene_id, value in scenes.items():
+        label = _label(value)
+        if not isinstance(scene_id, str) or not SCENE_ID_PATTERN.fullmatch(scene_id):
+            continue
+        if label is None or "kitchen" not in label.casefold():
+            continue
+        candidates.append(
+            {
+                "scene_id": scene_id,
+                "scene_type": label,
+                "priority": 0 if scene_id == primary_scene_id else 1,
+            }
+        )
+    candidates.sort(key=lambda item: (item["priority"], item["scene_id"]))
+    return candidates[:maximum]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter
+    )
+    parser.add_argument("--scene-types", type=Path, required=True)
+    parser.add_argument("--primary-scene-id", default=PRIMARY_SCENE_ID)
+    parser.add_argument("--maximum", type=int, default=4)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    result = {
+        "schema_version": 1,
+        "status": "metadata_only_no_download",
+        "source_access": "user_authorization_required",
+        "primary_scene_id": args.primary_scene_id,
+        "candidates": kitchen_scene_candidates(
+            args.scene_types,
+            primary_scene_id=args.primary_scene_id,
+            maximum=args.maximum,
+        ),
+    }
+    serialized = json.dumps(result, indent=2) + "\n"
+    if args.output is not None:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(serialized, encoding="utf-8")
+    print(serialized, end="")
+
+
+if __name__ == "__main__":
+    main()
