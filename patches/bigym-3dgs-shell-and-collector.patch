+"""Evidence receipt helpers for BiGym Plus generation and evaluation runs."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import platform
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+
+TRACKED_PACKAGES = (
+    "bigym",
+    "gaussian_renderer",
+    "amd_gsplat",
+    "gsplat",
+    "lerobot",
+    "mujoco",
+    "numpy",
+    "torch",
+)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _package_versions() -> dict[str, str]:
+    versions: dict[str, str] = {}
+    for name in TRACKED_PACKAGES:
+        try:
+            versions[name] = importlib.metadata.version(name)
+        except importlib.metadata.PackageNotFoundError:
+            continue
+    return versions
+
+
+def _git_revision() -> str | None:
+    repository = Path(__file__).resolve().parents[2]
+    try:
+        return subprocess.run(
+            ["git", "rev-parse", "HEAD"],
+            cwd=repository,
+            check=True,
+            capture_output=True,
+            text=True,
+        ).stdout.strip()
+    except (OSError, subprocess.CalledProcessError):
+        return None
+
+
+def runtime_snapshot() -> dict[str, Any]:
+    snapshot: dict[str, Any] = {
+        "python": platform.python_version(),
+        "platform": platform.platform(),
+        "git_revision": _git_revision(),
+        "packages": _package_versions(),
+        "hsa_override_gfx_version": os.environ.get("HSA_OVERRIDE_GFX_VERSION"),
+    }
+    try:
+        import torch
+
+        cuda_available = bool(torch.cuda.is_available())
+        snapshot["torch"] = {
+            "version": torch.__version__,
+            "hip": torch.version.hip,
+            "cuda_available_api": cuda_available,
+            "device_name": (
+                torch.cuda.get_device_name(0) if cuda_available else None
+            ),
+            "device_capability": (
+                list(torch.cuda.get_device_capability(0))
+                if cuda_available
+                else None
+            ),
+        }
+    except Exception as exc:  # Runtime evidence must survive optional imports.
+        snapshot["torch"] = {
+            "available": False,
+            "error": f"{type(exc).__name__}: {exc}",
+        }
+    return snapshot
+
+
+def profile_snapshot(profile_path: str | Path) -> dict[str, Any]:
+    profile = Path(profile_path).expanduser().resolve()
+    payload = json.loads(profile.read_text(encoding="utf-8"))
+    asset_dir = profile.parent
+    names = {
+        profile.name,
+        str(payload.get("alignment", {}).get("path", "alignment.json")),
+    }
+    names.update(str(value) for value in payload.get("layer_files", {}).values())
+    files = []
+    for name in sorted(names):
+        path = (asset_dir / name).resolve()
+        if not path.is_file():
+            files.append({"path": str(path), "missing": True})
+            continue
+        files.append(
+            {
+                "path": str(path),
+                "bytes": path.stat().st_size,
+                "sha256": _sha256(path),
+            }
+        )
+    return {
+        "requested_profile": str(profile),
+        "name": payload.get("name"),
+        "source_kind": payload.get("source_kind"),
+        "layer_mode": (
+            "combined"
+            if "combined" in payload.get("layer_files", {})
+            else "layered"
+        ),
+        "asset_contract": payload.get("asset"),
+        "prealigned_mujoco_metric": payload.get("asset", {}).get(
+            "prealigned_mujoco_metric"
+        ),
+        "safe_obb_mujoco": payload.get("free_view_contract", {}).get(
+            "safe_space_obb_mujoco"
+        ),
+        "clear_obb_mujoco": payload.get("free_view_contract", {}).get(
+            "clear_obb_mujoco"
+        ),
+        "quality": payload.get("quality"),
+        "source": payload.get("source"),
+        "files": files,
+    }
+
+
+def evidence_report_snapshot(report_path: str | Path) -> dict[str, Any]:
+    path = Path(report_path).expanduser().resolve()
+    return {
+        "path": str(path),
+        "bytes": path.stat().st_size,
+        "sha256": _sha256(path),
+        "report": json.loads(path.read_text(encoding="utf-8")),
+    }
+
+
+def new_receipt(
+    *,
+    mode: str,
+    tasks: list[str],
+    output_root: str | Path,
+    visual_shell_profile: str | None,
+    visual_shell_strict: bool,
+    camera_set: str | None = None,
+    cameras: Any = (),
+    world_lock_report: str | Path | None = None,
+    visual_acceptance_report: str | Path | None = None,
+    scene_placement: Any = None,
+) -> dict[str, Any]:
+    camera_records = [
+        {
+            "name": camera.name,
+            "feature_key": f"observation.images.{camera.lr_key}",
+            "resolution_hw": list(camera.resolution),
+            "fovy_degrees": float(camera.fovy),
+            "configured_position_m": (
+                list(camera.pos) if camera.pos is not None else None
+            ),
+            "configured_quaternion_wxyz": (
+                list(camera.quat) if camera.quat is not None else None
+            ),
+        }
+        for camera in cameras
+    ]
+    return {
+        "schema_version": 1,
+        "status": "running",
+        "technical_status": "running",
+        "visual_status": (
+            "awaiting_visual_approval"
+            if visual_shell_profile
+            else "not_applicable"
+        ),
+        "created_at": datetime.now(timezone.utc).isoformat(),
+        "mode": mode,
+        "tasks": tasks,
+        "output_root": str(Path(output_root).expanduser().resolve()),
+        "camera_set": camera_set,
+        "dataset_variant": (
+            "placed-world" if scene_placement is not None else "canonical"
+        ),
+        "coordinate_frame": (
+            scene_placement.coordinate_frame
+            if scene_placement is not None
+            else "bigym-canonical"
+        ),
+        "scene_placement": (
+            scene_placement.snapshot()
+            if scene_placement is not None
+            else None
+        ),
+        "camera_order": [camera["name"] for camera in camera_records],
+        "cameras": camera_records,
+        "visual_shell": {
+            "requested": visual_shell_profile,
+            "strict": visual_shell_strict,
+            "fallback_allowed": not visual_shell_strict,
+            "world_lock": (
+                evidence_report_snapshot(world_lock_report)
+                if world_lock_report is not None
+                else None
+            ),
+            "visual_acceptance": (
+                evidence_report_snapshot(visual_acceptance_report)
+                if visual_acceptance_report is not None
+                else None
+            ),
+        },
+        "runtime": runtime_snapshot(),
+        "environments": [],
+        "episodes": [],
+    }
+
+
+def record_environment(
+    receipt: dict[str, Any],
+    *,
+    env: Any,
+    task: str,
+    elapsed_seconds: float,
+) -> None:
+    shell = getattr(env, "_visual_shell", None)
+    shell_status = shell.status() if shell is not None else {"enabled": False}
+    rendered_frames = int(shell_status.get("rendered_frames", 0))
+    camera_poses = []
+    for camera_config in env.observation_config.cameras:
+        camera_id = env._cameras_map[camera_config.name][0]
+        camera_poses.append(
+            {
+                "name": camera_config.name,
+                "position_m": [
+                    float(value)
+                    for value in env.action_mode._mojo.data.cam_xpos[camera_id]
+                ],
+                "rotation_mujoco": [
+                    [
+                        float(value)
+                        for value in row
+                    ]
+                    for row in env.action_mode._mojo.data.cam_xmat[
+                        camera_id
+                    ].reshape(3, 3)
+                ],
+                "fovy_degrees": float(
+                    env.action_mode._mojo.model.cam_fovy[camera_id]
+                ),
+                "resolution_hw": list(camera_config.resolution),
+            }
+        )
+    environment = {
+        "task": task,
+        "elapsed_seconds": elapsed_seconds,
+        "visual_shell": shell_status,
+        "seconds_per_rendered_camera_frame": (
+            elapsed_seconds / rendered_frames if rendered_frames else None
+        ),
+        "simulation_time": float(env.action_mode._mojo.data.time),
+        "contacts": int(env.action_mode._mojo.data.ncon),
+        "camera_poses_at_close": camera_poses,
+    }
+    receipt["environments"].append(environment)
+    if shell is not None:
+        resolved_profile = shell_status.get("profile")
+        if resolved_profile:
+            receipt["visual_shell"]["asset"] = profile_snapshot(
+                str(resolved_profile)
+            )
+    try:
+        import torch
+
+        if torch.cuda.is_available():
+            receipt["runtime"]["torch"]["peak_allocated_bytes"] = int(
+                torch.cuda.max_memory_allocated()
+            )
+            receipt["runtime"]["torch"]["peak_reserved_bytes"] = int(
+                torch.cuda.max_memory_reserved()
+            )
+    except Exception:
+        pass
+
+
+def finish_receipt(
+    receipt: dict[str, Any],
+    *,
+    status: str,
+    technical_status: str,
+    error: str | None = None,
+) -> None:
+    receipt["status"] = status
+    receipt["technical_status"] = technical_status
+    receipt["finished_at"] = datetime.now(timezone.utc).isoformat()
+    if error:
+        receipt["error"] = error
+
+
+def write_receipt(path: str | Path, receipt: dict[str, Any]) -> Path:
+    destination = Path(path)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = destination.with_suffix(destination.suffix + ".tmp")
+    temporary.write_text(
+        json.dumps(receipt, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+    os.replace(temporary, destination)
+    return destination
