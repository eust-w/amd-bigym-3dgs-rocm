+#!/usr/bin/env python3
+"""Create a four-camera, upright Sim(3) visual-shell profile.
+
+The post-transform is applied in MuJoCo world coordinates around the visual
+floor anchor.  It may change only horizontal translation, yaw, and uniform
+scale; pitch, roll, and the anchored floor height remain unchanged.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+from pathlib import Path
+
+import numpy as np
+
+from env_utils import EXTERNAL_CAMERA, FOUR_CAMERA_SET, resolve_camera_set
+
+
+def _yaw_rotation(yaw_degrees: float) -> np.ndarray:
+    yaw = math.radians(yaw_degrees)
+    cosine = math.cos(yaw)
+    sine = math.sin(yaw)
+    return np.asarray(
+        [
+            [cosine, -sine, 0.0],
+            [sine, cosine, 0.0],
+            [0.0, 0.0, 1.0],
+        ],
+        dtype=np.float64,
+    )
+
+
+def _post_transform(
+    *,
+    scale: float,
+    yaw_degrees: float,
+    translation_xy_m: tuple[float, float],
+    translation_z_m: float,
+    anchor_xy_m: tuple[float, float],
+    floor_anchor_z_m: float,
+) -> np.ndarray:
+    anchor = np.asarray(
+        [anchor_xy_m[0], anchor_xy_m[1], floor_anchor_z_m],
+        dtype=np.float64,
+    )
+    rotation_scale = scale * _yaw_rotation(yaw_degrees)
+    transform = np.eye(4, dtype=np.float64)
+    transform[:3, :3] = rotation_scale
+    transform[:3, 3] = (
+        anchor
+        - rotation_scale @ anchor
+        + np.asarray(
+            [
+                translation_xy_m[0],
+                translation_xy_m[1],
+                translation_z_m,
+            ],
+            dtype=np.float64,
+        )
+    )
+    return transform
+
+
+def _write_profile(args: argparse.Namespace) -> Path:
+    source_profile_path = args.profile.expanduser().resolve()
+    source_profile = json.loads(
+        source_profile_path.read_text(encoding="utf-8")
+    )
+    source_alignment_path = (
+        source_profile_path.parent
+        / source_profile.get("alignment", {}).get("path", "alignment.json")
+    ).resolve()
+    source_alignment = json.loads(
+        source_alignment_path.read_text(encoding="utf-8")
+    )
+    source_gaussian_to_mujoco = np.asarray(
+        source_alignment["gaussian_to_mujoco"],
+        dtype=np.float64,
+    )
+    post_transform = _post_transform(
+        scale=args.scale,
+        yaw_degrees=args.yaw_degrees,
+        translation_xy_m=tuple(args.translation_xy_m),
+        translation_z_m=args.translation_z_m,
+        anchor_xy_m=tuple(args.anchor_xy_m),
+        floor_anchor_z_m=args.floor_anchor_z_m,
+    )
+    gaussian_to_mujoco = post_transform @ source_gaussian_to_mujoco
+    output_dir = args.output_dir.expanduser().resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+    candidate_metrics = [
+        {
+            "uniform_scale": float(scale),
+            "maximum_depth_conflict_fraction": float(conflict),
+        }
+        for scale, conflict in args.candidate_depth_conflict
+    ]
+    selection_report_path = output_dir / "world-alignment-selection.json"
+    selection_report = {
+        "schema_version": 1,
+        "task": "DishwasherUnloadCutleryLong",
+        "sample_frames": [0, 100, 300, 648],
+        "depth_conflict_threshold": 0.01,
+        "candidates": candidate_metrics,
+        "selected": {
+            "uniform_scale": args.scale,
+            "yaw_offset_degrees": args.yaw_degrees,
+            "translation_xy_m": list(args.translation_xy_m),
+            "translation_z_m": args.translation_z_m,
+            "anchor_xy_m": list(args.anchor_xy_m),
+            "reason": args.selection_reason,
+            "background_laplacian_variance": (
+                args.selected_background_laplacian
+            ),
+        },
+    }
+    selection_report_path.write_text(
+        json.dumps(selection_report, indent=2) + "\n",
+        encoding="utf-8",
+    )
+
+    optimization = {
+        "schema_version": 1,
+        "task": "DishwasherUnloadCutleryLong",
+        "selection_order": [
+            "depth_conflict_gate",
+            "capture_path_coverage",
+            "background_detail",
+        ],
+        "constraints": {
+            "upright": True,
+            "pitch_roll_unchanged": True,
+            "physical_model_unchanged": True,
+            "floor_anchor_z_m": args.floor_anchor_z_m,
+            "anchor_xy_m": list(args.anchor_xy_m),
+            "searched_parameters": [
+                "horizontal_translation_x_m",
+                "horizontal_translation_y_m",
+                "yaw_offset_degrees",
+                "uniform_scale_about_floor_anchor",
+            ],
+        },
+        "selected": {
+            "uniform_scale": args.scale,
+            "yaw_offset_degrees": args.yaw_degrees,
+            "translation_xy_m": list(args.translation_xy_m),
+            "translation_z_m": args.translation_z_m,
+            "post_transform": post_transform.tolist(),
+        },
+        "candidate_sweep_report": selection_report_path.name,
+        "disclosure": (
+            "Uniform scale was changed only after the original alignment "
+            "failed the Gaussian/native depth-order gate. The floor remains "
+            "anchored at -4 cm and the MuJoCo physical model is unchanged. "
+            "Head and wrist views remain diagnostic extrapolation."
+        ),
+    }
+    alignment = {
+        **source_alignment,
+        "gaussian_to_mujoco": gaussian_to_mujoco.tolist(),
+        "mujoco_to_gaussian": np.linalg.inv(
+            gaussian_to_mujoco
+        ).tolist(),
+        "world_lock_optimization": optimization,
+    }
+    alignment_path = output_dir / "alignment-world-locked.json"
+    alignment_path.write_text(
+        json.dumps(alignment, indent=2) + "\n",
+        encoding="utf-8",
+    )
+
+    cameras = resolve_camera_set(FOUR_CAMERA_SET)
+    observations = {
+        f"rgb_{camera.name}": {
+            "shape_chw": [
