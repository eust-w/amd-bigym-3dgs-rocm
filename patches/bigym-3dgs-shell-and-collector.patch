@@ -0,0 +1,264 @@
+#!/usr/bin/env python3
+"""Render the conservative legacy room as a three-camera review artifact."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from env_utils import (
+    DEFAULT_CAMERA_SET,
+    build_env,
+    get_state,
+    resolve_camera_set,
+)
+from render_four_camera_diagnostic import (
+    _frame_quality,
+    _H264Writer,
+    _label,
+    _quality_plot,
+    _sha256,
+)
+
+CAMERA_ORDER = ("head", "left_wrist", "right_wrist")
+
+
+def _mosaic(frames: dict[str, np.ndarray]) -> np.ndarray:
+    return np.concatenate(
+        [
+            _label(
+                cv2.resize(frames[name], (424, 240), interpolation=cv2.INTER_AREA),
+                name,
+            )
+            for name in CAMERA_ORDER
+        ],
+        axis=1,
+    )
+
+
+def _file_receipt(path: Path) -> dict[str, object]:
+    return {
+        "path": str(path),
+        "bytes": path.stat().st_size,
+        "sha256": _sha256(path),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--trajectory", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--fps", type=float, default=20.0)
+    args = parser.parse_args()
+
+    output_dir = args.output_dir.expanduser().resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+    profile = args.profile.expanduser().resolve()
+    trajectory = np.load(args.trajectory.expanduser().resolve())
+    actions = np.asarray(trajectory["actions"], dtype=np.float32)
+    seed = int(np.asarray(trajectory["seed"]).reshape(-1)[0])
+    if actions.shape != (649, 16) or not np.isfinite(actions).all():
+        raise RuntimeError(f"unexpected canonical action array: {actions.shape}")
+
+    camera_specs = resolve_camera_set(DEFAULT_CAMERA_SET)
+    video_paths = {
+        camera.name: output_dir / f"{camera.name}.mp4" for camera in camera_specs
+    }
+    writers = {
+        camera.name: _H264Writer(
+            video_paths[camera.name],
+            camera.resolution[1],
+            camera.resolution[0],
+            args.fps,
+        )
+        for camera in camera_specs
+    }
+    mosaic_path = output_dir / "three-camera-legacy-diagnostic.mp4"
+    mosaic_writer = _H264Writer(mosaic_path, 1272, 240, args.fps)
+    review_indices = {
+        int(value) for value in np.linspace(0, len(actions) - 1, 9).round()
+    }
+    review_frames: dict[int, dict[str, np.ndarray]] = {}
+    worst_frames: dict[str, tuple[int, float, np.ndarray]] = {}
+    quality_metrics: dict[str, list[dict[str, float]]] = {
+        name: [] for name in CAMERA_ORDER
+    }
+    coverage_timeline: dict[str, list[dict[str, object]]] = {
+        name: [] for name in CAMERA_ORDER
+    }
+    state_shape = None
+    state_finite = True
+    final_reward = 0.0
+    shell_status: dict[str, object] = {}
+    env = build_env(
+        "DishwasherUnloadCutleryLong",
+        camera_set=DEFAULT_CAMERA_SET,
+        visual_shell_profile=str(profile),
+        visual_shell_strict=True,
+    )
+    started = time.perf_counter()
+    try:
+        obs, _info = env.reset(seed=seed)
+        for frame_index, action in enumerate(actions):
+            state = get_state(env.robot, obs, env.action_mode._mojo)
+            state_shape = list(state.shape)
+            state_finite &= bool(np.isfinite(state).all())
+            frames = {
+                camera.name: np.asarray(
+                    obs[f"rgb_{camera.name}"],
+                    dtype=np.uint8,
+                ).transpose(1, 2, 0)
+                for camera in camera_specs
+            }
+            current_gate = env._visual_shell.status()["camera_coverage_gate"]
+            for name, image in frames.items():
+                writers[name].write(image)
+                metrics = _frame_quality(image)
+                metrics["frame"] = frame_index
+                quality_metrics[name].append(metrics)
+                clarity = metrics["laplacian_variance"]
+                if name not in worst_frames or clarity < worst_frames[name][1]:
+                    worst_frames[name] = (frame_index, clarity, image.copy())
+                last = current_gate["per_camera"][name]["last"]
+                coverage_timeline[name].append({"frame": frame_index, **last})
+            mosaic_writer.write(_mosaic(frames))
+            if frame_index in review_indices:
+                review_frames[frame_index] = {
+                    name: image.copy() for name, image in frames.items()
+                }
+            obs, final_reward, _term, _trunc, _info = env.step(action)
+        shell_status = env._visual_shell.status()
+    finally:
+        elapsed = time.perf_counter() - started
+        env.close()
+        for writer in writers.values():
+            writer.close()
+        mosaic_writer.close()
+
+    contact_sheet = np.concatenate(
+        [
+            np.concatenate(
+                [
+                    _label(
+                        cv2.resize(
+                            review_frames[frame][name],
+                            (424, 240),
+                            interpolation=cv2.INTER_AREA,
+                        ),
+                        f"f{frame} | {name}",
+                    )
+                    for name in CAMERA_ORDER
+                ],
+                axis=1,
+            )
+            for frame in sorted(review_frames)
+        ],
+        axis=0,
+    )
+    contact_sheet_path = output_dir / "three-camera-contact-sheet.png"
+    cv2.imwrite(
+        str(contact_sheet_path),
+        cv2.cvtColor(contact_sheet, cv2.COLOR_RGB2BGR),
+    )
+    worst_strip = np.concatenate(
+        [
+            _label(
+                cv2.resize(
+                    worst_frames[name][2],
+                    (424, 240),
+                    interpolation=cv2.INTER_AREA,
+                ),
+                f"{name} | worst f{worst_frames[name][0]}",
+            )
+            for name in CAMERA_ORDER
+        ],
+        axis=1,
+    )
+    worst_path = output_dir / "three-camera-worst-frame-strip.png"
+    cv2.imwrite(str(worst_path), cv2.cvtColor(worst_strip, cv2.COLOR_RGB2BGR))
+    quality_path = output_dir / "three-camera-frame-quality.json"
+    quality_path.write_text(json.dumps(quality_metrics, indent=2) + "\n")
+    quality_plot_path = output_dir / "three-camera-quality-curves.png"
+    cv2.imwrite(str(quality_plot_path), _quality_plot(quality_metrics))
+    coverage_path = output_dir / "source-view-coverage-timeline.json"
+    coverage_path.write_text(json.dumps(coverage_timeline, indent=2) + "\n")
+
+    report = {
+        "schema_version": 1,
+        "status": "diagnostic_legacy_room_awaiting_visual_approval",
+        "formal_collection_allowed": False,
+        "task": "DishwasherUnloadCutleryLong",
+        "seed": seed,
+        "coordinate_frame": "canonical-bigym",
+        "camera_set": DEFAULT_CAMERA_SET,
+        "camera_order": list(CAMERA_ORDER),
+        "external_camera_included": False,
+        "frames": len(actions),
+        "fps": args.fps,
+        "final_reward": float(final_reward),
+        "state_shape": state_shape,
+        "state_finite": state_finite,
+        "action_shape": list(actions.shape[1:]),
+        "action_finite": bool(np.isfinite(actions).all()),
+        "profile": str(profile),
+        "profile_sha256": hashlib.sha256(profile.read_bytes()).hexdigest(),
+        "code_revision": subprocess.run(
+            ["git", "rev-parse", "HEAD"],
+            check=True,
+            capture_output=True,
+            text=True,
+        ).stdout.strip(),
+        "elapsed_seconds": elapsed,
+        "seconds_per_output_camera_frame": elapsed / (len(actions) * 3),
+        "visual_shell": shell_status,
+        "videos": {
+            **{name: _file_receipt(path) for name, path in video_paths.items()},
+            "mosaic": _file_receipt(mosaic_path),
+        },
+        "contact_sheet": _file_receipt(contact_sheet_path),
+        "worst_frame_strip": _file_receipt(worst_path),
+        "quality_curves": _file_receipt(quality_plot_path),
+        "frame_quality": {
+            "artifact": _file_receipt(quality_path),
+            "summary": {
+                name: {
+                    "laplacian_variance_p10": float(
+                        np.percentile(
+                            [row["laplacian_variance"] for row in rows],
+                            10,
+                        )
+                    ),
+                    "laplacian_variance_mean": float(
+                        np.mean([row["laplacian_variance"] for row in rows])
+                    ),
+                    "bright_fraction_mean": float(
+                        np.mean([row["bright_fraction"] for row in rows])
+                    ),
+                }
+                for name, rows in quality_metrics.items()
+            },
+        },
+        "source_view_coverage": _file_receipt(coverage_path),
+        "decision": (
+            "Review the full three-camera video before any LeRobot probe; "
+            "out-of-envelope frames are intentionally native fallback."
+        ),
+    }
+    report_path = output_dir / "run-receipt.json"
+    report_path.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
