# AMD-native reconstruction pins. No credentials or private endpoints.
ROCM_ARCH=gfx1100
OPENSPLAT_REVISION=9fb62fde8b7b8c416121d3cbdcda278ffd9682f7
OPENSPLAT_SOURCE_DIR=/root/OpenSplat
OPENSPLAT_BUILD_DIR=/root/OpenSplat/build
OPENSPLAT_BIN=/root/OpenSplat/build/opensplat
ROCM_VENV=/root/opensplat-env
TRAIN_STEPS=30000
SAVE_EVERY=5000
HIP_VISIBLE_DEVICES=0

# Set these per run. Keep licensed inputs outside Git.
DATASET_DIR=/workspace/persistent/rocm3dgs-inputs/dl3dv-kitchen
RUN_ROOT=/workspace/persistent/rocm3dgs-results
RUN_ID=kitchen-gfx1100-30k
